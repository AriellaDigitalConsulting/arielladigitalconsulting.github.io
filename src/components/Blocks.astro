---
import images from '../data/images.json';

interface Block {
  type: string;
  text?: string;
  items?: string[];
  uri?: string;
  alt?: string;
}
interface Props {
  blocks: Block[];
}
const { blocks } = Astro.props;

const src = (uri: string) => (images as Record<string, { file: string }>)[uri]?.file ?? '';
---

<div class="prose">
  {
    blocks.map((b, i) => {
      if (b.type === 'image') {
        const s = src(b.uri!);
        if (!s) return null;
        return i < 2
          ? null
          : <img src={s} alt={b.alt ?? ''} loading="lazy" decoding="async" />;
      }
      if (b.type === 'list') {
        return (
          <ul>
            {b.items!.map((it) => <li set:html={it} />)}
          </ul>
        );
      }
      if (b.type === 'h1') return <h1>{b.text}</h1>;
      if (b.type === 'h2') return <h2>{b.text}</h2>;
      if (b.type === 'h3') return <h3>{b.text}</h3>;
      if (b.type === 'h4' || b.type === 'h5' || b.type === 'h6') return <h4>{b.text}</h4>;
      const t = (b.text ?? '').trim();
      if (/^Back to .*(Page|Bundles?|Services)$/i.test(t)) return null;
      if (/^Learn More$/i.test(t)) return null;
      if (/^(HAVE A LOOK AT|CHECK THIS OUT|LEARN MORE ABOUT|GO FURTHER|USE CASE VALIE|USE CASES?|OUR BUNDLE|WIDGET USE CASES|EXTENSION OVERVIEW|OUR APPROACH)$/i.test(t))
        return <p class="eyebrow">{t}</p>;
      return <p set:html={t} />;
    })
  }
</div>

<style>
  .prose :global(ul) {
    padding-left: 1.15rem;
    margin-bottom: 1.4em;
  }
</style>
