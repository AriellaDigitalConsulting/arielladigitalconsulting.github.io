---
// Contact form in the homepage style. Step 1 of the booking funnel: the answers are
// passed to Calendly as prefill parameters, and the visitor picks a slot there.

const topics = ['Implementation', 'Integrations & Widgets', 'UI/UX Design', 'SME Support', 'Analytics'];
const regions = [
  { value: 'NORAM', label: 'NORAM', hint: 'North America' },
  { value: 'EMEA', label: 'EMEA', hint: 'Europe, Middle East & Africa' },
];
---

<form class="cf" data-contact-form>
  <p class="cf__step"><b>Step 1</b> Tell us about you — <b>Step 2</b> pick a slot.</p>
  <div class="cf__row">
    <label class="cf__field">
      <span>Name *</span>
      <input name="name" type="text" required maxlength="100" autocomplete="name" />
    </label>
    <label class="cf__field">
      <span>Work email *</span>
      <input name="email" type="email" required maxlength="250" autocomplete="email" />
    </label>
  </div>
  <label class="cf__field">
    <span>Company</span>
    <input name="company" type="text" maxlength="150" autocomplete="organization" />
  </label>
  <fieldset class="cf__group">
    <legend>Where is your team based?</legend>
    <div class="cf__chips">
      {
        regions.map((r) => (
          <label class="cf__chip cf__chip--region">
            <input type="radio" name="region" value={r.value} />
            <span><b>{r.label}</b>{r.hint}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <fieldset class="cf__group">
    <legend>What can we help with?</legend>
    <div class="cf__chips">
      {
        topics.map((t) => (
          <label class="cf__chip">
            <input type="checkbox" name="topics" value={t} />
            <span>{t}</span>
          </label>
        ))
      }
    </div>
  </fieldset>
  <label class="cf__field">
    <span>Where are you with LumApps today?</span>
    <textarea name="message" rows="4" placeholder="Planning a rollout, mid-migration, or looking to get more from the platform you have…"></textarea>
  </label>
  <div class="cf__submit">
    <button type="submit">Continue to scheduling <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></button>
  </div>
</form>

<script>
  import { booking } from '../data/site';

  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const data = new FormData(form);
      const params = new URLSearchParams();
      params.set('name', String(data.get('name') ?? '').trim());
      params.set('email', String(data.get('email') ?? '').trim());
      // Calendly custom questions cannot be addressed by name, only by their a1, a2, … position.
      const custom: [string, string][] = [
        [booking.questions.company, String(data.get('company') ?? '').trim()],
        [booking.questions.region, String(data.get('region') ?? '').trim()],
        [booking.questions.topics, data.getAll('topics').map(String).join(', ')],
        [booking.questions.message, String(data.get('message') ?? '').trim()],
      ];
      for (const [id, value] of custom) {
        if (value) params.set(id, value);
      }
      params.set('hide_gdpr_banner', '1');
      params.set('primary_color', '362dff');
      window.location.assign(`${booking.url}?${params.toString()}`);
    });
  });
</script>

<style>
  .cf {
    display: flex;
    flex-direction: column;
    gap: 22px;
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #1b1a3a;
    line-height: 1.5;
  }
  .cf * {
    box-sizing: border-box;
  }
  .cf__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .cf__field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .cf__field > span,
  .cf__group legend {
    font-size: 14px;
    font-weight: 600;
    color: #05006c;
  }
  .cf__field input,
  .cf__field textarea {
    width: 100%;
    font: 15px/1.5 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #1b1a3a;
    background: #f7f7fc;
    border: 1.5px solid #ecebf7;
    border-radius: 14px;
    padding: 12px 14px;
    min-height: 48px;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .cf__field textarea {
    resize: vertical;
    min-height: 120px;
  }
  .cf__field input:focus,
  .cf__field textarea:focus {
    outline: none;
    background: #fff;
    border-color: #362dff;
  }
  .cf__group {
    border: 0;
    margin: 0;
    padding: 0;
    min-width: 0;
  }
  .cf__group legend {
    padding: 0;
    margin-bottom: 10px;
  }
  .cf__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .cf__chip {
    position: relative;
    cursor: pointer;
  }
  .cf__chip input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .cf__chip span {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 8px 16px;
    border-radius: 999px;
    border: 1.5px solid #ecebf7;
    background: #fff;
    font-size: 14px;
    font-weight: 600;
    color: #4a4870;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .cf__chip--region {
    flex: 1 1 180px;
  }
  .cf__chip--region span {
    width: 100%;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    border-radius: 16px;
    padding: 12px 16px;
    font-weight: 400;
    font-size: 13px;
  }
  .cf__chip--region b {
    font-family: 'Archivo', sans-serif;
    font-size: 17px;
    font-weight: 800;
    color: #05006c;
  }
  .cf__chip:hover span {
    border-color: #c9c7f2;
  }
  .cf__chip input:checked + span {
    border-color: #362dff;
    background: #f1f0ff;
    color: #362dff;
  }
  .cf__chip input:focus-visible + span {
    outline: 2px solid #362dff;
    outline-offset: 2px;
  }
  .cf__submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    padding-top: 4px;
  }
  .cf__submit button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    border-radius: 999px;
    padding: 15px 26px;
    min-height: 48px;
    background: #362dff;
    color: #fff;
    font: 600 16px/1.2 'open sans', 'Open Sans', system-ui, sans-serif;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }
  .cf__submit button:hover {
    background: #2a22d6;
  }
  .cf__submit button:disabled {
    opacity: 0.6;
    cursor: default;
  }
  .cf__step {
    margin: 0;
    font-size: 13px;
    font-weight: 600;
    color: #4a4870;
  }
  .cf__step b {
    color: #362dff;
  }
  @media (max-width: 600px) {
    .cf__row {
      grid-template-columns: 1fr;
    }
    .cf__submit button {
      width: 100%;
      justify-content: center;
    }
  }
</style>
