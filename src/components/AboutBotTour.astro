---
// The ADC Bot tour on /about: one small bot that hops from box to box as the visitor scrolls, and back again on the way up.
// It lives on the body in page coordinates, behind the boxes it perches on (they get z-index 2 below), so "hiding" is
// just sinking behind a box's top edge. Purely decorative: no pointer events, hidden from assistive tech, off for reduced motion.
---

<div class="bot-tour" aria-hidden="true" hidden>
  <div class="bot-tour__body">
    <svg width="52" height="45" viewBox="0 0 120 104">
      <rect width="120" height="104" rx="26" fill="#32E0C4"></rect>
      <g class="bot-tour__look" fill="#05006C">
        <g class="bot-tour__eyes">
          <rect x="34.5" y="26" width="11" height="24" rx="5.5"></rect>
          <rect x="74.5" y="26" width="11" height="24" rx="5.5"></rect>
        </g>
      </g>
      <rect x="42" y="64" width="36" height="12" rx="6" fill="#05006C"></rect>
    </svg>
  </div>
</div>

<script>
  type Stop = { el: Element; ax: number; sink: number; lookX: number; lookY: number };
  type Point = { x: number; y: number; at: number; sink: number; lookX: number; lookY: number; el: Element };

  const bot = document.querySelector<HTMLElement>('.bot-tour');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (bot && !reduced.matches) {
    document.body.append(bot);
    const body = bot.querySelector<HTMLElement>('.bot-tour__body')!;
    const look = bot.querySelector<SVGGElement>('.bot-tour__look')!;
    const W = 52;
    const H = 45;

    const q = (s: string) => [...document.querySelectorAll(s)];
    const stop = (el: Element | undefined, ax: number, sink = 0.2, lookX = 0, lookY = 0): Stop[] =>
      el ? [{ el, ax, sink, lookX, lookY }] : [];
    const HIDDEN = 1.2;
    const PEEK = 0.48;

    // The route, top to bottom. Stops on the same box (duck, slide, peek) are done without a jump.
    const route = (): Stop[] => {
      const stats = q('.adr .stat');
      const certs = q('.adr .cert');
      const chips = q('.adr .creds__list li');
      const people = q('.adr .person');
      const panel = document.querySelector('.ctab__panel') ?? undefined;
      const stops: Stop[] = [
        ...stop(stats[0], 0.82, PEEK),
        ...stats.flatMap((s) => stop(s, 0.82)),
        ...stop(certs[0], 0.5),
        // Hide and seek on the middle badge
        ...stop(certs[1], 0.28),
        ...stop(certs[1], 0.28, HIDDEN),
        ...stop(certs[1], 0.74, HIDDEN),
        ...stop(certs[1], 0.74, PEEK),
        ...stop(certs[2], 0.5),
        ...chips.flatMap((c) => stop(c, 0.5, 0.3)),
      ];
      people.forEach((p, i) => {
        const photo = p.querySelector('.person__photo') ?? undefined;
        const body = p.querySelector('.person__body');
        if (!photo || !body) return;
        // Sit on the photo corner nearest the text, and glance toward it
        const textRight = body.getBoundingClientRect().left > photo.getBoundingClientRect().left + 40;
        const stacked = Math.abs(body.getBoundingClientRect().left - photo.getBoundingClientRect().left) < 40;
        const near = stacked ? (i % 2 ? 0.2 : 0.8) : textRight ? 0.84 : 0.16;
        const far = 1 - near;
        const dir = stacked ? 0 : textRight ? 1 : -1;
        if (i === 1) {
          stops.push(...stop(photo, far), ...stop(photo, far, HIDDEN), ...stop(photo, near, HIDDEN), ...stop(photo, near, PEEK, dir, 0));
        } else {
          stops.push(...stop(photo, near, 0.2, dir * 0.6, 0));
        }
        // Then down to the "Read more" button, so the bot stays in view while the bio scrolls by
        stops.push(...stop(p.querySelector('.more') ?? undefined, 0.5, 0.22, 0, 1));
      });
      stops.push(...stop(panel, 0.8, 0.18));
      return stops;
    };

    let points: Point[] = [];
    const measure = () => {
      const vh = innerHeight;
      const gap = Math.min(90, Math.max(45, vh * 0.085));
      points = [];
      for (const s of route()) {
        const r = s.el.getBoundingClientRect();
        if (!r.width) continue;
        const half = W / 2 + 6;
        const cx = r.left + scrollX + Math.min(r.width - half, Math.max(half, r.width * s.ax));
        const y = r.top + scrollY - H * (1 - s.sink);
        const prev = points[points.length - 1];
        // Arrive when the perch is about 60% down the viewport; later stops in the same row follow one gap apart.
        const raw = r.top + scrollY - vh * 0.62;
        const at = prev ? Math.max(raw, prev.at + (prev.el === s.el ? gap * 0.8 : gap)) : 0;
        points.push({ x: cx - W / 2, y, at, sink: s.sink, lookX: s.lookX, lookY: s.lookY, el: s.el });
      }
      bot.hidden = points.length < 2;
    };

    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
    const mix = (a: number, b: number, t: number) => a + (b - a) * t;

    let smooth = scrollY;
    let last = '';
    const frame = () => {
      requestAnimationFrame(frame);
      if (points.length < 2) return;
      smooth += (scrollY - smooth) * 0.2;
      if (Math.abs(scrollY - smooth) < 0.3) smooth = scrollY;

      let i = 0;
      while (i < points.length - 2 && smooth >= points[i + 1].at) i++;
      const a = points[i];
      const b = points[i + 1];
      const dx = b.x - a.x;
      const dy = b.y - a.y;
      const same = a.el === b.el;
      // The move takes the last stretch of scroll before the next stop; until then the bot just sits.
      const span = Math.min(b.at - a.at, same ? 1e9 : clamp(Math.abs(dy) * 0.6, 110, 340));
      const t = clamp((smooth - (b.at - span)) / span, 0, 1);
      const e = t * t * (3 - 2 * t);

      let x = mix(a.x, b.x, e);
      let y = mix(a.y, b.y, e);
      let rot = 0;
      let sx = 1;
      let sy = 1;
      if (!same) {
        const air = Math.sin(Math.PI * t);
        const dist = Math.hypot(dx, dy);
        y -= air * Math.min(110, 36 + dist * 0.12);
        // Long drops get a full flip; short hops just lean into the jump
        rot = Math.abs(dy) > 260 ? 360 * e * (dx < 0 ? -1 : 1) : air * clamp(dx / 14, -16, 16);
        const land = t > 0.86 ? Math.sin((Math.PI * (t - 0.86)) / 0.14) : 0;
        sy = 1 + air * 0.08 - land * 0.18;
        sx = 1 - air * 0.05 + land * 0.16;
      }
      const lx = mix(a.lookX, b.lookX, e) * 7;
      const ly = mix(a.lookY, b.lookY, e) * 6;
      const happy = i === points.length - 2 && t >= 1;

      const next = `${x.toFixed(1)},${y.toFixed(1)},${rot.toFixed(1)},${sx.toFixed(3)},${sy.toFixed(3)},${lx.toFixed(1)},${ly.toFixed(1)},${happy}`;
      if (next === last) return;
      last = next;
      bot.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`;
      body.style.transform = `rotate(${rot.toFixed(1)}deg) scale(${sx.toFixed(3)},${sy.toFixed(3)})`;
      look.setAttribute('transform', `translate(${lx.toFixed(1)} ${ly.toFixed(1)})`);
      bot.classList.toggle('is-happy', happy);
    };

    measure();
    new ResizeObserver(measure).observe(document.body);
    addEventListener('resize', measure);
    addEventListener('load', measure);
    requestAnimationFrame(frame);
  }
</script>

<style is:global>
  .bot-tour {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 1;
    width: 52px;
    height: 45px;
    pointer-events: none;
    will-change: transform;
  }
  .bot-tour__body {
    transform-origin: 50% 100%;
    filter: drop-shadow(0 4px 6px rgba(5, 0, 108, 0.18));
  }
  .bot-tour svg {
    display: block;
  }
  .bot-tour__eyes {
    transform-box: fill-box;
    transform-origin: 50% 50%;
    animation: botTourBlink 5s infinite;
  }
  .bot-tour.is-happy svg {
    animation: botTourHappy 0.9s ease-in-out infinite;
  }
  @keyframes botTourBlink {
    0%, 91%, 97%, 100% {
      transform: scaleY(1);
    }
    94% {
      transform: scaleY(0.12);
    }
  }
  @keyframes botTourHappy {
    0%, 100% {
      transform: translateY(0) rotate(0);
    }
    30% {
      transform: translateY(-10px) rotate(-8deg);
    }
    60% {
      transform: translateY(0) rotate(0);
    }
    80% {
      transform: translateY(-5px) rotate(8deg);
    }
  }
  /* The boxes the bot perches on sit above it, so it can duck behind their top edge. */
  .adr .stat,
  .adr .cert,
  .adr .creds__list li,
  .adr .person__photo,
  .adr .more,
  .ctab__panel {
    position: relative;
    z-index: 2;
  }
  @media (prefers-reduced-motion: reduce) {
    .bot-tour {
      display: none;
    }
  }
</style>
