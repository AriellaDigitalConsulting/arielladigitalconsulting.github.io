---
// The Guess Word leaderboard as it looks in the widget: avatar, email, points and games played.
// Used by the playable demo and by the "Leaderboards" tab on /guess-word-widget.
const players = [
  { email: 'misha@arielladigitalconsulting.com', points: 78, games: 9, photo: '/images/misha-zubarev.webp' },
  { email: 'ivo@arielladigitalconsulting.com', points: 64, games: 8, photo: '/images/0d53dee377ea.webp' },
  { email: 'ariella@arielladigitalconsulting.com', points: 55, games: 8, photo: '/images/d5a2b4c45c31.webp' },
  { email: 'mike@arielladigitalconsulting.com', points: 47, games: 7, photo: '/images/guess-word/mike.webp' },
  { email: 'colin@arielladigitalconsulting.com', points: 36, games: 6, photo: '/images/guess-word/colin.webp' },
  { email: 'paulo@arielladigitalconsulting.com', points: 24, games: 5, initials: 'P', bg: '#8e88ff' },
];
---

<div class="lb">
  <p class="lb__title">Leaders</p>
  <table>
    <thead>
      <tr><th scope="col">User</th><th scope="col">Points</th><th scope="col">Games</th></tr>
    </thead>
    <tbody>
      {
        players.map((p) => (
          <tr>
            <td>
              <span class="lb__user">
                {p.photo ? <img src={p.photo} alt="" width="44" height="44" loading="lazy" /> : <span class="lb__initial" aria-hidden="true" style={`background:${p.bg}`}>{p.initials}</span>}
                <span class="lb__email">{p.email}</span>
              </span>
            </td>
            <td>{p.points}</td>
            <td>{p.games}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

<style>
  .lb {
    width: 100%;
    color: #fff;
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
  }
  .lb__title {
    margin: 0 0 12px;
    text-align: center;
    font-weight: 700;
    font-size: 18px;
    letter-spacing: 0.06em;
  }
  .lb table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .lb th {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    color: #c9c7ff;
    font-weight: 400;
    text-align: left;
  }
  .lb th:not(:first-child),
  .lb td:not(:first-child) {
    width: 18%;
    text-align: center;
  }
  .lb td {
    padding: 12px 16px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .lb tbody tr:first-child td {
    background: rgba(50, 224, 196, 0.12);
  }
  .lb__user {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .lb__user img,
  .lb__initial {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
  }
  .lb__initial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #05006c;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 17px;
  }
  .lb__email {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  @media (max-width: 560px) {
    .lb table {
      font-size: 13px;
    }
    .lb th,
    .lb td {
      padding: 10px 6px;
    }
    .lb__user {
      gap: 10px;
    }
    .lb__user img,
    .lb__initial {
      width: 34px;
      height: 34px;
      font-size: 14px;
    }
  }
</style>
