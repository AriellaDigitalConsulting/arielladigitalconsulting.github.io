---
// Sticky "Need something custom?" prompt for product pages. Base renders it only on the Products page and the
// pages its product cards link to (see isProductPage in data/extensions.ts) — never anywhere else.
//
// It appears once the visitor scrolls past the element marked [data-custom-prompt-after] (or one screen down if
// the page marks none), hides while any [data-custom-prompt-hide] element or the footer is on screen, and its ×
// dismisses it on every product page for the rest of the visit.
//
// The homepage reuses it as a "Book a discovery call" prompt (variant="call"), dismissed separately.
import { contactHref } from '../data/site';
import AdcBotIcon from './AdcBotIcon.astro';

interface Props {
  variant?: 'custom' | 'call';
}
const { variant = 'custom' } = Astro.props;
const copy = {
  custom: { title: 'Need something custom?', cta: 'Start a conversation →', key: 'custom-prompt-dismissed' },
  call: { title: 'Ready to talk LumApps?', cta: 'Book a discovery call →', key: 'call-prompt-dismissed' },
}[variant];
---

<div class="cbp" data-show="false" data-key={copy.key}>
  <a class="cbp__link" href={contactHref}>
    <span class="cbp__bot"><AdcBotIcon /></span>
    <span class="cbp__text">
      <span class="cbp__title">{copy.title}</span>
      <span class="cbp__cta">{copy.cta}</span>
    </span>
  </a>
  <button type="button" class="cbp__close" aria-label="Hide this message">×</button>
</div>

<script>
  const prompt = document.querySelector<HTMLElement>('.cbp')!;
  const KEY = prompt.dataset.key!;
  let dismissed = false;
  try {
    dismissed = sessionStorage.getItem(KEY) === '1';
  } catch {}

  let past = false;
  const hiding = new Set<Element>();
  const sync = () => (prompt.dataset.show = String(!dismissed && past && hiding.size === 0));

  const anchor = document.querySelector('[data-custom-prompt-after]');
  if (anchor) {
    new IntersectionObserver(([e]) => {
      past = !e.isIntersecting && e.boundingClientRect.top < 0;
      sync();
    }).observe(anchor);
  } else {
    const check = () => {
      past = window.scrollY > window.innerHeight * 0.8;
      sync();
    };
    addEventListener('scroll', check, { passive: true });
    check();
  }

  const hideObserver = new IntersectionObserver((entries) => {
    for (const e of entries) e.isIntersecting ? hiding.add(e.target) : hiding.delete(e.target);
    sync();
  });
  document.querySelectorAll('[data-custom-prompt-hide], #footer').forEach((el) => hideObserver.observe(el));

  prompt.querySelector('.cbp__close')!.addEventListener('click', () => {
    dismissed = true;
    try {
      sessionStorage.setItem(KEY, '1');
    } catch {}
    sync();
  });
</script>

<style>
  .cbp {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 20;
    display: flex;
    align-items: center;
    border-radius: 18px;
    background: #362dff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 18px 40px rgba(5, 0, 108, 0.35);
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    line-height: 1.5;
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  .cbp[data-show='false'] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
  }
  .cbp__link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 8px 12px 14px;
    color: #fff;
    text-decoration: none;
  }
  .cbp__link:hover {
    color: #fff;
  }
  .cbp__link:focus-visible,
  .cbp__close:focus-visible {
    outline: 3px solid #32e0c4;
    outline-offset: 2px;
  }
  .cbp__bot {
    display: flex;
  }
  .cbp__text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .cbp__title {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
  }
  .cbp__cta {
    font-weight: 700;
    font-size: 13px;
    color: #32e0c4;
  }
  .cbp__link:hover .cbp__cta {
    color: #fff;
  }
  .cbp__close {
    align-self: flex-start;
    width: 32px;
    height: 32px;
    margin: 6px 6px 0 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #c9c7f2;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
  }
  .cbp__close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .cbp {
      transition: none;
    }
  }
  @media (max-width: 600px) {
    .cbp {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }
    .cbp__link {
      flex: 1;
    }
  }
</style>
