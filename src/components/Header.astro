---
import { nav } from '../data/site';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="ADC home">
      <img src="/images/f5cc87b17f91.webp" alt="" width="62" height="60" />
    </a>
    <button class="nav-toggle" aria-expanded="false" aria-label="Toggle navigation" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>
    <nav class="nav" id="site-nav" data-open="false" aria-label="Primary">
      {nav.map((item) => <a href={item.href} aria-current={current(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
  </div>
</header>
