---
import { footerLinks, social } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-main">
    <div class="footer-brand">
      <img src="/images/4dc6ed0bf872.webp" alt="ADC" width="36" height="35" />
      <p class="footer-tag">"Making LumApps a <strong>simpler, happier</strong> experience"</p>
    </div>
    <div class="footer-col">
      <h2>Quick Links</h2>
      <ul>
        {footerLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </div>
    <div class="footer-col footer-contact">
      <h2>Contact Us</h2>
      <ul>
        {
          social.map((s) => (
            <li>
              <img src={s.icon} alt="" width="22" height="22" />
              <a href={s.href}>{s.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <p class="footer-bottom">© {year} by Ariella Digital Consulting</p>
</footer>
