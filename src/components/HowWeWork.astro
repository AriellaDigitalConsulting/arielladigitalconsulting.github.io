---
// "How we work" band: the five steps from strategy to a self-sufficient team.
const steps = [
  { color: '#362dff', num: '#362dff', title: 'Align on vision &amp; goals', body: "A strategy with your organization's vision at the forefront." },
  { color: '#32e0c4', num: '#0a6b5c', title: 'Define measurable success', body: 'KPIs, gaps and adoption opportunities, identified up front.' },
  { color: '#ffd458', num: '#8a6500', title: 'Deliver a rich and unified experience', body: 'Enablement for day-to-day operations and the long term.' },
  { color: '#362dff', num: '#362dff', title: 'Empower your core team', body: 'Enablement for day-to-day operations and the long term.' },
  { color: '#05006c', num: '#05006c', title: 'Keep evolving', body: 'New use cases and improvements as your workplace grows.' },
];
---

<section id="process" class="process">
  <div class="process__intro">
    <span class="process__eyebrow">How we work</span>
    <h2>A clear path from strategy to a self-sufficient team.</h2>
  </div>
  <ol class="steps">
    {
      steps.map((s, i) => (
        <li style={`border-top-color:${s.color}`}>
          <span class="steps__num" style={`color:${s.num}`}>{String(i + 1).padStart(2, '0')}</span>
          <h3 set:html={s.title} />
          <p>{s.body}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .process {
    max-width: 1200px;
    margin: 0 auto;
    padding: 112px 24px;
    display: flex;
    flex-direction: column;
    gap: 56px;
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #1b1a3a;
    line-height: 1.5;
  }
  .process__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }
  .process__eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.6;
    color: #362dff;
  }
  .process h2,
  .process h3 {
    font-family: 'Archivo', sans-serif;
    color: #05006c;
  }
  .process h2 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -1px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }
  .steps li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 22px;
    border-top: 3px solid;
  }
  .steps__num {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 15px;
  }
  .steps h3 {
    font-size: 20px;
    line-height: 1.25;
  }
  .steps p {
    font-size: 15px;
    line-height: 1.6;
    color: #4a4870;
  }
  @media (max-width: 600px) {
    .process {
      padding: 72px 16px;
    }
  }
</style>
