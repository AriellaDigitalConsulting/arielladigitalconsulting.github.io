---
// Coveo Headless for LumApps product page, in the "Split Editorial" look (Template B).
// "See the difference" switches a mock intranet search page between standard results and the Coveo Headless page.
import Base from '../layouts/Base.astro';
import { contactHref } from '../data/site';

const docs = 'https://docs.adc.dev/docs';

const proof = [
  { c: '#32E0C4', t: 'The full Coveo experience, in LumApps' },
  { c: '#FFD458', t: "Moves with Coveo's roadmap" },
  { c: '#8e88ff', t: 'Built on the LumApps Design System' },
  { c: '#32E0C4', t: 'Scales across environments' },
];
const why = [
  { title: 'The complete Coveo search page', text: 'Generative answers, folded results, search history and every new Coveo feature as it ships, delivered natively inside LumApps.' },
  { title: 'You decide who sees what', text: 'Own the search token. Personalize it per person and apply your own filters, so every employee sees exactly the sources and features meant for them.' },
  { title: 'See the whole user journey', text: 'Follow a search from the first query to the final click, across every application in your ecosystem, and learn what really matters to your people.' },
  { title: 'Innovate safely, in production', text: 'Run multiple search pages side by side and test new UX features, ML models and pipelines with a beta group before everyone sees them.' },
];
const sources = [
  { name: 'SharePoint', n: 128, on: true },
  { name: 'LumApps', n: 64, on: true },
  { name: 'ServiceNow', n: 31, on: false },
  { name: 'Answered questions', n: 15, on: false },
];
const citations = ['1 · Travel Policy', '2 · Expense FAQ', '3 · Finance Community'];
const highlights = [
  { c: '#32E0C4', t: 'Generative answers with sources' },
  { c: '#FFD458', t: 'Folded results' },
  { c: '#8e88ff', t: 'Search history' },
  { c: '#32E0C4', t: 'Facets across every source' },
];

// User journeys: which session ID each click gets under each tracking approach (same color = same journey).
const id = { 1: '#362dff', 2: '#e0263c', 3: '#32E0C4' } as const;
const journeys = [
  { label: 'Earlier out-of-the-box tracking', ids: [1, 1, 2, 2, 3] as const },
  { label: 'Current out-of-the-box tracking', ids: [1, 1, 1, 1, 2] as const },
  { label: 'ADC client-generated ID', ids: [1, 1, 1, 1, 1] as const, ours: true },
];
const domains = [
  { name: 'intranet.yourcompany.com', span: 2, bg: '#05006c', fg: '#fff' },
  { name: 'support.yourcompany.com', span: 2, bg: '#362dff', fg: '#fff' },
  { name: 'docs.yourcompany.com', span: 1, bg: '#8e88ff', fg: '#05006c' },
];
const journeyCards = [
  { title: 'Track behavior across products', text: 'See how employees search across LumApps and every connected application.' },
  { title: 'Understand what matters', text: 'Turn complete journeys into insight about what your people really need.' },
  { title: 'Security traceability', text: 'Give authorized users the ability to trace interactions in any application.', yellow: true },
];
const beta = ['Control your beta user lists', 'Support Coveo A/B testing', 'Trial UX features, ML models and source or pipeline changes', 'Give each experience its own context path'];
const inBox = [
  { c: '#32E0C4', title: 'Coveo Headless components', text: 'The full Coveo search page in LumApps, with out-of-the-box context and UA events, open to Headless customization.' },
  { c: '#FFD458', title: 'Search token filtering', text: 'Personalized, signed tokens and custom filters you control.' },
  { c: '#8e88ff', title: 'Client ID generation', text: 'User journeys that stay aligned across domains.' },
  { c: '#32E0C4', title: 'Beta experiences', text: 'A/B test new Coveo UX features, ML models and source or pipeline configurations.' },
];
const related = [
  { href: '/coveo-integrations', icon: 'answer', color: '#32E0C4', title: 'Community Post Comments Indexer.', text: 'Index LumApps community comments in Coveo, and bring answered questions into global search as their own facet.' },
  { href: '/implementations', icon: 'grid', color: '#FFD458', title: 'LumApps Implementation Services.', text: 'Strategy, design, migration and change management from a LumApps-only partner.' },
];

const icons: Record<string, string> = {
  search: '<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
  doc: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/>',
  answer: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/><path d="M9 12l2 2 4-4"/>',
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  thumb: '<path d="M7 10v11H4V10zM7 10l4-8a3 3 0 0 1 3 3v4h6a2 2 0 0 1 2 2l-2 8a2 2 0 0 1-2 2H7"/>',
  tick: '<path d="M5 12l5 5 9-10"/>',
  grid: '<path d="M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z"/>',
};
const icon = (key: string, size = 20, width = 2) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="${width}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[key]}</svg>`;
const sparkle = '<svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l1.8 5.4L19 9l-5.2 1.6L12 16l-1.8-5.4L5 9l5.2-1.6zM19 15l.9 2.6 2.6.9-2.6.9L19 22l-.9-2.6-2.6-.9 2.6-.9z"/></svg>';
---

<Base title="Coveo Headless for LumApps | Ariella Digital Consulting" description="ADC brings the complete Coveo search page into LumApps with the Coveo Headless framework: generative answers, folded results, search history and token filtering you control.">
  <div class="cv">
    <section class="cv__hero" data-custom-prompt-after>
      <div class="cv__wrap cv__hero-grid">
        <div class="cv__hero-copy">
          <a class="cv__back" href="/products">← Back to Products Page</a>
          <p class="cv__tagline">Enterprise search, without limits.</p>
          <h1>Coveo Headless<br />for LumApps <span>by ADC</span></h1>
          <p class="cv__lede">Give your enterprise full control over the LumApps search experience. ADC replaces the API-based Coveo interface with the Coveo Headless framework, so every employee gets the complete, modern Coveo search page, with generative answers, folded results and search history, right inside LumApps.</p>
          <div class="cv__hero-ctas">
            <a class="cv__btn cv__btn--blue" href={contactHref}>Request a Demo</a>
            <a class="cv__docs" href="#see-it">
              <span set:html={icon('search', 18, 2.2)} />
              See the search page
            </a>
          </div>
        </div>

        <div class="cv__comp">
          <span class="cv__chip">Coveo Partner · LumApps Tech Partner</span>
          <div class="cv__card" aria-hidden="true">
            <div class="cv__query">
              <span class="cv__query-icon" set:html={icon('search', 18, 2.2)} />
              <span>travel expense policy</span>
              <kbd>⌘K</kbd>
            </div>
            <div class="cv__answer">
              <span class="cv__pill"><Fragment set:html={sparkle} />Generated answer</span>
              <p>Book travel through the company travel portal. Meals are reimbursed up to the daily per diem, and receipts should be submitted within the reporting window set by Finance.</p>
              <div class="cv__cites">{citations.map((c) => <span>{c}</span>)}</div>
            </div>
            <div class="cv__hit">
              <span class="cv__hit-icon" set:html={icon('doc')} />
              <div>
                <span>Global Travel &amp; Expense Policy</span>
                <span>HR Site › Policies</span>
                <span>+ 3 related results folded together</span>
              </div>
            </div>
          </div>
          <div class="cv__facets" aria-hidden="true">
            <span>FACETS</span>
            <span><span>SharePoint</span><span>128</span></span>
            <span><span>LumApps</span><span>64</span></span>
            <span><span><i></i>Answered questions</span><span>15</span></span>
          </div>
        </div>
      </div>
    </section>

    <section class="cv__proof">
      <div class="cv__wrap">
        {proof.map((p) => <span><span class="cv__dot" style={`background:${p.c}`}></span>{p.t}</span>)}
      </div>
    </section>

    <section class="cv__why cv__wrap">
      <div class="cv__why-head">
        <p class="cv__eyebrow">HAVE A LOOK AT</p>
        <h2>Why<br />go headless</h2>
        <div class="cv__bar" aria-hidden="true"></div>
        <p>Search is where employees go when they need something now. Make it a seamless part of the employee journey.</p>
      </div>
      <ol class="cv__why-list">
        {
          why.map((w, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="cv__diff" id="see-it">
      <div class="cv__wrap">
        <div class="cv__diff-head">
          <div class="cv__heading">
            <p class="cv__eyebrow cv__eyebrow--yellow">SEE THE DIFFERENCE</p>
            <h2>From a results list<br />to an answer engine</h2>
          </div>
          <div class="cv__diff-side">
            <p>Same LumApps. A search page that finally answers the question.</p>
            <div class="cv__toggle" role="group" aria-label="Choose search experience">
              <button type="button" data-mode="before" aria-pressed="false">Standard search</button>
              <button type="button" data-mode="after" aria-pressed="true">Coveo Headless by ADC</button>
            </div>
          </div>
        </div>

        <div class="cv__browser" data-mode="after">
          <div class="cv__browser-bar">
            <span class="cv__dot" style="background:#FFD458"></span>
            <span class="cv__dot" style="background:#32E0C4"></span>
            <span class="cv__dot" style="background:#8e88ff"></span>
            <span class="cv__url"><span class="cv__url-before">yourcompany.lumapps.com / search?q=knowledge+base</span><span class="cv__url-after">yourcompany.lumapps.com / search?q=travel+expense+policy</span></span>
          </div>
          <div class="cv__screen">
            <div class="cv__topbar">
              <span class="cv__brand"><span aria-hidden="true"></span>Your Intranet</span>
              <div class="cv__searchbar"><Fragment set:html={icon('search', 16, 2.2)} /><span>travel expense policy</span></div>
              <span class="cv__me" aria-hidden="true"></span>
            </div>

            <img class="cv__plain" src="/images/coveo/standard-search.webp" alt="Standard LumApps search for knowledge base: a short AI answer that has to be expanded, author and result type filters, and a plain list of results" width="1006" height="700" loading="lazy" />

            <div class="cv__rich">
              <aside class="cv__facet-col" aria-label="Filters">
                <div>
                  <span class="cv__label">SOURCE</span>
                  {sources.map((s) => <span class="cv__check"><span class:list={['cv__box', { 'is-on': s.on }]} aria-hidden="true" set:html={s.on ? icon('tick', 10, 4) : ''} /><span>{s.name}</span><span>{s.n}</span></span>)}
                </div>
                <div>
                  <span class="cv__label">CONTENT TYPE</span>
                  <div class="cv__types">{['Policy', 'Article', 'Question', 'Video'].map((t, i) => <span class:list={{ 'is-on': i === 0 }}>{t}</span>)}</div>
                </div>
                <div>
                  <span class="cv__label">RECENT SEARCHES</span>
                  {['per diem rates', 'corporate card'].map((q) => <span class="cv__recent"><Fragment set:html={icon('clock', 14)} />{q}</span>)}
                </div>
              </aside>

              <div class="cv__results">
                <div class="cv__answer cv__answer--lg">
                  <div class="cv__answer-head">
                    <span class="cv__pill"><Fragment set:html={sparkle} />Generated answer</span>
                    <span class="cv__thumbs" aria-hidden="true"><Fragment set:html={icon('thumb', 16)} /><span set:html={icon('thumb', 16)} /></span>
                  </div>
                  <p>Book all business travel through the company travel portal<sup>1</sup>. Meals are reimbursed up to the daily per diem, and receipts can be submitted straight from the mobile app within the reporting window set by Finance<sup>2</sup>.</p>
                  <div class="cv__cites"><span class="cv__cites-label">Sources</span>{citations.map((c) => <span>{c}</span>)}</div>
                </div>
                <div class="cv__tabs-row">
                  <span class="cv__tabs"><span class="is-on">All</span><span>Documents</span><span>Communities</span><span>People</span></span>
                  <span>Sort by <strong>Relevance</strong></span>
                </div>
                <article class="cv__result">
                  <span class="cv__hit-icon" set:html={icon('doc')} />
                  <div>
                    <span class="cv__result-title">Global Travel &amp; Expense Policy</span>
                    <span class="cv__result-path">HR Site › Policies · Updated last week</span>
                    <p>Everything you need before you go: booking, <mark>travel</mark> classes, per diem rates and how to file an <mark>expense</mark> report under the <mark>policy</mark>.</p>
                    <div class="cv__folded">
                      <span>Per diem rates by region</span>
                      <span>Expense report checklist</span>
                      <span>Show 1 more related result</span>
                    </div>
                  </div>
                </article>
                <article class="cv__result">
                  <span class="cv__hit-icon cv__hit-icon--teal" set:html={icon('answer')} />
                  <div>
                    <span class="cv__result-title-row"><span class="cv__result-title">How do I submit receipts from my phone?</span><span class="cv__answered">Answered</span></span>
                    <span class="cv__result-path">Finance Community · 12 replies</span>
                    <p>Open the mobile app, tap Expenses, then snap a photo of each receipt. It attaches to your open report automatically.</p>
                  </div>
                </article>
              </div>

              <aside class="cv__people" aria-label="People">
                <span class="cv__label">PEOPLE</span>
                <div><span aria-hidden="true" style="background:#32E0C4">DL</span><span><strong>Dana Levi</strong><span>Travel Program Lead</span></span></div>
                <div><span aria-hidden="true" style="background:#FFD458">SO</span><span><strong>Sam Ortiz</strong><span>Finance Operations</span></span></div>
                <div class="cv__quick"><span>QUICK LINK</span><span>Open the travel portal →</span></div>
              </aside>
            </div>
          </div>
        </div>

        <div class="cv__highlights">
          {highlights.map((h) => <span><span class="cv__dot cv__dot--sm" style={`background:${h.c}`}></span>{h.t}</span>)}
        </div>
      </div>
    </section>

    <section class="cv__token cv__wrap">
      <div class="cv__copy">
        <p class="cv__eyebrow">CONTROL SEARCH TOKEN FILTERING</p>
        <h2 class="cv__h2-md">The right results, for the right people</h2>
        <p>With the ADC Headless framework, you own search token generation, built on Coveo's search token logic for embedded filtering. Personalize the token for each person in LumApps and apply your own custom filters.</p>
        <ul class="cv__ticks">
          <li><span class="cv__tick" set:html={icon('tick', 14, 3)} /><span><strong>Digitally signed filters</strong> control which data sources specific groups or users can see</span></li>
          <li><span class="cv__tick" set:html={icon('tick', 14, 3)} /><span><strong>Feature-level access</strong> lets certain users see certain features, but not others</span></li>
        </ul>
      </div>
      <div class="cv__token-side">
        <div class="cv__code" aria-label="Example signed search token">
          <span class="cv__code-title">SEARCH TOKEN · SIGNED</span>
          <code><span>user</span>: <b>"dana.levi"</b></code>
          <code><span>groups</span>: [<b>"Finance"</b>, <b>"Travel Admins"</b>]</code>
          <code><span>filter</span>: <b>"@source==(LumApps, SharePoint-Finance)"</b></code>
          <code><span>features</span>: [<b>"genai"</b>, <b>"beta-facets"</b>]</code>
        </div>
        <div class="cv__audiences">
          <div><strong>Finance team</strong><span>Sees Finance SharePoint, policies and generated answers</span></div>
          <div class="is-yellow"><strong>Contractors</strong><span>See public policies only, nothing more</span></div>
        </div>
      </div>
    </section>

    <section class="cv__journeys">
      <div class="cv__wrap">
        <div class="cv__journeys-head">
          <div class="cv__heading">
            <p class="cv__eyebrow">OBTAIN USER JOURNEYS</p>
            <h2 class="cv__h2-md">One person. One journey.<br />Every application.</h2>
          </div>
          <p>Control the logic that generates the Coveo client ID, and follow each search from the first query to the end of the session, across your whole ecosystem.</p>
        </div>
        <div class="cv__table-wrap" tabindex="0" aria-label="How each tracking approach groups one person's clicks across three domains">
          <div class="cv__table">
            <span></span>
            {domains.map((d) => <span class="cv__domain" style={`grid-column:span ${d.span};background:${d.bg};color:${d.fg}`}>{d.name}</span>)}
            {
              journeys.map((j) => (
                <Fragment>
                  <span class:list={['cv__row-label', { 'is-ours': j.ours }]}>{j.label}</span>
                  {j.ids.map((n) => (
                    <span class:list={['cv__cell', { 'is-ours': j.ours }]}>
                      <span aria-hidden="true" style={`background:${id[n]}`}></span>
                      <span>ID {n}</span>
                    </span>
                  ))}
                </Fragment>
              ))
            }
          </div>
        </div>
        <div class="cv__journey-cards">
          {journeyCards.map((c) => <div class:list={{ 'is-yellow': c.yellow }}><h3>{c.title}</h3><p>{c.text}</p></div>)}
        </div>
      </div>
    </section>

    <section class="cv__beta cv__wrap">
      <div class="cv__pages" aria-hidden="true">
        <div class="cv__page">
          <div><span>/search</span><span>PRODUCTION · All employees</span></div>
          <span class="cv__line" style="width:80%"></span>
          <span class="cv__line" style="width:60%"></span>
        </div>
        <div class="cv__page cv__page--beta">
          <div><span>/search-beta</span><span>BETA · Pilot group</span></div>
          <div class="cv__page-tags">{['New UX features', 'ML model B', 'Query pipeline v2', 'Own context path'].map((t) => <span>{t}</span>)}</div>
        </div>
      </div>
      <div class="cv__copy">
        <p class="cv__eyebrow">BETA TESTING EXPERIENCE</p>
        <h2 class="cv__h2-md">Test tomorrow's search today</h2>
        <p>Run multiple search pages side by side. Roll out your beta experience directly on the live production environment and prove every change before it reaches everyone.</p>
        <ul class="cv__ticks">
          {beta.map((b) => <li><span class="cv__tick" set:html={icon('tick', 14, 3)} /><span>{b}</span></li>)}
        </ul>
      </div>
    </section>

    <section class="cv__box-sec">
      <div class="cv__wrap">
        <div class="cv__heading">
          <p class="cv__eyebrow cv__eyebrow--yellow">WHAT YOU GET</p>
          <h2 class="cv__h2-md">Everything in the box</h2>
        </div>
        <div class="cv__inbox">
          {
            inBox.map((b, i) => (
              <div>
                <span style={`color:${b.c}`}>{String(i + 1).padStart(2, '0')}</span>
                <h3>{b.title}</h3>
                <p>{b.text}</p>
              </div>
            ))
          }
        </div>
        <div class="cv__band" data-custom-prompt-hide>
          <div>
            <p class="cv__band-title">Built on the LumApps Design System. Ready on day one.</p>
            <p>A sample search page default state, styled with LumApps components, is included.</p>
          </div>
          <a class="cv__btn cv__btn--navy" href={contactHref}>Request a Demo</a>
        </div>
      </div>
    </section>

    <section class="cv__further cv__wrap">
      <div class="cv__heading">
        <p class="cv__eyebrow">GO FURTHER</p>
        <h2 class="cv__h2-sm">More Coveo Search Integrations by ADC</h2>
      </div>
      <div class="cv__further-grid">
        {
          related.map((r) => (
            <a href={r.href}>
              <span class="cv__further-icon" style={`color:${r.color}`} set:html={icon(r.icon, 30)} />
              <span class="cv__further-text">
                <span class="cv__further-title">{r.title}</span>
                <span>{r.text}</span>
                <span class="cv__more">Learn More →</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="cv__cta" data-custom-prompt-hide>
      <div class="cv__cta-blue">
        <h2>Got questions?</h2>
        <p>Get in touch to learn more about this integration and to see a demo</p>
        <div><a class="cv__btn cv__btn--yellow cv__btn--lg" href={contactHref}>Contact us</a></div>
      </div>
      <div class="cv__cta-yellow">
        <p>Check out our Docs site for a listing of all our widgets and integrations:</p>
        <a href={docs}>docs.adc.dev/docs</a>
      </div>
    </section>
  </div>
</Base>

<script>
  // "See the difference": switch the mock search page between standard results and the Coveo Headless page.
  const browser = document.querySelector<HTMLElement>('.cv__browser');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.cv__toggle button');
  buttons.forEach((btn) =>
    btn.addEventListener('click', () => {
      if (browser) browser.dataset.mode = btn.dataset.mode;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    }),
  );
</script>

<style>
  .cv {
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #000;
    line-height: 1.5;
  }
  .cv * {
    box-sizing: border-box;
  }
  .cv h1,
  .cv h2,
  .cv h3 {
    font-family: 'Archivo', sans-serif;
    margin: 0;
  }
  .cv p,
  .cv ol,
  .cv ul {
    margin: 0;
  }
  .cv a:focus-visible,
  .cv button:focus-visible,
  .cv [tabindex]:focus-visible {
    outline: 3px solid #32e0c4;
    outline-offset: 2px;
  }
  .cv mark {
    padding: 0 2px;
    border-radius: 3px;
    background: #fff3c4;
    color: inherit;
  }
  .cv__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .cv__eyebrow {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: 13px;
    color: #362dff;
  }
  .cv__eyebrow--yellow {
    color: #ffd458;
  }
  .cv__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cv__heading h2,
  .cv__why-head h2 {
    font-weight: 900;
    font-size: clamp(44px, 5.5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #05006c;
  }
  .cv .cv__h2-md {
    font-weight: 900;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #05006c;
  }
  .cv__heading .cv__h2-sm {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .cv__btn {
    display: inline-block;
    padding: 18px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 17px;
    transition: transform 0.15s ease;
  }
  .cv__btn:hover {
    transform: translateY(-2px);
  }
  .cv__btn--blue {
    background: #362dff;
    color: #fff;
  }
  .cv__btn--blue:hover {
    background: #05006c;
    color: #fff;
