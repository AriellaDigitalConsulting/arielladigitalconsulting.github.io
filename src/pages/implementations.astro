---
// Implementations page, converted from the "Implementations — modern direction" design.
import Base from '../layouts/Base.astro';

const year = new Date().getFullYear();
---

<Base title="LumApps Implementation Services | Ariella Digital Consulting" description="Full-service LumApps implementation: strategy, design, content migration and launch, led by the first LumApps deployment consultant onboarded in the US." bare>
  <div class="impl">
    <!-- HERO -->
  <section id="top" style="background: #05006C; color: #FFFFFF; position: relative; overflow: hidden">
    <div aria-hidden="true" style="position: absolute; right: -140px; bottom: -220px; width: 620px; height: 620px; border-radius: 50%; border: 90px solid rgba(54,45,255,0.32)"></div>
    <div style="max-width: 1200px; margin: 0 auto; padding: 96px 24px 108px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; position: relative">
      <div style="flex: 1.2 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 26px">
        <div style="display: inline-flex; align-self: flex-start; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); font-size: 14px; font-weight: 600; color: #E6E5FF">
          <span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: #32E0C4"></span>
          LumApps Implementation &amp; Deployment Services
        </div>
        <h1 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(40px, 5.2vw, 66px); line-height: 1.04; letter-spacing: -1.5px">From one shared vision to a LumApps platform <span style="color: #32E0C4">people actually use</span>.</h1>
        <p style="margin: 0; font-size: 19px; line-height: 1.6; color: #D4D2F5; max-width: 580px">Full-service LumApps implementation, led by the first LumApps deployment consultant onboarded in the US. We align your stakeholders, design the experience, migrate your content and launch — then make sure it sticks.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 4px">
          <a class="btn-primary" href="#contact" style="background: #362DFF; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; box-sizing: border-box">Plan your implementation
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn-ghost" href="#approach" style="color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.35); display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box">See our approach</a>
        </div>
      </div>

      <!-- Hero visual: the four "windows" -->
      <div role="img" aria-label="Four stages of an ADC implementation: Strategy, Design, Migration, Implementation" style="flex: 1 1 380px; min-width: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px">
        <div style="background: #FFFFFF; color: #05006C; border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 10px; min-height: 150px; box-sizing: border-box; box-shadow: 0 30px 60px rgba(0,0,0,0.25)">
          <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 14px; color: #362DFF">01</span>
          <span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 20px">Strategy</span>
          <span style="font-size: 13px; color: #4A4870; line-height: 1.5">One vision every stakeholder signs.</span>
        </div>
        <div style="background: #32E0C4; color: #05006C; border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 10px; min-height: 150px; box-sizing: border-box; box-shadow: 0 30px 60px rgba(0,0,0,0.25)">
          <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 14px">02</span>
          <span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 20px">Design</span>
          <span style="font-size: 13px; line-height: 1.5">An experience shaped by your brand.</span>
        </div>
        <div style="background: #FFD458; color: #05006C; border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 10px; min-height: 150px; box-sizing: border-box; box-shadow: 0 30px 60px rgba(0,0,0,0.25)">
          <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 14px">03</span>
          <span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 20px">Migration</span>
          <span style="font-size: 13px; line-height: 1.5">Years of content, moved cleanly.</span>
        </div>
        <div style="background: #362DFF; color: #FFFFFF; border-radius: 22px; padding: 22px; display: flex; flex-direction: column; gap: 10px; min-height: 150px; box-sizing: border-box; box-shadow: 0 30px 60px rgba(0,0,0,0.25); border: 1px solid rgba(255,255,255,0.25)">
          <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 14px; color: #FFD458">04</span>
          <span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 20px">Implementation</span>
          <span style="font-size: 13px; line-height: 1.5; color: #E6E5FF">Built, launched and adopted.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- PROOF STRIP -->


  <!-- VISION QUOTE -->
  <section aria-label="Our philosophy" style="max-width: 1200px; margin: 0 auto; padding: 112px 24px 40px">
    <figure style="margin: 0; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start">
      <svg width="64" height="52" viewBox="0 0 34 28" fill="#FFD458" aria-hidden="true" style="flex: none"><path d="M0 28V16C0 6 5 1 14 0v6c-4 1-6 4-6 8h6v14zM20 28V16c0-10 5-15 14-16v6c-4 1-6 4-6 8h6v14z"></path></svg>
      <div style="flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
        <blockquote style="margin: 0; font-family: Archivo, sans-serif; font-weight: 700; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.18; letter-spacing: -0.8px; color: #05006C">A platform launch is a date on a calendar. An implementation is a promise — that on day 100, your people are <span style="color: #362DFF">still choosing</span> to use it.</blockquote>
        <figcaption style="display: flex; align-items: center; gap: 14px">
          <span style="width: 48px; height: 48px; border-radius: 50%; background: #05006C; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-family: Archivo, sans-serif; font-weight: 700">MZ</span>
          <span style="display: flex; flex-direction: column; gap: 2px"><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 16px; color: #05006C">Misha Zubarev</span><span style="font-size: 14px; color: #4A4870">Founder &amp; Managing Director, ADC</span></span>
        </figcaption>
      </div>
    </figure>
  </section>

  <!-- STRATEGIC WINDOWS APPROACH -->
  <section id="approach" style="max-width: 1200px; margin: 0 auto; padding: 80px 24px 112px; display: flex; flex-direction: column; gap: 48px">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
      <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px">
        <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">The ADC Strategic Windows Approach</span>
        <h2 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.08; letter-spacing: -1px; color: #05006C">Everything rests on strategy. We carry it all the way to launch.</h2>
      </div>
      <p style="margin: 0; font-size: 16px; line-height: 1.65; color: #4A4870; max-width: 380px">Each window opens only when the one before it is solid, so nothing gets built on assumptions.</p>
    </div>

    <!-- Foundation -->
    <div style="background: #05006C; color: #FFFFFF; border-radius: 28px; padding: clamp(28px, 4vw, 44px); display: flex; flex-direction: column; gap: 28px">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-start; gap: 20px">
        <div style="display: flex; flex-direction: column; gap: 10px; max-width: 600px">
          <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #FFD458">The foundation · Strategy &amp; SME consulting</span>
          <h3 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: 30px; line-height: 1.15">Solutions Strategy</h3>
          <p style="margin: 0; font-size: 16px; line-height: 1.6; color: #D4D2F5">Stakeholder alignment on one shared vision — before a single page is built.</p>
        </div>
        <span style="font-size: 14px; color: #C9C7F2; align-self: flex-end">Five strategy pillars</span>
      </div>
      <ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px">
        <li style="border: 1.5px solid rgba(255,255,255,0.22); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 8px"><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Use Case</span><span style="font-size: 14px; line-height: 1.5; color: #C9C7F2">Who it serves, and what they need to get done.</span></li>
        <li style="border: 1.5px solid rgba(255,255,255,0.22); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 8px"><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Architecture</span><span style="font-size: 14px; line-height: 1.5; color: #C9C7F2">Sites, navigation and audiences that scale.</span></li>
        <li style="border: 1.5px solid rgba(255,255,255,0.22); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 8px"><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Governance</span><span style="font-size: 14px; line-height: 1.5; color: #C9C7F2">Who owns what, and how it stays healthy.</span></li>
        <li style="border: 1.5px solid rgba(255,255,255,0.22); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 8px"><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Analytics</span><span style="font-size: 14px; line-height: 1.5; color: #C9C7F2">KPIs defined up front, so success is provable.</span></li>
        <li style="border: 1.5px solid rgba(255,255,255,0.22); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 8px"><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Content UX</span><span style="font-size: 14px; line-height: 1.5; color: #C9C7F2">Content people can find, read and trust.</span></li>
      </ul>
    </div>

    <!-- Three windows -->
    <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px">
      <li style="border: 1.5px solid #ECEBF7; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px">
        <div style="display: flex; justify-content: space-between; align-items: center">
          <span style="width: 52px; height: 52px; border-radius: 14px; background: #32E0C4; display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M9 9v11"></path></svg></span>
          <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #0A6B5C">Window 02</span>
        </div>
        <h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 24px; color: #05006C">UI/UX Design</h3>
        <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Templates, mockups and a final experience that looks and feels like your brand — designed by a LumApps-certified design partner.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; font-size: 13px; color: #3A3870"><span style="background: #F1F0FF; padding: 6px 12px; border-radius: 999px">Templates</span><span style="background: #F1F0FF; padding: 6px 12px; border-radius: 999px">Mockups</span><span style="background: #F1F0FF; padding: 6px 12px; border-radius: 999px">Custom CSS</span></div>
      </li>
      <li style="border: 1.5px solid #ECEBF7; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px">
        <div style="display: flex; justify-content: space-between; align-items: center">
          <span style="width: 52px; height: 52px; border-radius: 14px; background: #FFD458; display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h11M11 3l4 4-4 4M20 17H9M13 13l-4 4 4 4"></path></svg></span>
          <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #8A6500">Window 03</span>
        </div>
        <h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 24px; color: #05006C">Migration</h3>
        <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Content audit, cleanup and mapping from legacy platforms, migrated and validated in your new LumApps architecture.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; font-size: 13px; color: #3A3870"><span style="background: #F1F0FF; padding: 6px 12px; border-radius: 999px">SharePoint</span><span style="background: #F1F0FF; padding: 6px 12px; border-radius: 999px">Jive</span><span style="background: #F1F0FF; padding: 6px 12px; border-radius: 999px">Workplace</span><span style="background: #F1F0FF; padding: 6px 12px; border-radius: 999px">Audit · Map · Validate</span></div>
      </li>
      <li style="border: 1.5px solid #362DFF; background: #F7F7FC; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 16px">
        <div style="display: flex; justify-content: space-between; align-items: center">
          <span style="width: 52px; height: 52px; border-radius: 14px; background: #362DFF; display: flex; align-items: center; justify-content: center"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 13l4 4L19 7"></path></svg></span>
          <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #362DFF">Window 04</span>
        </div>
        <h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 24px; color: #05006C">Implementation</h3>
        <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Bringing it all together: platform build, integrations, testing and launch, with adoption support beyond go-live.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; font-size: 13px; color: #3A3870"><span style="background: #FFFFFF; padding: 6px 12px; border-radius: 999px">Build</span><span style="background: #FFFFFF; padding: 6px 12px; border-radius: 999px">Integrate</span><span style="background: #FFFFFF; padding: 6px 12px; border-radius: 999px">Launch</span><span style="background: #FFFFFF; padding: 6px 12px; border-radius: 999px">Adopt</span></div>
      </li>
    </ol>
  </section>

  <!-- SOUND FAMILIAR -->
  <section aria-labelledby="familiar-h" style="background: #F7F7FC">
    <div style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
      <div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
        <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">Sound familiar?</span>
        <h2 id="familiar-h" style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; letter-spacing: -1px; color: #05006C">The questions we hear before every rollout.</h2>
        <p style="margin: 0; font-size: 17px; line-height: 1.65; color: #4A4870">If one of these is on your mind, you're in the right place. Each one maps to a window in our approach.</p>
      </div>
      <div style="flex: 1.4 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
        <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“Who's going to help us roll this out?”</span><span style="font-size: 13px; font-weight: 600; color: #2A22B8; background: #E9E8FF; padding: 5px 12px; border-radius: 999px">Strategy</span></div>
        <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“We need it to look and feel like our brand.”</span><span style="font-size: 13px; font-weight: 600; color: #0A6B5C; background: #DDF9F4; padding: 5px 12px; border-radius: 999px">Design</span></div>
        <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“We're moving off SharePoint. What happens to our content?”</span><span style="font-size: 13px; font-weight: 600; color: #6B4E00; background: #FFF3CC; padding: 5px 12px; border-radius: 999px">Migration</span></div>
        <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“Can employees see their Workday tasks without leaving the intranet?”</span><span style="font-size: 13px; font-weight: 600; color: #FFFFFF; background: #362DFF; padding: 5px 12px; border-radius: 999px">Implementation</span></div>
        <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“How do we keep it from becoming another ghost town?”</span><span style="font-size: 13px; font-weight: 600; color: #FFFFFF; background: #362DFF; padding: 5px 12px; border-radius: 999px">Adoption</span></div>
      </div>
    </div>
  </section>

  <!-- RESULTS / CASE STUDIES -->
  <section id="results" style="max-width: 1200px; margin: 0 auto; padding: 112px 24px; display: flex; flex-direction: column; gap: 48px">
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
      <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px">
        <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">Where we help</span>
        <h2 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.08; letter-spacing: -1px; color: #05006C">The rollouts we're built for.</h2>
      </div>
      <p style="margin: 0; font-size: 16px; line-height: 1.65; color: #4A4870; max-width: 400px">Every organization is different, but most LumApps implementations start from one of these four situations.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px">
      <article style="border: 1.5px solid #ECEBF7; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 18px">
        <span style="font-size: 13px; font-weight: 600; color: #2A22B8; background: #E9E8FF; padding: 5px 12px; border-radius: 999px; align-self: flex-start">New platform launch</span>
        <h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 22px; line-height: 1.25; color: #05006C">You've just signed with LumApps and need to go live.</h3>
        <dl style="margin: 0; display: flex; flex-direction: column; gap: 12px">
          <div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">We deliver</dt><dd style="margin: 0; font-size: 15px; line-height: 1.55; color: #4A4870">Solutions strategy, architecture, governance, design and a guided launch.</dd></div>
          <div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">You walk away with</dt><dd style="margin: 0; font-size: 15px; line-height: 1.55; color: #4A4870">A live platform and a core team ready to run it.</dd></div>
        </dl>
      </article>
      <article style="border: 1.5px solid #ECEBF7; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 18px">
        <span style="font-size: 13px; font-weight: 600; color: #6B4E00; background: #FFF3CC; padding: 5px 12px; border-radius: 999px; align-self: flex-start">Legacy migration</span>
        <h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 22px; line-height: 1.25; color: #05006C">You're leaving SharePoint, Jive or Workplace behind.</h3>
        <dl style="margin: 0; display: flex; flex-direction: column; gap: 12px">
          <div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">We deliver</dt><dd style="margin: 0; font-size: 15px; line-height: 1.55; color: #4A4870">Content audit, cleanup, mapping, migration and validation.</dd></div>
          <div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">You walk away with</dt><dd style="margin: 0; font-size: 15px; line-height: 1.55; color: #4A4870">Only the content worth keeping, organized for how people search today.</dd></div>
        </dl>
      </article>
      <article style="border: 1.5px solid #ECEBF7; border-radius: 24px; padding: 32px; display: flex; flex-direction: column; gap: 18px">
        <span style="font-size: 13px; font-weight: 600; color: #0A6B5C; background: #DDF9F4; padding: 5px 12px; border-radius: 999px; align-self: flex-start">Brand relaunch</span>
        <h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 22px; line-height: 1.25; color: #05006C">Your company has a new brand, and the intranet has to follow.</h3>
        <dl style="margin: 0; display: flex; flex-direction: column; gap: 12px">
          <div style="display: flex; flex-direction: column; gap: 4px"><dt style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">We deliver</dt><dd style="margin: 0; font-size: 15px; line-height: 1.55; color: #4A4870">Homepage redesign and a coordinated brand swap across every site.</dd></div>
