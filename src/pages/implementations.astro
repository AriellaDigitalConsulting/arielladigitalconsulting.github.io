---
// Implementations page, converted from the adc-implementations design. The main navigation is the shared SiteHeader.
import Base from '../layouts/Base.astro';
import HowWeWork from '../components/HowWeWork.astro';

const year = new Date().getFullYear();
---

<Base title="LumApps Implementation Services | Ariella Digital Consulting" description="Full-service LumApps implementation: strategy, design, content migration, change management and project management, led by the first LumApps deployment consultant onboarded in the US." bare>
  <div class="impl">
    <!-- HERO -->
    <section id="top" style="background: #05006C; color: #FFFFFF; position: relative; overflow: hidden">
      <div aria-hidden="true" style="position: absolute; right: -140px; bottom: -220px; width: 620px; height: 620px; border-radius: 50%; border: 90px solid rgba(54,45,255,0.32)"></div>
      <div style="max-width: 1200px; margin: 0 auto; padding: 96px 24px 108px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; position: relative">
        <div style="flex: 1.2 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 26px">
          <div style="display: inline-flex; align-self: flex-start; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); font-size: 14px; font-weight: 600; color: #E6E5FF">
            <span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: #32E0C4"></span>
            LumApps Implementation Services
          </div>
          <h1 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(40px, 5.2vw, 66px); line-height: 1.04; letter-spacing: -1.5px">From one shared vision to a LumApps platform <span style="color: #32E0C4">people actually use</span>.</h1>
          <p style="margin: 0; font-size: 19px; line-height: 1.6; color: #D4D2F5; max-width: 580px">Full-service LumApps implementation, led by the first LumApps deployment consultant onboarded in the US. We align your stakeholders, design the experience, migrate your content and launch — then make sure it sticks.</p>
          <div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 4px">
            <a class="btn-primary" href="#contact" style="background: #362DFF; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; box-sizing: border-box">Plan your implementation
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
            <a class="btn-ghost" href="#approach" style="color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.35); display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box">See our approach</a>
          </div>
          <div style="display: flex; align-items: center; gap: 18px; padding-top: 14px; border-top: 1px solid rgba(255,255,255,0.16); margin-top: 6px">
            <img src="/images/c8606b6cc61f.webp" alt="LumApps Partner Program: Trusted Partner, Consulting, Training and Design" style="width: 104px; height: 104px; object-fit: contain; flex: none">
            <div style="display: flex; flex-direction: column; gap: 4px">
              <span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 17px; color: #FFFFFF">LumApps Trusted Partner</span>
              <span style="font-size: 14px; line-height: 1.5; color: #D4D2F5">Certified for Consulting, Training &amp; Design</span>
            </div>
          </div>
        </div>

        <!-- Hero visual: Implementation holds the five disciplines -->
        <div role="img" aria-label="Implementation, made up of five parts: Strategy, Design, Migration, Change and Project Management" style="flex: 1 1 380px; min-width: 0; background: #FFFFFF; color: #05006C; border-radius: 26px; padding: 24px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 30px 60px rgba(0,0,0,0.25)">
          <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 4px 4px 6px">
            <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 24px">Implementation</span>
            <span style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #FFFFFF; background: #362DFF; padding: 6px 12px; border-radius: 999px">One team</span>
          </div>
          <div style="display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px">
            <div style="background: #05006C; color: #FFFFFF; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 6px; min-height: 104px; box-sizing: border-box"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 13px; color: #FFD458">01</span><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Strategy</span></div>
            <div style="background: #32E0C4; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 6px; min-height: 104px; box-sizing: border-box"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 13px">02</span><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Design</span></div>
            <div style="background: #FFD458; border-radius: 16px; padding: 16px; display: flex; flex-direction: column; gap: 6px; min-height: 104px; box-sizing: border-box"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 13px">03</span><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 18px">Migration</span></div>
          </div>
          <div style="background: #E9E8FF; border-radius: 14px; padding: 14px 16px; display: flex; align-items: center; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 13px; color: #362DFF">04</span><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 17px">Change</span><span style="margin-left: auto; font-size: 13px; color: #3A3870">Throughout</span></div>
          <div style="background: #F1F0FF; border-radius: 14px; padding: 14px 16px; display: flex; align-items: center; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 13px; color: #362DFF">05</span><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 17px">Project Management</span><span style="margin-left: auto; font-size: 13px; color: #3A3870">Throughout</span></div>
        </div>
      </div>
    </section>

    <!-- PROOF STRIP -->


    <!-- VISION QUOTE -->
    <section aria-label="Our philosophy" style="max-width: 1200px; margin: 0 auto; padding: 112px 24px 40px">
      <figure style="margin: 0; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start">
        <svg width="64" height="52" viewBox="0 0 34 28" fill="#FFD458" aria-hidden="true" style="flex: none"><path d="M0 28V16C0 6 5 1 14 0v6c-4 1-6 4-6 8h6v14zM20 28V16c0-10 5-15 14-16v6c-4 1-6 4-6 8h6v14z"></path></svg>
        <div style="flex: 1 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
          <blockquote style="margin: 0; font-family: Archivo, sans-serif; font-weight: 700; font-size: clamp(28px, 3.4vw, 44px); line-height: 1.18; letter-spacing: -0.8px; color: #05006C">A platform launch is a date on a calendar. An implementation is a promise — that on day 100, your people are <span style="color: #362DFF">still choosing</span> to use it.</blockquote>
          <figcaption style="display: flex; align-items: center; gap: 14px">
            <span style="width: 48px; height: 48px; border-radius: 50%; background: #05006C; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-family: Archivo, sans-serif; font-weight: 700">MZ</span>
            <span style="display: flex; flex-direction: column; gap: 2px"><span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 16px; color: #05006C">Misha Zubarev</span><span style="font-size: 14px; color: #4A4870">Founder &amp; Managing Director, ADC</span></span>
          </figcaption>
        </div>
      </figure>
    </section>

    <!-- APPROACH: Implementation as the main bucket -->
    <section id="approach" style="max-width: 1200px; margin: 0 auto; padding: 80px 24px 112px; display: flex; flex-direction: column; gap: 44px">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
        <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px">
          <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">The ADC Strategic Windows Approach</span>
          <h2 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.08; letter-spacing: -1px; color: #05006C">One implementation. Five disciplines. One accountable team.</h2>
        </div>
        <p style="margin: 0; font-size: 16px; line-height: 1.65; color: #4A4870; max-width: 380px">Strategy, design and migration happen in sequence. Change management and project management run alongside every phase, from kickoff to go-live.</p>
      </div>

      <!-- The bucket -->
      <div style="border: 2px solid #362DFF; background: #F7F7FC; border-radius: 32px; padding: clamp(24px, 3.5vw, 40px); display: flex; flex-direction: column; gap: 28px">

        <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px">
          <div style="display: flex; align-items: center; gap: 16px">
            <span style="width: 56px; height: 56px; border-radius: 16px; background: #362DFF; display: flex; align-items: center; justify-content: center; flex: none"><svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"></rect><path d="M3 9h18M9 21V9"></path></svg></span>
            <div style="display: flex; flex-direction: column; gap: 4px">
              <h3 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(24px, 7vw, 32px); line-height: 1.1; color: #05006C">Implementation</h3>
              <span style="font-size: 15px; color: #4A4870">Everything it takes to take LumApps from signed contract to a platform people use.</span>
            </div>
          </div>
          <span style="font-size: 13px; font-weight: 600; color: #2A22B8; background: #E9E8FF; padding: 6px 14px; border-radius: 999px">Scoped and delivered by ADC</span>
        </div>

        <!-- Sequenced phases -->
        <div style="display: flex; flex-direction: column; gap: 14px">
          <span style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">In sequence</span>
          <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 16px">

            <li style="background: #05006C; color: #FFFFFF; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
              <div style="display: flex; justify-content: space-between; align-items: center">
                <span style="width: 48px; height: 48px; border-radius: 14px; background: rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFD458" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><circle cx="12" cy="12" r="4"></circle><path d="M12 3v2M21 12h-2"></path></svg></span>
                <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #FFD458">01</span>
              </div>
              <h4 style="margin: 0; font-family: Archivo, sans-serif; font-size: 24px">Strategy</h4>
              <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #D4D2F5">Stakeholder alignment on one shared vision, before a single page is built.</p>
              <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; font-size: 13px"><span style="border: 1px solid rgba(255,255,255,0.3); padding: 5px 11px; border-radius: 999px">Use Case</span><span style="border: 1px solid rgba(255,255,255,0.3); padding: 5px 11px; border-radius: 999px">Architecture</span><span style="border: 1px solid rgba(255,255,255,0.3); padding: 5px 11px; border-radius: 999px">Governance</span><span style="border: 1px solid rgba(255,255,255,0.3); padding: 5px 11px; border-radius: 999px">Analytics</span><span style="border: 1px solid rgba(255,255,255,0.3); padding: 5px 11px; border-radius: 999px">Content UX</span></div>
            </li>

            <li style="background: #FFFFFF; border: 1.5px solid #ECEBF7; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
              <div style="display: flex; justify-content: space-between; align-items: center">
                <span style="width: 48px; height: 48px; border-radius: 14px; background: #32E0C4; display: flex; align-items: center; justify-content: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M9 9v11"></path></svg></span>
                <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #0A6B5C">02</span>
              </div>
              <h4 style="margin: 0; font-family: Archivo, sans-serif; font-size: 24px; color: #05006C">Design</h4>
              <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Templates, mockups and a final experience that looks and feels like your brand, from a LumApps-certified design partner.</p>
              <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; font-size: 13px; color: #3A3870"><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Templates</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Mockups</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Custom CSS</span></div>
            </li>

            <li style="background: #FFFFFF; border: 1.5px solid #ECEBF7; border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
              <div style="display: flex; justify-content: space-between; align-items: center">
                <span style="width: 48px; height: 48px; border-radius: 14px; background: #FFD458; display: flex; align-items: center; justify-content: center"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h11M11 3l4 4-4 4M20 17H9M13 13l-4 4 4 4"></path></svg></span>
                <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #8A6500">03</span>
              </div>
              <h4 style="margin: 0; font-family: Archivo, sans-serif; font-size: 24px; color: #05006C">Migration</h4>
              <p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Content audit, cleanup and mapping from legacy platforms, migrated and validated in your new LumApps architecture.</p>
              <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; font-size: 13px; color: #3A3870"><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">SharePoint</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Jive</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Workplace</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Audit · Map · Validate</span></div>
            </li>
          </ol>
        </div>

        <!-- Running throughout -->
        <div style="display: flex; flex-direction: column; gap: 14px">
          <span style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">Throughout, from kickoff to go-live</span>
          <ol start="4" style="list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px">

            <li style="background: #FFFFFF; border: 1.5px solid #ECEBF7; border-radius: 22px; padding: 24px 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px">
              <div style="display: flex; align-items: center; gap: 16px; flex: 0 1 260px; min-width: 0">
                <span style="width: 48px; height: 48px; border-radius: 14px; background: #362DFF; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3"></circle><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"></path><path d="M16 4.5a3 3 0 0 1 0 6M21 20c0-2.6-1.6-4.8-4-5.6"></path></svg></span>
                <div style="display: flex; flex-direction: column; gap: 2px">
                  <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 14px; color: #362DFF">04</span>
                  <h4 style="margin: 0; font-family: Archivo, sans-serif; font-size: 22px; color: #05006C">Change</h4>
                </div>
              </div>
              <p style="margin: 0; flex: 1 1 320px; min-width: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Change management that gets people ready before launch day: sponsors who lead visibly, a communications plan, and enablement that turns go-live into everyday habit.</p>
              <div style="display: flex; flex-wrap: wrap; gap: 8px; flex: 0 1 300px; font-size: 13px; color: #3A3870"><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Sponsorship</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Communications</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Champions</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Training</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Adoption</span></div>
            </li>

            <li style="background: #FFFFFF; border: 1.5px solid #ECEBF7; border-radius: 22px; padding: 24px 28px; display: flex; flex-wrap: wrap; align-items: center; gap: 20px 28px">
              <div style="display: flex; align-items: center; gap: 16px; flex: 0 1 260px; min-width: 0">
                <span style="width: 48px; height: 48px; border-radius: 14px; background: #05006C; display: flex; align-items: center; justify-content: center; flex: none"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4M8 15l2 2 4-4"></path></svg></span>
                <div style="display: flex; flex-direction: column; gap: 2px">
                  <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 14px; color: #362DFF">05</span>
                  <h4 style="margin: 0; font-family: Archivo, sans-serif; font-size: 22px; color: #05006C">Project Management</h4>
                </div>
              </div>
              <p style="margin: 0; flex: 1 1 320px; min-width: 0; font-size: 15px; line-height: 1.6; color: #4A4870">One accountable lead who owns the plan, the milestones and the risks, and keeps your team, IT and LumApps moving to the same date.</p>
              <div style="display: flex; flex-wrap: wrap; gap: 8px; flex: 0 1 300px; font-size: 13px; color: #3A3870"><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Plan &amp; milestones</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Status reporting</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Risks</span><span style="background: #F1F0FF; padding: 5px 11px; border-radius: 999px">Go-live</span></div>
            </li>
          </ol>
        </div>
      </div>
    </section>

    <!-- SOUND FAMILIAR -->
    <section aria-labelledby="familiar-h" style="background: #F7F7FC">
      <div style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
        <div style="flex: 1 1 340px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
          <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">Sound familiar?</span>
          <h2 id="familiar-h" style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.1; letter-spacing: -1px; color: #05006C">The questions we hear before every rollout.</h2>
          <p style="margin: 0; font-size: 17px; line-height: 1.65; color: #4A4870">If one of these is on your mind, you're in the right place. Each one maps to a window in our approach.</p>
        </div>
        <div style="flex: 1.4 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
          <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“Who's going to help us roll this out?”</span><span style="font-size: 13px; font-weight: 600; color: #2A22B8; background: #E9E8FF; padding: 5px 12px; border-radius: 999px">Strategy</span></div>
          <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“How do we get people to actually use it?”</span><span style="font-size: 13px; font-weight: 600; color: #FFFFFF; background: #362DFF; padding: 5px 12px; border-radius: 999px">Change</span></div>
          <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“We need it to look and feel like our brand.”</span><span style="font-size: 13px; font-weight: 600; color: #0A6B5C; background: #DDF9F4; padding: 5px 12px; border-radius: 999px">Design</span></div>
          <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“We're moving off SharePoint. What happens to our content?”</span><span style="font-size: 13px; font-weight: 600; color: #6B4E00; background: #FFF3CC; padding: 5px 12px; border-radius: 999px">Migration</span></div>
          <div style="background: #FFFFFF; border-radius: 18px; padding: 20px 24px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px"><span style="font-size: 17px; font-weight: 600; color: #05006C">“Can employees see their Workday tasks without leaving the intranet?”</span><span style="font-size: 13px; font-weight: 600; color: #FFFFFF; background: #362DFF; padding: 5px 12px; border-radius: 999px">Implementation</span></div>
