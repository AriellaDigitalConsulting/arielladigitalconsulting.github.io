---
// Follow Actions Bundle product page ("Split Editorial" template, modeled on Estimated Reading Time).
// Copy comes from the original /follow-actions page and the ADC Follow Actions Bundle deck; screenshots are from the deck.
import Base from '../layouts/Base.astro';
import { contactHref } from '../data/site';

const why = [
  { title: 'Keep the experience organized', text: 'Categorize follow actions by topic, social area, and people, so employees get the news, announcements, and knowledge that matter to them more effectively.' },
  { title: 'Give a guided experience', text: 'Guide employees to what they should follow by putting each follow button in context, right next to the information that explains why it matters.' },
  { title: 'Make it easy to opt in', text: 'Let employees take action right away, instead of sending them off to another page to find the follow button.' },
];

const features = [
  { title: 'Guidance for Follows.', text: 'Give your users clearer guidance on which areas to follow, for smarter and more informed choices.' },
  { title: 'Leaders & Social Content in One Click.', text: 'Make it easy to follow a Space, a Community, or a leader directly from the homepage.' },
  { title: 'Multiple Interests per Page.', text: 'Display as many interests as you like on one page, without needing a content list or content filter widget.' },
  { title: 'Engagement in One Place.', text: 'With follow actions grouped on one page, or just a few, tracking engagement with those buttons gets much easier.' },
];

const widgets = [
  { img: '/images/cabf026f983a.webp', title: 'Follow Interests', text: 'Expose a Follow Interest button on any page, so employees can subscribe to the topics that matter to them.', href: '/follow-interests' },
  { img: '/images/4b9648d7ddbf.webp', title: 'Follow Space or Community', text: 'Pick any Space or Community and let employees follow it in one click, right where they read about it.' },
  { img: '/images/9ae666e53401.webp', title: 'Follow People', text: 'Let employees follow a colleague or leader straight from a profile card, a leadership page, or the homepage.' },
];

const included = ['Unlimited usage (no user limit)', 'Extension initiation, setup and training', 'All three extensions: Follow Interests, Follow People, Follow Space & Community', 'ADC Extension Maintenance & Support'];

const value = [
  { bg: '#f5f5ff', tileBg: '#362dff', tileFg: '#fff', icon: '<path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7z"/><path d="M9 12l2 2 4-4"/>', title: 'Administrators & Experience Managers', text: 'Fewer pages to manage, with every follow experience in one central area instead of spread across the site. And with follows grouped together, engagement is much easier to track.' },
  { bg: '#FFD458', tileBg: '#05006c', tileFg: '#FFD458', icon: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2a5 5 0 0 1 5 5.3"/>', title: 'Employees', text: 'An intuitive way to opt in to areas of interest that turns a static intranet into a dynamic network, where people don’t just consume content, they connect with it.' },
  { bg: '#f5f5ff', tileBg: '#32E0C4', tileFg: '#05006c', icon: '<path d="M3 11v2a1 1 0 0 0 1 1h3l6 4V6L7 10H4a1 1 0 0 0-1 1z"/><path d="M17 8a5 5 0 0 1 0 8"/>', title: 'Leaders & Internal Communications', text: 'Grow the audience for leadership messages and key communities by inviting employees to follow them right from the homepage or a leadership page.' },
];

const related = [
  { href: '/follow-interests', accent: '#FFD458', icon: '<path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>', title: 'Follow Interests widget.', text: 'Take a closer look at the Follow Interests widget on its own, with examples of how it works.' },
  { href: '/town-hall', accent: '#32E0C4', icon: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>', title: 'Community Posts in Real Time.', text: 'Keep communities lively with posts that update live, and let employees post to any Space or Community in one click.' },
];

const icon = (paths: string, size = 28) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const check = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
const star = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3l2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/></svg>';
const plus = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>';
---

<Base title="Follow Actions Bundle | Ariella Digital Consulting" description="The Follow Actions Bundle by ADC: follow People, Spaces, Communities and Interests from one guided page in LumApps.">
  <div class="fa">
    <section class="fa__hero" data-custom-prompt-after>
      <div class="fa__wrap fa__hero-grid">
        <div class="fa__hero-copy">
          <a class="fa__back" href="/products">← Back to Products Page</a>
          <p class="fa__tagline">Follow what matters, in one click.</p>
          <h1>Follow Actions<br />Bundle <span>by ADC</span></h1>
          <p class="fa__lede">This three-in-one bundle makes it easy to follow People, LumApps Spaces or Communities, and Interests. Organize every follow in one single page, so engaging with content is simple and accessible for every employee.</p>
          <div class="fa__hero-ctas">
            <a class="fa__btn fa__btn--blue" href={contactHref}>Request a Demo</a>
            <a class="fa__docs" href="#widgets">
              <span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#05006c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
              </span>
              See the 3 widgets
            </a>
          </div>
        </div>

        <div class="fa__visual">
          <div class="fa__arch">
            <div class="fa__arch-floor" aria-hidden="true"></div>
            <div class="fa__flare flare" aria-hidden="true"></div>
            <div class="fa__stack">
              <div class="fa__count" aria-hidden="true">
                <span>3</span>
                <span>WIDGETS IN 1</span>
              </div>
              <ul class="fa__follows" aria-label="Example follow buttons">
                <li class="fa__follow fa__follow--on"><Fragment set:html={check} />Interest followed</li>
                <li class="fa__follow fa__follow--pulse"><Fragment set:html={star} />Follow All About Spaces</li>
                <li class="fa__follow"><Fragment set:html={plus} />Follow Leadership Corner</li>
              </ul>
            </div>
            <div class="fa__sweep-clip" aria-hidden="true"><div class="fa__sweep sweep"></div></div>
          </div>
          <div class="fa__mock" aria-hidden="true">
            <img src="/images/follow-actions-leadership-blogs.webp" alt="" width="516" height="1015" loading="eager" />
          </div>
          <span class="fa__sticker">Customer Upgrade Bundle</span>
        </div>
      </div>
    </section>

    <section class="fa__why fa__wrap">
      <div class="fa__why-head">
        <p class="fa__eyebrow">OUR BUNDLE</p>
        <h2>Why<br />use it</h2>
        <div class="fa__bar" aria-hidden="true"></div>
      </div>
      <ol class="fa__why-list">
        {
          why.map((w, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="fa__does">
      <div class="fa__wrap">
        <div class="fa__heading">
          <p class="fa__eyebrow fa__eyebrow--yellow">HAVE A LOOK AT</p>
          <h2>What it does</h2>
        </div>
        <div class="fa__figs">
          <figure>
            <div class="fa__fig fa__fig--white">
              <img src="/images/b9f48d921f81.webp" alt="The Hive's Must Follows page, with a follow button under each community, space and interest" width="1018" height="1088" loading="lazy" />
            </div>
            <figcaption>Live from The Hive: a "Must Follows" page where every recommendation has its own follow button.</figcaption>
          </figure>
          <figure>
            <div class="fa__fig fa__fig--yellow">
              <img src="/images/follow-actions-leadership-corner.webp" alt="A Leadership Corner page in LumApps showing the leadership team" width="1400" height="611" loading="lazy" />
            </div>
            <figcaption>A Leadership Corner where employees follow leaders, their blogs, and related interests in one place.</figcaption>
          </figure>
        </div>
        <div class="fa__features">
          {
            features.map((f, i) => (
              <div>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="fa__steps-sec" id="widgets">
      <div class="fa__wrap">
        <div class="fa__heading">
          <p class="fa__eyebrow">WHAT YOU GET</p>
          <h2 class="fa__h2-md">Three widgets, one bundle</h2>
        </div>
        <ol class="fa__steps">
          {
            widgets.map((w, i) => (
              <li>
                <img class="fa__widget-card" src={w.img} alt={`${w.title} widget in the LumApps marketplace`} width="730" height="306" loading="lazy" />
                <span class="fa__step-num">WIDGET {i + 1}</span>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
                {w.href && <a class="fa__more" href={w.href}>Learn More →</a>}
              </li>
            ))
          }
        </ol>
        <div class="fa__band" data-custom-prompt-hide>
          <div>
            <p class="fa__band-title">All pricing includes</p>
            <ul class="fa__included">
              {included.map((item) => <li><Fragment set:html={check} />{item}</li>)}
            </ul>
          </div>
          <div class="fa__band-cta">
            <p>Contact ADC for a no-commitment trial.</p>
            <a class="fa__btn fa__btn--yellow" href={contactHref}>Start a Free Trial</a>
          </div>
        </div>
      </div>
    </section>

    <section class="fa__value fa__wrap">
      <div class="fa__value-head">
        <div class="fa__heading">
          <p class="fa__eyebrow">WHY DO YOU NEED THIS</p>
          <h2>Who it benefits</h2>
        </div>
        <p>Added value for your site administrators, your employees, and the leaders they follow</p>
      </div>
      <div class="fa__value-list">
        {
          value.map((v) => (
            <div style={`background:${v.bg}`}>
              <div class="fa__value-title">
                <span style={`background:${v.tileBg};color:${v.tileFg}`} set:html={icon(v.icon)} />
                <h3>{v.title}</h3>
              </div>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="fa__further fa__wrap">
      <div class="fa__heading">
        <p class="fa__eyebrow">GO FURTHER</p>
        <h2 class="fa__h2-sm">Explore More Communities &amp; Social Experiences by ADC</h2>
      </div>
      <div class="fa__further-grid">
        {
          related.map((r) => (
            <a href={r.href}>
              <span class="fa__further-icon" style={`color:${r.accent}`} set:html={icon(r.icon, 30)} />
              <span class="fa__further-text">
                <span class="fa__further-title">{r.title}</span>
                <span>{r.text}</span>
                <span class="fa__more">Learn More →</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="fa__cta" data-custom-prompt-hide>
      <div class="fa__cta-blue">
        <h2>Got questions?</h2>
        <p>Get in touch to learn more about this bundle and to see a demo</p>
        <div><a class="fa__btn fa__btn--yellow fa__btn--lg" href={contactHref}>Contact us</a></div>
      </div>
    </section>
  </div>
</Base>

<style>
  .fa {
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #000;
    line-height: 1.5;
  }
  .fa * {
    box-sizing: border-box;
  }
  .fa h1,
  .fa h2,
  .fa h3 {
    font-family: 'Archivo', sans-serif;
    margin: 0;
  }
  .fa p,
  .fa ol,
  .fa figure {
    margin: 0;
  }
  .fa a:focus-visible {
    outline: 3px solid #32e0c4;
    outline-offset: 2px;
  }
  .fa__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .fa__eyebrow {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: 13px;
    color: #362dff;
  }
  .fa__eyebrow--yellow {
    color: #ffd458;
  }
  .fa__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .fa__heading h2,
  .fa__why-head h2 {
    font-weight: 900;
    font-size: clamp(44px, 5.5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #05006c;
  }
  .fa__heading .fa__h2-md {
    font-size: clamp(40px, 5vw, 64px);
  }
  .fa__heading .fa__h2-sm {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .fa__btn {
    display: inline-block;
    padding: 18px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 17px;
    transition: transform 0.15s ease;
  }
  .fa__btn:hover {
    transform: translateY(-2px);
  }
  .fa__btn--blue {
    background: #362dff;
    color: #fff;
  }
  .fa__btn--blue:hover {
    background: #05006c;
    color: #fff;
  }
  .fa__btn--yellow {
    background: #ffd458;
    color: #05006c;
  }
  .fa__btn--yellow:hover {
    color: #05006c;
  }
  .fa__btn--lg {
    padding: 18px 34px;
    font-size: 18px;
  }

  /* Animations (off for reduced motion) */
  .sweep {
    animation: sweep 7s ease-in-out infinite;
  }
  @keyframes sweep {
    0% {
      transform: translateX(-120%) skewX(-18deg);
    }
    60%,
    100% {
      transform: translateX(220%) skewX(-18deg);
    }
  }
  .flare {
    animation: flare 3.2s ease-in-out infinite;
  }
  @keyframes flare {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sweep,
    .flare,
    .fa__follow--pulse {
      animation: none;
    }
  }

  /* Hero */
  .fa__hero {
    overflow: hidden;
    padding-top: 40px;
    background: #f5f5ff;
  }
  .fa__hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 48px;
    align-items: end;
  }
  .fa__hero-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 96px;
  }
  .fa__back {
    align-self: flex-start;
    padding: 8px 16px;
    border: 1.5px solid #05006c;
    border-radius: 999px;
    color: #05006c;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }
  .fa__back:hover {
    background: #05006c;
    color: #fff;
  }
  .fa__tagline {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: #362dff;
  }
  .fa h1 {
    font-weight: 900;
    font-size: clamp(52px, 7vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #05006c;
  }
  .fa h1 span {
    padding: 6px 16px;
    border-radius: 999px;
    background: #fff;
    color: #362dff;
    font-size: 0.4em;
    font-weight: 700;
    letter-spacing: 0;
    vertical-align: middle;
    white-space: nowrap;
  }
  .fa__lede {
    max-width: 540px;
    font-size: 19px;
    line-height: 1.65;
    color: #1d1c3a;
  }
  .fa__hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
  }
  .fa__docs {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #05006c;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
  }
  .fa__docs:hover {
    color: #362dff;
  }
  .fa__docs span {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #05006c;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .fa__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 600px;
  }
  .fa__arch {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(480px, 100%);
    height: 580px;
    border-radius: 240px 240px 0 0;
    overflow: hidden;
    background: #05006c;
    box-shadow: 0 30px 60px rgba(5, 0, 108, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .fa__arch-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    background: #362dff;
  }
  .fa__flare {
    position: absolute;
    left: 8%;
    top: 8%;
    width: 50%;
    height: 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0));
  }
  .fa__sweep-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .fa__sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 35%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0));
  }
  .fa__mock {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 220px;
    height: 360px;
    overflow: hidden;
    border-radius: 34px 34px 0 0;
    border: 10px solid #05006c;
    border-bottom: none;
    background: #fff;
    box-shadow: 0 20px 50px rgba(5, 0, 108, 0.3);
  }
  .fa__mock img {
    display: block;
    width: 100%;
    height: auto;
  }
  .fa__sticker {
    position: absolute;
    top: 40px;
    right: 0;
    padding: 12px 18px;
    border-radius: 999px;
    background: #ffd458;
    color: #05006c;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    transform: rotate(3deg);
    box-shadow: 0 10px 30px rgba(5, 0, 108, 0.2);
  }

  /* Why use it */
  .fa__why {
    padding-top: 120px;
    padding-bottom: 120px;
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
  }
  .fa__why-head {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fa__bar {
    width: 96px;
    height: 12px;
    margin-top: 12px;
    border-radius: 6px;
    background: #32e0c4;
  }
  .fa__why-list {
    flex: 999 1 560px;
    min-width: 0;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .fa__why-list li {
    display: flex;
    gap: 32px;
    align-items: baseline;
    padding: 32px 0;
    border-top: 1px solid #d9d7ff;
  }
  .fa__why-list li:first-child {
    border-top: 2px solid #05006c;
  }
  .fa__why-list li:last-child {
    border-bottom: 1px solid #d9d7ff;
  }
  .fa__why-list li > span {
    min-width: 72px;
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: 44px;
    color: #362dff;
  }
  .fa__why-list li > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .fa__why-list h3 {
    font-weight: 800;
    font-size: 24px;
    color: #05006c;
  }
  .fa__why-list p {
    font-size: 19px;
    line-height: 1.55;
  }

  /* What it does */
  .fa__does {
    padding: 120px 0;
    background: #05006c;
    color: #fff;
  }
  .fa__does .fa__wrap {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .fa__does .fa__heading h2 {
    color: #fff;
  }
  .fa__figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }
  .fa__figs figure {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fa__figs figcaption {
    font-size: 15px;
    color: #c9c7ff;
  }
  .fa__fig {
    aspect-ratio: 4 / 3;
    border-radius: 24px;
    padding: 40px;
    display: flex;
  }
  .fa__fig--white {
    border: 8px solid #fff;
    background: #fff;
    color: #33325a;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }
  .fa__fig--yellow {
    border: 8px solid #ffd458;
    background: #1c1690;
    align-items: center;
    justify-content: center;
  }
  .fa__features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 0 32px;
    border-top: 2px solid #362dff;
  }
  .fa__features > div {
    padding: 36px 0;
    border-bottom: 1px solid #2a2499;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .fa__features span {
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: 52px;
    line-height: 1;
    color: #32e0c4;
  }
  .fa__features h3 {
    font-weight: 800;
    font-size: 24px;
  }
  .fa__features p {
    font-size: 16px;
    line-height: 1.6;
    color: #e4e3ff;
  }

  /* Steps */
  .fa__steps-sec {
    padding: 112px 0;
    background: #f5f5ff;
