---
// LumApps Analytics services page ("Split Editorial" template). Replaces the layout snapshot of /analytics.
// The design's social-proof section (customer quote, client logos, stat) was all placeholders, so it's left out.
import Base from '../layouts/Base.astro';
import { contactHref, social } from '../data/site';

const why = [
  { title: 'Use cases that matter', text: 'Our deep knowledge of LumApps, its best practices and real customer use cases helps you define the questions worth answering, and the right data for the right audience.' },
  { title: 'Dashboards built around you', text: 'Sometimes the data sits in one place; sometimes it takes creativity to pull it together. Either way, we serve it up as a custom dashboard that tells your story.' },
  { title: 'Your data, your BI tool', text: 'We integrate and blend data from any available source and deliver it in the BI tool you already use, from Looker Studio to Tableau and beyond.' },
];

const phases = [
  { tag: 'DEFINE', title: 'Identify your use cases.', text: "Collaborative working sessions to uncover the data you need, where it lives, and who it's for." },
  { tag: 'INTEGRATE', title: 'Connect the right sources.', text: 'From Google Tag Manager tags to BigQuery and custom data extraction, we wire up every data point.' },
  { tag: 'DESIGN', title: 'Tell your data story.', text: 'Clean, engaging dashboards in your BI tool of choice, shaped around the use cases we defined together.' },
  { tag: 'DELIVER', title: 'Bring it all together.', text: 'Fully tested and handed over for your review and approval, with enablement so your team owns it.' },
];

const useCases = [
  {
    tone: 'white',
    tileBg: '#362dff',
    tileFg: '#fff',
    dot: '#32E0C4',
    icon: '<path d="M3 11v2a1 1 0 0 0 1 1h3l6 4V6L7 10H4a1 1 0 0 0-1 1z"/><path d="M17 8a5 5 0 0 1 0 8"/>',
    title: 'Corporate Communications',
    items: [
      "See who's viewing content by department, function, or business unit",
      'Understand who follows which communities',
      'Measure how far readers scroll on every page',
      'Spotlight your most active community posts',
      'Map activity heat maps to send messages when people are most engaged',
    ],
  },
  {
    tone: 'yellow',
    tileBg: '#05006c',
    tileFg: '#FFD458',
    dot: '#362dff',
    icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>',
    title: 'Information Technology',
    items: [
      'Blend Data Lake datasets with the LumApps Platform Logs API',
      'Track user actions across the platform',
      'Capture detailed, customized reports on community activity',
      'Give admins utility dashboards that show who deleted what content, and when',
    ],
  },
];

const services = [
  { bg: '#362dff', fg: '#fff', icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2 20v-1a4 4 0 0 1 4-4h6a4 4 0 0 1 4 4v1M16 4.6a3.5 3.5 0 0 1 0 6.8M22 20v-1a4 4 0 0 0-3-3.9"/>', title: 'Analytics working sessions' },
  { bg: '#32E0C4', fg: '#05006c', icon: '<ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>', title: 'Custom data ingestion from multiple sources' },
  { bg: '#FFD458', fg: '#05006c', icon: '<path d="M20.6 13.4l-7.2 7.2a2 2 0 0 1-2.8 0L3 13V3h10l7.6 7.6a2 2 0 0 1 0 2.8z"/><circle cx="7.5" cy="7.5" r="1.5"/>', title: 'Tag Manager integrations' },
  { bg: '#362dff', fg: '#fff', icon: '<path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/>', title: 'Connecting the LumApps Data Lake to your BI tools' },
  { bg: '#32E0C4', fg: '#05006c', icon: '<path d="M21 12a9 9 0 0 1-15.5 6.2M3 12a9 9 0 0 1 15.5-6.2"/><path d="M18 2v4h-4M6 22v-4h4"/>', title: 'Universal Analytics to GA4 conversion' },
  { bg: '#FFD458', fg: '#05006c', icon: '<path d="M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z"/>', title: 'Custom Looker Studio dashboards' },
];

const related = [
  { href: '/implementations', accent: '#FFD458', icon: '<path d="M4.5 16.5c-1.5 1.3-2 5-2 5s3.7-.5 5-2c.7-.8.7-2.1-.1-2.9a2.2 2.2 0 0 0-2.9-.1z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.9A12.9 12.9 0 0 1 22 2c0 2.7-.8 7.5-6 11a22.4 22.4 0 0 1-4 2z"/>', title: 'LumApps Implementations.', text: 'Launch or relaunch your LumApps digital workplace with a team that has done it since 2017.' },
  { href: '/sme-support', accent: '#32E0C4', icon: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1v-6h3zM3 19a2 2 0 0 0 2 2h1v-6H3z"/>', title: 'Strategy & SME Support.', text: 'On-demand LumApps expertise to guide your strategy, governance, and day-to-day decisions.' },
];

const youtube = social.find((s) => s.label === 'youtube/adc')!.href;
const icon = (paths: string, size = 28) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const heat = ['#e8e7f5', '#d9d7ff', '#362dff', '#05006c', '#362dff', '#d9d7ff', '#d9d7ff', '#362dff', '#05006c', '#362dff', '#d9d7ff', '#e8e7f5', '#e8e7f5', '#d9d7ff', '#362dff', '#d9d7ff', '#e8e7f5', '#e8e7f5'];
---

<Base title="LumApps Analytics | Ariella Digital Consulting" description="LumApps analytics by ADC: define the questions that matter, connect the right data sources, and get custom dashboards in the BI tool you already use.">
  <div class="an">
    <section class="an__hero">
      <div class="an__wrap an__hero-grid">
        <div class="an__hero-copy">
          <a class="an__back" href="/">← Back to Home</a>
          <p class="an__tagline">Turn LumApps data into decisions.</p>
          <h1>LumApps<br />Analytics <span>by ADC</span></h1>
          <p class="an__lede">Go beyond out-of-the-box reporting. We help LumApps customers define what matters, connect the right data sources, and deliver dashboards that tell a clear story to the people who need it.</p>
          <div class="an__hero-ctas">
            <a class="an__btn an__btn--blue" href={contactHref}>Book a Free Consultation</a>
            <a class="an__jump" href="#approach">
              <span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#05006c" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
              </span>
              See our approach
            </a>
          </div>
        </div>

        <div class="an__visual" aria-hidden="true">
          <div class="an__arch">
            <div class="an__flare flare"></div>
            <div class="an__arch-floor"></div>
            <div class="an__bars">
              {
                [
                  { h: 38, c: '#2a2499' },
                  { h: 56, c: '#2a2499' },
                  { h: 48, c: '#32E0C4' },
                  { h: 74, c: '#2a2499' },
                  { h: 100, c: '#FFD458' },
                ].map((b, i) => <span class="bar" style={`height:${b.h}%;background:${b.c};animation-delay:${i * 0.4}s`} />)
              }
            </div>
            <svg class="an__trend" width="368" height="240" viewBox="0 0 368 240" fill="none">
              <path d="M10 200 L90 150 L170 170 L250 90 L350 30" stroke="#fff" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"></path>
              <circle cx="350" cy="30" r="9" fill="#FFD458" stroke="#fff" stroke-width="3"></circle>
            </svg>
            <div class="an__sweep-clip"><div class="an__sweep sweep"></div></div>
          </div>
          <div class="an__mock">
            <span class="an__mock-title">Content views by BU</span>
            <span class="an__mock-bars">
              {[{ w: 92, c: '#362dff' }, { w: 70, c: '#362dff' }, { w: 54, c: '#32E0C4' }, { w: 38, c: '#d9d7ff' }].map((b) => <span style={`width:${b.w}%;background:${b.c}`} />)}
            </span>
            <span class="an__mock-title">Activity by hour</span>
            <span class="an__heat">{heat.map((c) => <span style={`background:${c}`} />)}</span>
          </div>
          <span class="an__sticker">Any source · any BI tool</span>
        </div>
      </div>
    </section>

    <section class="an__why an__wrap">
      <div class="an__why-head">
        <p class="an__eyebrow">HOW WE HELP</p>
        <h2>Why<br />ADC</h2>
        <div class="an__bar" aria-hidden="true"></div>
      </div>
      <ol class="an__why-list">
        {
          why.map((w, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="an__approach" id="approach">
      <div class="an__wrap">
        <div class="an__split-head">
          <div class="an__heading">
            <p class="an__eyebrow an__eyebrow--yellow">OUR APPROACH</p>
            <h2>From question<br />to dashboard</h2>
          </div>
          <p>A proven four-phase methodology that takes you from first conversation to a dashboard your stakeholders rely on.</p>
        </div>
        <ol class="an__phases">
          {
            phases.map((p, i) => (
              <li>
                <span class="an__phase-num">{String(i + 1).padStart(2, '0')}</span>
                <span class="an__phase-tag">{p.tag}</span>
                <h3>{p.title}</h3>
                <p>{p.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="an__cases-sec">
      <div class="an__wrap">
        <div class="an__heading">
          <p class="an__eyebrow">USE CASES</p>
          <h2 class="an__h2-md">Answers for every team</h2>
        </div>
        <div class="an__cases">
          {
            useCases.map((u) => (
              <div class:list={['an__case', `an__case--${u.tone}`]}>
                <div class="an__case-head">
                  <span style={`background:${u.tileBg};color:${u.tileFg}`} set:html={icon(u.icon)} />
                  <h3>{u.title}</h3>
                </div>
                <ul>
                  {u.items.map((it) => (
                    <li>
                      <span aria-hidden="true" style={`background:${u.dot}`} />
                      {it}
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
        <div class="an__band">
          <p>What could your LumApps data tell you?</p>
          <a class="an__btn an__btn--yellow" href={contactHref}>Book a Free Consultation</a>
        </div>
      </div>
    </section>

    <section class="an__deliver an__wrap">
      <div class="an__split-head">
        <div class="an__heading">
          <p class="an__eyebrow">LEARN MORE ABOUT</p>
          <h2>What we deliver</h2>
        </div>
        <p>End-to-end analytics services for Internal Communications, IT, and digital workplace teams</p>
      </div>
      <div class="an__services">
        {
          services.map((s) => (
            <div>
              <span style={`background:${s.bg};color:${s.fg}`} set:html={icon(s.icon, 24)} />
              <h3>{s.title}</h3>
            </div>
          ))
        }
      </div>
    </section>

    <section class="an__further an__wrap">
      <div class="an__heading">
        <p class="an__eyebrow">GO FURTHER</p>
        <h2 class="an__h2-sm">Explore More LumApps Services by ADC</h2>
      </div>
      <div class="an__further-grid">
        {
          related.map((r) => (
            <a href={r.href}>
              <span class="an__further-icon" style={`color:${r.accent}`} set:html={icon(r.icon, 30)} />
              <span class="an__further-text">
                <span class="an__further-title">{r.title}</span>
                <span>{r.text}</span>
                <span class="an__more">Learn More →</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="an__cta">
      <div class="an__cta-blue">
        <h2>Got questions?</h2>
        <p>Get in touch for a free consultation and let's map out your analytics journey together</p>
        <div><a class="an__btn an__btn--yellow an__btn--lg" href={contactHref}>Contact us</a></div>
      </div>
      <div class="an__cta-yellow">
        <p class="an__eyebrow">LEARN WITH US</p>
        <p class="an__cta-title">ADC Live! webinars</p>
        <p>Free LumApps sessions packed with practical tips, new features, and real customer use cases.</p>
        <div><a class="an__btn an__btn--navy an__btn--lg" href={youtube}>Watch on YouTube</a></div>
      </div>
    </section>
  </div>
</Base>

<style>
  .an {
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #000;
    line-height: 1.5;
  }
  .an * {
    box-sizing: border-box;
  }
  .an h1,
  .an h2,
  .an h3 {
    font-family: 'Archivo', sans-serif;
    margin: 0;
  }
  .an p,
  .an ol,
  .an ul {
    margin: 0;
  }
  .an a:focus-visible {
    outline: 3px solid #32e0c4;
    outline-offset: 2px;
  }
  .an__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .an__eyebrow {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: 13px;
    color: #362dff;
  }
  .an__eyebrow--yellow {
    color: #ffd458;
  }
  .an__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .an__heading h2,
  .an__why-head h2 {
    font-weight: 900;
    font-size: clamp(44px, 5.5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #05006c;
  }
  .an__heading .an__h2-md {
    font-size: clamp(40px, 5vw, 64px);
  }
  .an__heading .an__h2-sm {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .an__split-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .an__split-head > p {
    max-width: 420px;
    font-size: 19px;
    color: #33325a;
  }
  .an__btn {
    display: inline-block;
    padding: 18px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 17px;
    transition: transform 0.15s ease;
  }
  .an__btn:hover {
    transform: translateY(-2px);
  }
  .an__btn--blue {
    background: #362dff;
    color: #fff;
  }
  .an__btn--blue:hover {
    background: #05006c;
    color: #fff;
  }
  .an__btn--yellow {
    background: #ffd458;
    color: #05006c;
  }
  .an__btn--yellow:hover {
    color: #05006c;
  }
  .an__btn--navy {
    background: #05006c;
    color: #fff;
  }
  .an__btn--navy:hover {
    color: #fff;
  }
  .an__btn--lg {
    padding: 18px 34px;
    font-size: 18px;
  }

  /* Animations (off for reduced motion) */
  .sweep {
    animation: sweep 7s ease-in-out infinite;
  }
  @keyframes sweep {
    0% {
      transform: translateX(-120%) skewX(-18deg);
    }
    60%,
    100% {
      transform: translateX(220%) skewX(-18deg);
    }
  }
  .flare {
    animation: flare 3.2s ease-in-out infinite;
  }
  @keyframes flare {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.6;
    }
  }
  .bar {
    transform-origin: bottom;
    animation: grow 5s ease-in-out infinite alternate;
  }
  @keyframes grow {
    0% {
      transform: scaleY(0.35);
    }
    55%,
    100% {
      transform: scaleY(1);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sweep,
    .flare,
    .bar {
      animation: none;
    }
  }

  /* Hero */
  .an__hero {
    overflow: hidden;
    padding-top: 40px;
    background: #f5f5ff;
  }
  .an__hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 48px;
    align-items: end;
  }
  .an__hero-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 96px;
  }
  .an__back {
    align-self: flex-start;
    padding: 8px 16px;
    border: 1.5px solid #05006c;
    border-radius: 999px;
    color: #05006c;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }
  .an__back:hover {
    background: #05006c;
    color: #fff;
  }
  .an__tagline {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: #362dff;
  }
  .an h1 {
    font-weight: 900;
    font-size: clamp(52px, 7vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #05006c;
  }
  .an h1 span {
    padding: 6px 16px;
    border-radius: 999px;
    background: #fff;
    color: #362dff;
    font-size: 0.4em;
    font-weight: 700;
    letter-spacing: 0;
    vertical-align: middle;
    white-space: nowrap;
  }
  .an__lede {
    max-width: 540px;
    font-size: 19px;
    line-height: 1.65;
    color: #1d1c3a;
  }
  .an__hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
  }
  .an__jump {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #05006c;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
  }
  .an__jump:hover {
    color: #362dff;
  }
  .an__jump span {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #05006c;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .an__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 600px;
  }
  .an__arch {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(480px, 100%);
    height: 580px;
    border-radius: 240px 240px 0 0;
    overflow: hidden;
    background: #05006c;
    box-shadow: 0 30px 60px rgba(5, 0, 108, 0.3);
  }
  .an__flare {
    position: absolute;
    left: 8%;
    top: 8%;
    width: 50%;
    height: 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0));
  }
  .an__arch-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 28%;
    background: #362dff;
  }
  .an__bars {
    position: absolute;
    left: 56px;
    right: 56px;
    bottom: 96px;
    height: 300px;
    display: flex;
    align-items: flex-end;
    gap: 18px;
    border-bottom: 3px solid #32e0c4;
  }
  .an__bars span {
    flex: 1;
    border-radius: 10px 10px 0 0;
  }
  .an__trend {
    position: absolute;
    left: 56px;
    bottom: 120px;
    max-width: calc(100% - 112px);
    height: auto;
  }
  .an__sweep-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .an__sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 35%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0));
  }
  .an__mock {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 220px;
    height: 360px;
    padding: 22px 16px;
    border-radius: 34px 34px 0 0;
    border: 10px solid #05006c;
    border-bottom: none;
    background: #fff;
    box-shadow: 0 20px 50px rgba(5, 0, 108, 0.3);
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .an__mock-title {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 14px;
    color: #05006c;
  }
  .an__mock-title + .an__mock-bars + .an__mock-title {
    margin-top: 6px;
  }
  .an__mock-bars {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }
  .an__mock-bars span {
    height: 12px;
    border-radius: 6px;
  }
  .an__heat {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 4px;
  }
  .an__heat span {
    aspect-ratio: 1;
    border-radius: 4px;
  }
  .an__sticker {
    position: absolute;
    top: 40px;
    right: 0;
    padding: 12px 18px;
    border-radius: 999px;
    background: #ffd458;
    color: #05006c;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    transform: rotate(3deg);
    box-shadow: 0 10px 30px rgba(5, 0, 108, 0.2);
  }

  /* Why ADC */
  .an__why {
    padding-top: 120px;
    padding-bottom: 120px;
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
  }
  .an__why-head {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .an__bar {
    width: 96px;
    height: 12px;
    margin-top: 12px;
    border-radius: 6px;
    background: #32e0c4;
  }
  .an__why-list {
    flex: 999 1 560px;
    min-width: 0;
    list-style: none;
    padding: 0;
