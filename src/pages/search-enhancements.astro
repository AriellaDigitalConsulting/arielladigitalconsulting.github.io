---
import Base from '../layouts/Base.astro';
---

<Base title="Search Integrations — ADC" description="Coveo and Algolia search enhancements for LumApps, by ADC.">
  <section class="hero">
    <div class="hero__media"><img src="/images/63285b4fabfc.webp" alt="" /></div>
    <div class="hero__overlay"></div>
    <div class="wrap">
      <div class="hero__inner">
        <p class="eyebrow" style="color: var(--lime)">In partnership with Coveo</p>
        <h1>Search Integrations</h1>
        <p>
          As a proud partner of Coveo, we are excited to bring more solutions to the table to enrich our
          customers' search experience journey with their enterprise search engine of choice.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="back"><a href="/products">← Back to Products</a></p>
      <div class="grid grid--2">
        <a class="card" href="/coveo-integrations">
          <h3>Coveo Enhancements</h3>
          <p style="color:var(--muted)">
            The Coveo search enhancement products we've developed make it on par with enterprise expectations
            to customize the global search page experience.
          </p>
          <span class="more">Learn More →</span>
        </a>
        <div class="card" style="opacity:.78">
          <h3>Algolia Connector</h3>
          <p style="color:var(--muted)">
            The Algolia LumApps search connector was developed to help EMEA customers using Algolia connect
            their search engine to LumApps.
          </p>
          <span class="more" style="color:var(--muted)">Coming soon</span>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .back { font-size: 0.9rem; margin-bottom: 2rem; }
  .back a { text-decoration: none; }
</style>
