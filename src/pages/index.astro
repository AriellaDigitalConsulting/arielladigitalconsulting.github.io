---
import Base from '../layouts/Base.astro';
import { img } from '../lib/img';
import { nav, social } from '../data/site';

const docsUrl = 'https://docs.adc.dev';
const contactHref = '/contact';
const navLinks = nav.filter((item) => item.href !== contactHref);

const certifications = [
  'Trusted Partner — Consulting, Training &amp; Design',
  'Agent Hub Deployment',
  'MicroApps',
  'Implementation &amp; Technology Partner',
];

const services = [
  {
    title: 'Implementation',
    href: '/implementations',
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>',
    tint: '#362dff',
    stroke: '#fff',
    body: 'Launch or relaunch LumApps with the right content strategy, governance and information architecture.',
    tags: ['Governance', 'Info architecture', 'Jive &amp; SharePoint migrations'],
  },
  {
    title: 'Integrations &amp; Widgets',
    href: '/products',
    icon: '<path d="M9 7H6a4 4 0 000 8h3M15 7h3a4 4 0 010 8h-3M8 11h8"></path>',
    tint: '#32e0c4',
    stroke: '#05006c',
    body: 'Custom widgets, APIs and real-time integrations that connect LumApps to the tools your people already use.',
    tags: ['Custom widgets', 'Gamification', 'Data visualization'],
  },
  {
    title: 'Expert Support',
    href: '/services',
    icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
    tint: '#ffd458',
    stroke: '#05006c',
    body: 'On-call LumApps expertise: health checks, site audits and enablement training for your core team.',
    tags: ['Health checks', 'Training', 'Ad hoc support'],
  },
  {
    title: 'UI/UX Design',
    href: '/design',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M9 9v11"></path>',
    tint: '#05006c',
    stroke: '#fff',
    body: 'Portal designs and redesigns, from low-fidelity wireframes to custom CSS that fits your brand.',
    tags: ['Redesigns', 'Mockups', 'Custom CSS'],
  },
];

const widgetTags = {
  Engagement: 'tag--teal',
  Accessibility: 'tag--yellow',
  Content: 'tag--blue',
  Admin: 'tag--blue',
};

const widgets: { tag: keyof typeof widgetTags; title: string; href: string; body: string }[] = [
  { tag: 'Engagement', title: 'Guess Word', href: '/guess-word-widget', body: 'A daily word game that brings people back to the homepage.' },
  { tag: 'Engagement', title: 'Soccer Predictions', href: '/soccer', body: 'Team leaderboards around the tournaments your company sponsors.' },
  { tag: 'Accessibility', title: 'Page Reader (Text-to-speech)', href: '/page-reader', body: 'Read any page aloud, helping you meet accessibility goals.' },
  { tag: 'Content', title: 'Organization Chart', href: '/org-chart', body: 'Build a dynamic organization chart and add it to any page.' },
  { tag: 'Content', title: 'Advanced Table of Contents', href: '/table-of-contents', body: 'Auto-built navigation for long pages and knowledge articles.' },
  { tag: 'Admin', title: 'Content Page Layout Mover', href: '/metadata-mover', body: 'Copy page layouts between content in seconds, not hours.' },
];

const steps = [
  { color: '#362dff', num: '#362dff', title: 'Align on vision &amp; goals', body: "A strategy with your organization's vision at the forefront." },
  { color: '#32e0c4', num: '#0a6b5c', title: 'Define measurable success', body: 'KPIs, gaps and adoption opportunities, identified up front.' },
  { color: '#ffd458', num: '#8a6500', title: 'Deliver a rich and unified experience', body: 'Enablement for day-to-day operations and the long term.' },
  { color: '#362dff', num: '#362dff', title: 'Empower your core team', body: 'Enablement for day-to-day operations and the long term.' },
  { color: '#05006c', num: '#05006c', title: 'Keep evolving', body: 'New use cases and improvements as your workplace grows.' },
];

const testimonials = [
  {
    mark: '#ffd458',
    initials: 'PM',
    avatar: 'avatar--blue',
    name: 'PJ Marcello',
    role: 'Corporate Intranet Manager',
    quote: '“ADC has helped us with custom designs on a complete company rebrand, created custom widgets to improve user experience, and engaged on several large strategic projects. I cannot recommend ADC enough to anyone who wants to level up the LumApps experience.”',
  },
  {
    mark: '#32e0c4',
    initials: 'PS',
    avatar: 'avatar--teal',
    name: 'Paul Stubitsch',
    role: 'Chief Information Officer',
    quote: '“AWESOME is the best way to describe our relationship with Misha. Having him onsite was a game-changer. He is smart and savvy, but also patient in guiding our team.”',
  },
  {
    mark: '#ffd458',
    initials: 'SY',
    avatar: 'avatar--yellow',
    name: 'Sean Young',
    role: 'Director of Technology',
    quote: '“We take great pride in the quality partnerships our brand has established with the various technology companies with whom we work. Our relationship with ADC is a prime example of this. I would highly recommend ADC to anyone wishing to fully leverage their experience with LumApps. I can confidently assure you that you will not be disappointed!”',
  },
];

const footerCols = [
  {
    heading: 'Company',
    links: [
      { href: '/', label: 'Home' },
      { href: '/about', label: 'About' },
      { href: '/news', label: 'News' },
      { href: '#process', label: 'Process' },
      { href: '#clients', label: 'Clients' },
    ],
  },
  {
    heading: 'Services',
    links: [
      { href: '/implementations', label: 'Implementation' },
      { href: '/products', label: 'Integrations' },
      { href: '/analytics', label: 'Analytics' },
      { href: '/design', label: 'UI/UX Design' },
      { href: '#widgets', label: 'Widgets' },
    ],
  },
  {
    heading: 'Resources',
    links: [
      { href: docsUrl, label: 'Widget docs' },
      { href: '/products', label: 'Products' },
      { href: contactHref, label: 'Contact' },
    ],
  },
];

const year = new Date().getFullYear();
const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const shield = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#362DFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>';
---

<Base title="LumApps Partner | Ariella Digital Consulting | ADC" bare>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </Fragment>

  <header class="mh" slot="header">
    <div class="mh__inner">
      <a class="mh__brand" href="/" aria-label="Ariella Digital Consulting home">
        <svg width="30" height="29" viewBox="0 0 22 21" fill="none" aria-hidden="true"><path d="M3.26367 4.50242H6.73663C6.73663 4.50242 6.34303 2.79392 8.93617 2.81733C8.93617 2.81733 11.3557 2.46626 10.9736 5.91836V20.3704H14.6666V4.17476C14.5796 2.0901 12.9923 0.385859 10.9389 0.172667C10.9389 0.172667 3.04371 -1.32519 3.26367 4.50242Z" fill="#32E0C4"></path><path d="M4.46209 20.3658V16.907C4.46209 16.907 2.79204 17.3105 2.81507 14.7163C2.81507 14.7163 2.46954 12.3067 5.85571 12.6987H14.6667V8.96309H4.05897C4.05897 8.96309 0.91467 8.87085 0.131475 12.6641C0.177545 12.6641 -1.27367 20.5849 4.46209 20.3658Z" fill="#362DFF"></path><rect x="4.07397" y="20.3706" width="3.25926" height="10.5926" transform="rotate(-90 4.07397 20.3706)" fill="#362DFF"></rect><rect x="10.5925" y="20.3706" width="3.25926" height="11.4074" transform="rotate(-90 10.5925 20.3706)" fill="#FFD458"></rect><path d="M21.9999 8.96289H10.5925V12.2221H21.0047C21.3361 12.2028 21.6686 12.2028 21.9999 12.2221V8.96289Z" fill="#FFD458"></path><rect x="10.5925" y="8.96289" width="4.07407" height="11.4074" fill="#362DFF"></rect></svg>
        <span>riella Digital Consulting</span>
      </a>
      <button class="mh__toggle" aria-expanded="false" aria-controls="mh-nav" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <nav class="mh__nav" id="mh-nav" aria-label="Primary" data-open="false">
        {navLinks.map((item) => <a class="mh__link" href={item.href} aria-current={item.href === '/' ? 'page' : undefined}>{item.label}</a>)}
        <a class="ui-btn ui-btn-primary mh__cta" href={contactHref}>Book a call</a>
      </nav>
    </div>
  </header>

  <div class="home">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__ring" aria-hidden="true"></div>
      <div class="container hero__inner">
        <div class="hero__copy">
          <div class="pill"><span class="dot" aria-hidden="true"></span>Certified LumApps Implementation &amp; Technology Partner</div>
          <h1>Making LumApps a <span class="teal">simpler</span>, <span class="yellow">happier</span> experience.</h1>
          <p class="hero__lede">Boutique consulting for enterprise intranets. We implement, extend and design LumApps so your people actually use it — and your team can run it with confidence.</p>
          <div class="actions">
            <a class="ui-btn ui-btn-primary ui-btn--lg" href={contactHref}>Book a discovery call <Fragment set:html={arrow} /></a>
            <a class="ui-btn ui-btn-ghost ui-btn--lg" href="#widgets">Explore our widgets</a>
          </div>
          <div class="hero__stats">
            <div><strong>Since 2017</strong>in the LumApps ecosystem</div>
            <span class="hero__divider" aria-hidden="true"></span>
            <div><strong>US &amp; EMEA</strong>enterprise clients</div>
          </div>
        </div>

        <div class="hero__visual" role="img" aria-label="Examples of ADC widgets running in LumApps">
          <div class="mock mock--word">
            <div class="mock__head">
              <span class="mock__title">Guess Word</span>
              <span class="mock__badge">Daily game</span>
            </div>
            <div class="word-grid" aria-hidden="true">
              {['T', 'E', 'A', 'M', 'S'].map((l, i) => <div class={i === 1 ? 'tile tile--yellow' : i === 3 ? 'tile tile--teal' : 'tile'}>{l}</div>)}
              {['S', 'M', 'I', 'L', 'E'].map((l) => <div class="tile tile--teal">{l}</div>)}
              {[0, 1, 2, 3, 4].map(() => <div class="tile tile--empty">·</div>)}
            </div>
            <div class="mock__note">Solved in 2 — share your streak with the team</div>
          </div>
          <div class="hero__stack">
            <div class="mock">
              <div class="mock__head">
                <span class="mock__title">Match Predictions</span>
                <span class="dot dot--lg" aria-hidden="true"></span>
              </div>
              <div class="score"><span>Team A</span><b>2 – 1</b><span>Team B</span></div>
              <div class="board">
                <div class="board__row"><span>1. Marketing</span><span>Leaderboard</span></div>
                <div class="bar"><div style="width:78%"></div></div>
              </div>
            </div>
            <div class="mock mock--reader">
              <span class="play"><svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg></span>
              <div class="reader">
                <span class="mock__title">Page Reader</span>
                <div class="wave" aria-hidden="true">
                  {[6, 12, 16, 9, 14, 7, 12].map((h) => <span style={`height:${h}px`}></span>)}
                  {[5, 10, 6].map((h) => <span class="dim" style={`height:${h}px`}></span>)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CREDENTIALS -->
    <section class="creds" aria-label="Certifications">
      <div class="container creds__inner">
        <span class="creds__label">LumApps certified</span>
        {certifications.map((c) => <span class="creds__item"><Fragment set:html={shield} /><Fragment set:html={c} /></span>)}
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="container section">
      <div class="section__head section__head--split">
        <div class="section__intro">
          <span class="eyebrow">What we do</span>
          <h2>Everything your LumApps platform needs, from one expert team.</h2>
        </div>
        <a class="ui-btn ui-btn-outline" href="/services">See all services</a>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <a class="card" href={s.href}>
              <span class="card__icon" style={`background:${s.tint}`}>
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke={s.stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
              </span>
              <h3 set:html={s.title} />
              <p>{s.body}</p>
              <div class="chips">
                {s.tags.map((t) => <span set:html={t} />)}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- WIDGETS -->
    <section id="widgets" class="soft-band">
      <div class="container widgets">
        <div class="widgets__intro">
          <span class="eyebrow">ADC widget library</span>
          <h2>Ready-made widgets that make your intranet a place people want to visit.</h2>
          <p>Built by us, for LumApps. Install them, configure them, and give employees a reason to come back every day.</p>
          <div class="actions">
            <a class="ui-btn ui-btn-primary" href={docsUrl}>Browse the docs</a>
            <a class="ui-btn ui-btn-outline" href="/products">See all products</a>
          </div>
        </div>
        <div class="widgets__grid">
          {
            widgets.map((w) => (
              <a class="widget" href={w.href}>
                <span class:list={['tag', widgetTags[w.tag]]}>{w.tag}</span>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- PROCESS -->
    <section id="process" class="container section">
      <div class="section__intro">
        <span class="eyebrow">How we work</span>
        <h2>A clear path from strategy to a self-sufficient team.</h2>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li style={`border-top-color:${s.color}`}>
              <span class="steps__num" style={`color:${s.num}`}>{String(i + 1).padStart(2, '0')}</span>
              <h3 set:html={s.title} />
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <!-- TESTIMONIALS -->
    <section id="clients" class="dark">
      <div class="container section">
        <div class="section__intro">
          <span class="eyebrow eyebrow--teal">Client stories</span>
          <h2>Teams that level up their LumApps experience.</h2>
        </div>
        <div class="quotes">
          {
            testimonials.map((t) => (
              <figure class="quote">
                <svg width="34" height="28" viewBox="0 0 34 28" fill={t.mark} aria-hidden="true"><path d="M0 28V16C0 6 5 1 14 0v6c-4 1-6 4-6 8h6v14zM20 28V16c0-10 5-15 14-16v6c-4 1-6 4-6 8h6v14z" /></svg>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <span class:list={['avatar', t.avatar]} aria-hidden="true">{t.initials}</span>
                  <span class="who"><strong>{t.name}</strong><span>{t.role}</span></span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ABOUT -->
    <section id="about" class="container about">
      <img class="about__photo" src={img('79b064_8dd843abbc7f4a068fafa61f8f8e92ae~mv2.jpg')} alt="Misha Zubarev, founder of Ariella Digital Consulting" loading="lazy" />
      <div class="about__copy">
        <span class="eyebrow">About ADC</span>
        <h2>LumApps experts since the very beginning.</h2>
        <p>Our founder was the first LumApps deployment consultant onboarded in the US, back in 2017. Today our boutique practice partners with LumApps to enhance, extend and deliver the digital workplace for enterprises across the US and EMEA — so every rollout drives continuous growth, adoption and evolution.</p>
        <div class="actions">
          <a class="ui-btn ui-btn-outline" href="/about">Meet the team</a>
          <a class="text-link" href="/news">Latest news <Fragment set:html={arrow} /></a>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="contact" class="container cta-wrap">
      <div class="cta">
        <div class="cta__pills" aria-hidden="true"><span></span><span></span></div>
        <div class="cta__copy">
          <h2>Ready to make your intranet simpler and happier?</h2>
          <p>Tell us where you are with LumApps. We'll show you where it can go.</p>
        </div>
        <a class="ui-btn ui-btn-white ui-btn--lg" href={contactHref}>Book a discovery call <Fragment set:html={arrow} /></a>
      </div>
    </section>
  </div>

  <footer class="mf" slot="footer">
    <div class="container mf__inner">
      <div class="mf__top">
        <div class="mf__brand">
          <span class="mf__logo"><img src="/images/4dc6ed0bf872.webp" alt="" width="36" height="35" /><span>Ariella Digital Consulting</span></span>
          <span>Making LumApps a simpler, happier experience.</span>
        </div>
        <div class="mf__cols">
          {
            footerCols.map((col) => (
              <div class="mf__col">
                <span class="mf__heading">{col.heading}</span>
                {col.links.map((l) => <a href={l.href}>{l.label}</a>)}
              </div>
            ))
          }
          <div class="mf__col">
            <span class="mf__heading">Connect</span>
            {social.map((s) => <a href={s.href}>{s.label}</a>)}
          </div>
        </div>
      </div>
      <div class="mf__bottom">
        <span>© {year} Ariella Digital Consulting, LLC</span>
        <span>Certified LumApps Partner</span>
      </div>
    </div>
  </footer>
</Base>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.mh__toggle');
  const menu = document.querySelector<HTMLElement>('.mh__nav');
  toggle?.addEventListener('click', () => {
    const open = menu?.dataset.open === 'true';
    if (menu) menu.dataset.open = String(!open);
    toggle.setAttribute('aria-expanded', String(!open));
  });
</script>

<style>
  .mh,
  .home,
  .mf {
    --navy: #05006c;
    --blue: #362dff;
    --blue-hover: #2a22d6;
    --teal: #32e0c4;
    --yellow: #ffd458;
    --text: #1b1a3a;
    --muted: #4a4870;
    --line: #ecebf7;
    --tint: #f1f0ff;
    --soft: #f7f7fc;
    --f-display: 'Archivo', sans-serif;
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: var(--text);
    line-height: 1.5;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .home h1,
  .home h2,
  .home h3 {
    font-family: var(--f-display);
    color: var(--navy);
  }

  /* ---------- buttons ---------- */
  .ui-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 12px 22px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .ui-btn--lg {
    padding: 15px 26px;
    font-size: 16px;
  }
  .ui-btn-primary {
    background: var(--blue);
    color: #fff;
  }
  .ui-btn-primary:hover {
    background: var(--blue-hover);
    color: #fff;
  }
  .ui-btn-ghost {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .ui-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .ui-btn-outline {
    color: var(--blue);
    border: 1.5px solid var(--blue);
  }
  .ui-btn-outline:hover {
    background: var(--tint);
  }
  .ui-btn-white {
    position: relative;
    background: #fff;
    color: var(--navy);
    font-weight: 700;
    padding: 16px 28px;
  }
  .ui-btn-white:hover {
    background: var(--tint);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--blue);
    font-weight: 600;
    text-decoration: none;
  }
  .text-link:hover {
    color: var(--navy);
  }

  /* ---------- header ---------- */
  .mh {
    background: #fff;
    border-bottom: 1px solid var(--line);
    position: relative;
    z-index: 10;
  }
  .mh__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 18px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .mh__brand {
    display: flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    color: var(--navy);
    font-family: var(--f-display);
    font-weight: 500;
    font-size: 20px;
    letter-spacing: -0.2px;
  }
  .mh__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    font-weight: 600;
  }
  .mh__link {
    color: var(--navy);
    text-decoration: none;
  }
  .mh__link:hover,
  .mh__link[aria-current='page'] {
    color: var(--blue);
  }
  .mh__cta {
    padding: 12px 20px;
  }
  .mh__toggle {
    display: none;
    width: 44px;
    height: 44px;
    padding: 12px 10px;
    border: 0;
    background: none;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }
  .mh__toggle span {
    display: block;
    height: 2px;
    background: var(--navy);
    border-radius: 2px;
  }

  /* ---------- hero ---------- */
  .hero {
    background: var(--navy);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .hero__ring {
    position: absolute;
    right: -120px;
    top: -160px;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    border: 80px solid rgba(54, 45, 255, 0.35);
  }
  .hero__inner {
    position: relative;
    padding-top: 96px;
    padding-bottom: 104px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }
  .hero__copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pill {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
