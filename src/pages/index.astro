---
import Base from '../layouts/Base.astro';
import Insights from '../components/Insights.astro';
import { contactHref } from '../data/site';

const docsUrl = 'https://docs.adc.dev';

const badges = [
  { src: '/images/badges/agent-hub.webp', alt: 'LumApps Partner Program: Agent Hub Certification' },
  { src: '/images/badges/trusted-partner.webp', alt: 'LumApps Partner Program: Trusted Partner, Consulting, Training & Design' },
  { src: '/images/badges/authorized-partner.webp', alt: 'LumApps Partner Program: Authorized Partner, Technical Implementation' },
];

const certifications = [
  'Trusted Partner — Consulting, Training &amp; Design',
  'Agent Hub Deployment',
  'MicroApps',
  'Implementation &amp; Technology Partner',
];

const services = [
  {
    title: 'Implementations',
    href: '/implementations',
    icon: '<path d="M4 20V10M10 20V4M16 20v-7M22 20H2"></path>',
    tint: '#362dff',
    stroke: '#fff',
    body: 'Launch or relaunch LumApps with the right content strategy, governance and information architecture.',
    tags: ['Content Strategy', 'Governance', 'UI/UX Design', 'Migrations', 'Change Management'],
  },
  {
    title: 'Integrations &amp; Widgets',
    href: '/products',
    icon: '<path d="M9 7H6a4 4 0 000 8h3M15 7h3a4 4 0 010 8h-3M8 11h8"></path>',
    tint: '#32e0c4',
    stroke: '#05006c',
    body: 'Custom widgets, APIs and real-time integrations that connect LumApps to the tools your people already use.',
    tags: ['Custom widgets', 'Gamification', 'Data visualization'],
  },
  {
    title: 'UI/UX Design',
    href: '/design',
    icon: '<rect x="3" y="4" width="18" height="16" rx="2"></rect><path d="M3 9h18M9 9v11"></path>',
    tint: '#05006c',
    stroke: '#fff',
    body: 'Portal designs and redesigns, from low-fidelity wireframes to custom CSS that fits your brand.',
    tags: ['Redesigns', 'Mockups', 'Custom CSS'],
  },
  {
    title: 'SME Support',
    href: '/sme-support',
    icon: '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path>',
    tint: '#ffd458',
    stroke: '#05006c',
    body: 'On-call LumApps expertise: health checks, site audits and enablement training for your core team.',
    tags: ['Health checks', 'Training', 'Ad hoc support'],
  },
];

const widgetTags = {
  Engagement: 'tag--teal',
  Accessibility: 'tag--yellow',
  Content: 'tag--blue',
  Admin: 'tag--blue',
};

const widgets: { tag: keyof typeof widgetTags; title: string; href: string; body: string }[] = [
  { tag: 'Engagement', title: 'Guess Word', href: '/guess-word-widget', body: 'A daily word game that brings people back to the homepage.' },
  { tag: 'Engagement', title: 'Soccer Predictions', href: '/soccer', body: 'Team leaderboards around the tournaments your company sponsors.' },
  { tag: 'Accessibility', title: 'Page Reader (Text-to-speech)', href: '/page-reader', body: 'Read any page aloud, helping you meet accessibility goals.' },
  { tag: 'Content', title: 'Organization Chart', href: '/org-chart', body: 'Build a dynamic organization chart and add it to any page.' },
  { tag: 'Content', title: 'Advanced Table of Contents', href: '/table-of-contents', body: 'Auto-built navigation for long pages and knowledge articles.' },
  { tag: 'Admin', title: 'Content Page Layout Mover', href: '/content-layout-mover', body: 'Copy page layouts between content in seconds, not hours.' },
];

const testimonials = [
  {
    mark: '#ffd458',
    initials: 'PM',
    avatar: 'avatar--blue',
    name: 'PJ Marcello',
    role: 'Corporate Intranet Manager',
    quote: '“ADC has helped us with custom designs on a complete company rebrand, created custom widgets to improve user experience, and engaged on several large strategic projects. I cannot recommend ADC enough to anyone who wants to level up the LumApps experience.”',
  },
  {
    mark: '#32e0c4',
    initials: 'PS',
    avatar: 'avatar--teal',
    name: 'Paul Stubitsch',
    role: 'Chief Information Officer',
    quote: '“AWESOME is the best way to describe our relationship with Misha. Having him onsite was a game-changer. He is smart and savvy, but also patient in guiding our team.”',
  },
  {
    mark: '#ffd458',
    initials: 'SY',
    avatar: 'avatar--yellow',
    name: 'Sean Young',
    role: 'Director of Technology',
    quote: '“We take great pride in the quality partnerships our brand has established with the various technology companies with whom we work. Our relationship with ADC is a prime example of this. I would highly recommend ADC to anyone wishing to fully leverage their experience with LumApps. I can confidently assure you that you will not be disappointed!”',
  },
];

const arrow = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>';
const shield = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#362DFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"></path><path d="M9 12l2 2 4-4"></path></svg>';
---

<Base title="LumApps Partner | Ariella Digital Consulting | ADC">
  <div class="home">
    <!-- HERO -->
    <section class="hero">
      <div class="hero__ring" aria-hidden="true"></div>
      <div class="container hero__inner">
        <div class="hero__copy">
          <div class="pill"><span class="dot" aria-hidden="true"></span>Working with a team you can trust</div>
          <h1>Making LumApps a <span class="teal">simpler</span>, <span class="yellow">happier</span> experience.</h1>
          <p class="hero__lede">Boutique consulting for the enterprise. We do end-to-end implementations, design, and extend LumApps for your workforce — and your team can run it with confidence.</p>
          <div class="actions">
            <a class="ui-btn ui-btn-primary ui-btn--lg" href={contactHref}>Book a discovery call <Fragment set:html={arrow} /></a>
            <a class="ui-btn ui-btn-ghost ui-btn--lg" href="#widgets">Explore our widgets</a>
          </div>
          <div class="hero__stats">
            <div><strong>Since 2017</strong>in the LumApps ecosystem</div>
            <span class="hero__divider" aria-hidden="true"></span>
            <div><strong>US &amp; EMEA</strong>enterprise clients</div>
          </div>
        </div>

        <div class="hero__visual" role="img" aria-label="Examples of ADC widgets running in LumApps">
          <div class="mock mock--word">
            <div class="mock__head">
              <span class="mock__title">Guess Word</span>
              <span class="mock__badge">Daily game</span>
            </div>
            <div class="word-grid" aria-hidden="true">
              {['T', 'E', 'A', 'M', 'S'].map((l, i) => <div class={i === 1 ? 'tile tile--yellow' : i === 3 ? 'tile tile--teal' : 'tile'}>{l}</div>)}
              {['S', 'M', 'I', 'L', 'E'].map((l) => <div class="tile tile--teal">{l}</div>)}
              {[0, 1, 2, 3, 4].map(() => <div class="tile tile--empty">·</div>)}
            </div>
            <div class="mock__note">Solved in 2 — share your streak with the team</div>
          </div>
          <div class="hero__stack">
            <div class="mock">
              <div class="mock__head">
                <span class="mock__title">Match Predictions</span>
                <span class="dot dot--lg" aria-hidden="true"></span>
              </div>
              <div class="score"><span>Team A</span><b>2 – 1</b><span>Team B</span></div>
              <div class="board">
                <div class="board__row"><span>1. Marketing</span><span>Leaderboard</span></div>
                <div class="bar"><div style="width:78%"></div></div>
              </div>
            </div>
            <div class="mock mock--reader">
              <span class="play"><svg width="16" height="16" viewBox="0 0 24 24" fill="#fff" aria-hidden="true"><path d="M7 4l13 8-13 8z"></path></svg></span>
              <div class="reader">
                <span class="mock__title">Page Reader</span>
                <div class="wave" aria-hidden="true">
                  {[6, 12, 16, 9, 14, 7, 12].map((h) => <span style={`height:${h}px`}></span>)}
                  {[5, 10, 6].map((h) => <span class="dim" style={`height:${h}px`}></span>)}
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- CREDENTIALS -->
    <section class="creds" aria-label="Certifications">
      <figure class="container badges">
        <ul class="badges__list">
          {badges.map((b) => <li><img src={b.src} alt={b.alt} width="160" height="159" loading="lazy" /></li>)}
        </ul>
        <figcaption>A fully certified LumApps partner</figcaption>
      </figure>
      <div class="container creds__inner">
        <span class="creds__label">LumApps certified</span>
        {certifications.map((c) => <span class="creds__item"><Fragment set:html={shield} /><Fragment set:html={c} /></span>)}
      </div>
    </section>

    <!-- SERVICES -->
    <section id="services" class="container section">
      <div class="section__intro">
        <span class="eyebrow">What we do</span>
        <h2>Everything your LumApps platform needs, from one expert team.</h2>
      </div>
      <div class="services">
        {
          services.map((s) => (
            <a class="card" href={s.href}>
              <span class="card__icon" style={`background:${s.tint}`}>
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke={s.stroke} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon} />
              </span>
              <h3 set:html={s.title} />
              <p>{s.body}</p>
              <div class="chips">
                {s.tags.map((t) => <span set:html={t} />)}
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <!-- WIDGETS -->
    <section id="widgets" class="soft-band">
      <div class="container widgets">
        <div class="widgets__intro">
          <span class="eyebrow">ADC widget library</span>
          <h2>Ready-made widgets that make your intranet a place people want to visit.</h2>
          <p>Built by us, for LumApps. Install them, configure them, and give employees a reason to come back every day.</p>
          <div class="actions">
            <a class="ui-btn ui-btn-primary" href={docsUrl}>Browse the docs</a>
            <a class="ui-btn ui-btn-outline" href="/products">See all products</a>
          </div>
        </div>
        <div class="widgets__grid">
          {
            widgets.map((w) => (
              <a class="widget" href={w.href}>
                <span class:list={['tag', widgetTags[w.tag]]}>{w.tag}</span>
                <h3>{w.title}</h3>
                <p>{w.body}</p>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS -->
    <section id="clients" class="dark">
      <div class="container section">
        <div class="section__intro">
          <span class="eyebrow eyebrow--teal">Client stories</span>
          <h2>Teams that level up their LumApps experience.</h2>
        </div>
        <div class="quotes">
          {
            testimonials.map((t) => (
              <figure class="quote">
                <svg width="34" height="28" viewBox="0 0 34 28" fill={t.mark} aria-hidden="true"><path d="M0 28V16C0 6 5 1 14 0v6c-4 1-6 4-6 8h6v14zM20 28V16c0-10 5-15 14-16v6c-4 1-6 4-6 8h6v14z" /></svg>
                <blockquote>{t.quote}</blockquote>
                <figcaption>
                  <span class:list={['avatar', t.avatar]} aria-hidden="true">{t.initials}</span>
                  <span class="who"><strong>{t.name}</strong><span>{t.role}</span></span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <Insights />

    <!-- CTA -->
    <section id="contact" class="container cta-wrap">
      <div class="cta">
        <div class="cta__pills" aria-hidden="true"><span></span><span></span></div>
        <div class="cta__copy">
          <h2>Ready to make your intranet simpler and happier?</h2>
          <p>Tell us where you are with LumApps. We'll show you where it can go.</p>
        </div>
        <a class="ui-btn ui-btn-white ui-btn--lg" href={contactHref}>Book a discovery call <Fragment set:html={arrow} /></a>
      </div>
    </section>
  </div>
</Base>

<style>
  .home {
    --navy: #05006c;
    --blue: #362dff;
    --blue-hover: #2a22d6;
    --teal: #32e0c4;
    --yellow: #ffd458;
    --text: #1b1a3a;
    --muted: #4a4870;
    --line: #ecebf7;
    --tint: #f1f0ff;
    --soft: #f7f7fc;
    --f-display: 'Archivo', sans-serif;
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: var(--text);
    line-height: 1.5;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .home h1,
  .home h2,
  .home h3 {
    font-family: var(--f-display);
    color: var(--navy);
  }

  /* ---------- buttons ---------- */
  .ui-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 12px 22px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.2;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }
  .ui-btn--lg {
    padding: 15px 26px;
    font-size: 16px;
  }
  .ui-btn-primary {
    background: var(--blue);
    color: #fff;
  }
  .ui-btn-primary:hover {
    background: var(--blue-hover);
    color: #fff;
  }
  .ui-btn-ghost {
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .ui-btn-ghost:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  .ui-btn-outline {
    color: var(--blue);
    border: 1.5px solid var(--blue);
  }
  .ui-btn-outline:hover {
    background: var(--tint);
  }
  .ui-btn-white {
    position: relative;
    background: #fff;
    color: var(--navy);
    font-weight: 700;
    padding: 16px 28px;
  }
  .ui-btn-white:hover {
    background: var(--tint);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  /* ---------- hero ---------- */
  .hero {
    background: var(--navy);
    color: #fff;
    position: relative;
    overflow: hidden;
  }
  .hero__ring {
    position: absolute;
    right: -120px;
    top: -160px;
    width: 560px;
    height: 560px;
    border-radius: 50%;
    border: 80px solid rgba(54, 45, 255, 0.35);
  }
  .hero__inner {
    position: relative;
    padding-top: 96px;
    padding-bottom: 104px;
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }
  .hero__copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .pill {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.18);
    font-size: 14px;
    font-weight: 600;
    color: #e6e5ff;
  }
  .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 50%;
    background: var(--teal);
  }
  .dot--lg {
    width: 10px;
    height: 10px;
  }
  .home .hero h1 {
    margin: 0;
    color: #fff;
    font-weight: 800;
    font-size: clamp(40px, 5.4vw, 68px);
    line-height: 1.03;
    letter-spacing: -1.5px;
  }
  .teal {
    color: var(--teal);
  }
  .yellow {
    color: var(--yellow);
  }
  .hero__lede {
    font-size: 19px;
    line-height: 1.6;
    color: #d4d2f5;
    max-width: 540px;
  }
  .hero .actions {
    padding-top: 4px;
  }
  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    padding-top: 12px;
    font-size: 14px;
    color: #c9c7f2;
  }
  .hero__stats div {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .hero__stats strong {
    font-family: var(--f-display);
    font-size: 26px;
    font-weight: 700;
    color: #fff;
  }
  .hero__divider {
    width: 1px;
    background: rgba(255, 255, 255, 0.2);
  }
  .hero__visual {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .hero__stack {
    flex: 1 1 200px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .mock {
    background: #fff;
    color: var(--navy);
    border-radius: 20px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.25);
  }
  .mock--word {
    flex: 1 1 220px;
    padding: 22px;
    gap: 14px;
  }
  .mock__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .mock__title {
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 16px;
  }
  .mock__badge {
    font-size: 12px;
    font-weight: 600;
    color: #4a47a3;
    background: var(--tint);
    padding: 4px 10px;
    border-radius: 999px;
  }
  .mock__note {
    font-size: 13px;
    color: var(--muted);
  }
  .word-grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 18px;
    text-align: center;
  }
  .tile {
    background: #ededf5;
    border-radius: 8px;
    padding: 9px 0;
  }
  .tile--yellow {
    background: var(--yellow);
  }
  .tile--teal {
    background: var(--teal);
  }
  .tile--empty {
    background: none;
    border: 2px solid #e2e1f0;
    padding: 7px 0;
    color: transparent;
  }
  .score {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--soft);
    border-radius: 12px;
    padding: 12px 14px;
    font-family: var(--f-display);
    font-weight: 700;
    font-size: 14px;
  }
  .score b {
    font-size: 20px;
    color: var(--blue);
  }
  .board {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
  }
  .board__row {
    display: flex;
    justify-content: space-between;
  }
  .board__row span:last-child {
    font-weight: 600;
  }
  .bar {
    height: 6px;
    border-radius: 6px;
    background: #ededf5;
  }
  .bar div {
    height: 6px;
    border-radius: 6px;
    background: var(--blue);
  }
  .mock--reader {
    background: var(--yellow);
    padding: 16px 18px;
    flex-direction: row;
    align-items: center;
    gap: 14px;
  }
  .play {
    width: 40px;
    height: 40px;
    flex: none;
    border-radius: 50%;
    background: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .reader {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }
  .reader .mock__title {
    font-size: 15px;
  }
  .wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 16px;
  }
  .wave span {
    width: 3px;
    background: var(--navy);
    border-radius: 2px;
  }
  .wave .dim {
    background: rgba(5, 0, 108, 0.35);
  }

  /* ---------- credentials ---------- */
  .creds {
    background: var(--soft);
    border-bottom: 1px solid var(--line);
  }
  .badges {
    margin: 0 auto;
    padding-top: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }
  .badges__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 24px 40px;
  }
  .badges__list img {
    display: block;
    width: 160px;
    height: auto;
  }
  .badges figcaption {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: var(--navy);
    text-align: center;
  }
  @media (max-width: 560px) {
    .badges {
      padding-top: 40px;
    }
    .badges__list {
      gap: 12px;
    }
    .badges__list img {
      width: 100px;
    }
    .badges figcaption {
      font-size: 18px;
    }
  }
  .creds__inner {
    padding-top: 28px;
    padding-bottom: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px 32px;
    font-size: 14px;
    font-weight: 600;
    color: #3a3870;
  }
  .creds__label {
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #5a5890;
  }
  .creds__item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ---------- sections ---------- */
  .section {
    padding-top: 112px;
    padding-bottom: 112px;
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  #services {
    padding-bottom: 96px;
    gap: 48px;
  }
  .section__intro {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 720px;
  }
  .eyebrow {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--blue);
  }
  .eyebrow--teal {
    color: var(--teal);
  }
  .home h2 {
    margin: 0;
    font-weight: 800;
    font-size: clamp(32px, 3.8vw, 48px);
    line-height: 1.08;
    letter-spacing: -1px;
  }

  /* ---------- services ---------- */
  .services {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }
  .card {
    text-decoration: none;
    color: inherit;
    border: 1.5px solid var(--line);
    border-radius: 24px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    background: #fff;
