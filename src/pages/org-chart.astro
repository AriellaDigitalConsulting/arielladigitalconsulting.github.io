---
// Org Chart product page in the "Split Editorial" look (Template B), with a white, Contact-style hero
// whose arch holds an illustrated org chart.
import Base from '../layouts/Base.astro';
import { contactHref } from '../data/site';

const docs = 'https://docs.adc.dev/docs';
const video = 'https://www.youtube-nocookie.com/embed/Jk2zubEdtYc';

const why = [
  { title: 'Drag, drop, done', text: 'A simple drag-and-drop solution for team leads and page owners to add an org chart to any LumApps page or Space.' },
  { title: 'Leadership people can see', text: "Improve awareness and add an extra layer of transparency to your team's or department's leadership hierarchy." },
  { title: 'No admin overhead', text: 'Add as many org charts as you need, one per team, department, or function, with little to no admin effort.' },
  { title: 'Native to LumApps', text: "Built on LumApps' out-of-the-box Design System, so it picks up your global styles and stays up to date." },
];
const features = [
  { title: 'From Any Person, Down.', text: 'Displays the organizational chart from the selected user downwards. That simple.' },
  { title: 'Explore Deeper.', text: 'People can go deeper into the chart, just as they would from a LumApps user profile.' },
  { title: 'Any Page or Space.', text: 'Page administrators can add an org chart dynamically to any LumApps page or Space.' },
  { title: 'Two Display Modes.', text: "Choose LumApps' standard mode, or the browse and drag org chart mode." },
];
const steps = [
  { title: 'Add the widget', text: 'Drop Org Chart onto a team site, department page, or Space.' },
  { title: 'Pick the person at the top', text: 'Select a user, choose the behavior, and set how many levels to show.' },
  { title: 'Publish', text: 'Your team sees who leads what, styled like the rest of your platform.' },
];
const value = [
  { icon: 'users', title: 'Onboarding & HR', text: 'Help new joiners learn who is who, and who to ask, from their first week.' },
  { icon: 'megaphone', title: 'Department & Team Pages', text: 'Show each department its own leadership structure right on its home page.' },
  { icon: 'grid', title: 'Reorgs & Announcements', text: 'Pair an announcement with the new structure, so people see the change, not just read about it.' },
];
const related = [
  { href: '/guess-word-widget', icon: 'star', title: 'Guess Word widget.', text: 'The Wordle for enterprise. Get employees engaged by guessing a word tied to a campaign or initiative.' },
  { href: '/advanced-survey', icon: 'sliders', title: 'Advanced Survey.', text: 'Multi-question, multiple-choice, or free-form campaigns, with central governance and native analytics.' },
];

const icons: Record<string, string> = {
  grid: '<path d="M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z"/>',
  sliders: '<path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/>',
  star: '<path d="M12 3l2.6 5.6 6 .9-4.4 4.2 1.1 6L12 16.8 6.7 19.7l1.1-6L3.4 9.5l6-.9z"/>',
  megaphone: '<path d="M3 11v2a1 1 0 0 0 1 1h3l6 4V6L7 10H4a1 1 0 0 0-1 1z"/><path d="M17 8a5 5 0 0 1 0 8"/>',
  users: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
  tree: '<rect x="9" y="2" width="6" height="5" rx="1"/><rect x="2" y="17" width="6" height="5" rx="1"/><rect x="16" y="17" width="6" height="5" rx="1"/><path d="M12 7v5M5 17v-5h14v5"/>',
  play: '<path d="M8 5v14l11-7z"/>',
};
const icon = (key: string, size = 28) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[key]}</svg>`;

const stepStyle = [
  { bg: '#362dff', fg: '#fff', icon: 'grid' },
  { bg: '#32E0C4', fg: '#05006c', icon: 'sliders' },
  { bg: '#FFD458', fg: '#05006c', icon: 'tree' },
];
const valueStyle = [
  { bg: '#f5f5ff', tileBg: '#362dff', tileFg: '#fff' },
  { bg: '#FFD458', tileBg: '#05006c', tileFg: '#FFD458' },
  { bg: '#f5f5ff', tileBg: '#32E0C4', tileFg: '#05006c' },
];
const accents = ['#FFD458', '#32E0C4'];

// Illustrated chart for the arch hero: one lead and three reports, initials only.
const reports = [
  { i: 'SP', role: 'Sales', c: '#32E0C4', fg: '#05006c' },
  { i: 'MK', role: 'Marketing', c: '#FFD458', fg: '#05006c' },
  { i: 'OP', role: 'Ops', c: '#8F89FF', fg: '#fff' },
];
---

<Base title="Org Chart | Ariella Digital Consulting" description="Make it possible for your department heads or teams to add a dynamic org chart to any LumApps page.">
  <div class="oc">
    <section class="oc__hero" data-custom-prompt-after>
      <div class="oc__wrap oc__hero-grid">
        <div class="oc__hero-copy">
          <a class="oc__back" href="/extension-widgets">← Back to Extension Widgets</a>
          <span class="oc__eyebrow">Extension widget</span>
          <h1>Org Chart <span>by ADC</span></h1>
          <p class="oc__lede">Give every team a clear view of who leads what. Department heads and page owners can add a live org chart to any LumApps page or Space, in a few clicks and with no code.</p>
          <div class="oc__hero-ctas">
            <a class="oc__btn oc__btn--blue" href={contactHref}>Request a Demo</a>
            <a class="oc__docs" href={docs}>
              <span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#05006c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5z" /></svg>
              </span>
              Read the docs
            </a>
          </div>
        </div>
        <div class="oc__visual">
          <div class="oc__arch" aria-hidden="true">
            <div class="oc__arch-floor" />
            <div class="oc__tree">
              <div class="oc__node oc__node--lead">
                <span class="oc__avatar" style="background:#fff;color:#362dff">AZ</span>
                <span class="oc__node-text"><strong>Head of Department</strong><small>3 direct reports</small></span>
              </div>
              <div class="oc__stem" />
              <div class="oc__branch">
                {reports.map((r, i) => (
                  <div class="oc__node oc__node--report" style={`animation-delay:${0.3 + i * 0.15}s`}>
                    <span class="oc__avatar" style={`background:${r.c};color:${r.fg}`}>{r.i}</span>
                    <span class="oc__node-text"><strong>{r.role}</strong></span>
                  </div>
                ))}
              </div>
            </div>
            <div class="oc__hero-msg">
              <span>Who leads what</span>
              <span>ON ANY PAGE</span>
            </div>
          </div>
          <span class="oc__sticker">Drag &amp; drop · no code</span>
        </div>
      </div>
    </section>

    <section class="oc__why oc__wrap">
      <div class="oc__why-head">
        <p class="oc__eyebrow">HAVE A LOOK AT</p>
        <h2>Why<br />use it</h2>
        <div class="oc__bar" aria-hidden="true" />
      </div>
      <ol class="oc__why-list">
        {
          why.map((w, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="oc__does">
      <div class="oc__wrap">
        <div class="oc__heading">
          <p class="oc__eyebrow oc__eyebrow--alt">HAVE A LOOK AT</p>
          <h2>What it does</h2>
        </div>
        <div class="oc__reel">
          <div class="oc__video">
            <iframe src={video} title="Org Chart widget sizzle reel" loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen" allowfullscreen />
          </div>
          <div class="oc__reel-copy">
            <span class="oc__reel-icon" set:html={icon('play', 26)} />
            <h3>Org Chart sizzle reel</h3>
            <p>See the Org Chart extension in action in this 30-second teaser video.</p>
          </div>
        </div>
        <div class="oc__figs">
          <figure>
            <div class="oc__fig oc__fig--white">
              <img src="/images/4fa8b918befd.webp" alt="Org chart in LumApps' standard mode: a manager and three direct reports in an indented tree" width="858" height="354" loading="lazy" />
            </div>
            <figcaption>Standard mode: the hierarchy from the selected person down, styled like a LumApps profile.</figcaption>
          </figure>
          <figure>
            <div class="oc__fig oc__fig--yellow">
              <img src="/images/c18b09847c58.webp" alt="Org chart in browse mode: a manager card connected to three report cards" width="442" height="334" loading="lazy" />
              <img class="oc__fig-settings" src="/images/70ebaa8bf951.webp" alt="Widget settings: select a user, behavior, and number of levels" width="317" height="601" loading="lazy" />
            </div>
            <figcaption>Browse mode, set up in the widget settings: pick a user, a behavior, and how many levels to show.</figcaption>
          </figure>
        </div>
        <div class="oc__features">
          {
            features.map((f, i) => (
              <div>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="oc__steps-sec">
      <div class="oc__wrap">
        <div class="oc__heading">
          <p class="oc__eyebrow">ROLL IT OUT IN</p>
          <h2 class="oc__h2-md">Three simple steps</h2>
        </div>
        <ol class="oc__steps">
          {
            steps.map((s, i) => (
              <li>
                <span class="oc__step-icon" style={`background:${stepStyle[i].bg};color:${stepStyle[i].fg}`} set:html={icon(stepStyle[i].icon)} />
                <span class="oc__step-num">STEP {i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </li>
            ))
          }
        </ol>
        <div class="oc__band" data-custom-prompt-hide>
          <div>
            <p class="oc__band-title">Widget pricing</p>
            <p>Contact us for pricing details and a demo on your own LumApps platform.</p>
          </div>
          <a class="oc__btn oc__btn--yellow" href={contactHref}>Request a Demo</a>
        </div>
      </div>
    </section>

    <section class="oc__value oc__wrap">
      <div class="oc__value-head">
        <div class="oc__heading">
          <p class="oc__eyebrow">LEARN MORE ABOUT</p>
          <h2>Where it delivers value</h2>
        </div>
        <p>Added value for HR, Internal Communications, and department heads</p>
      </div>
      <div class="oc__value-list">
        {
          value.map((v, i) => (
            <div style={`background:${valueStyle[i].bg}`}>
              <div class="oc__value-title">
                <span style={`background:${valueStyle[i].tileBg};color:${valueStyle[i].tileFg}`} set:html={icon(v.icon)} />
                <h3>{v.title}</h3>
              </div>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="oc__further oc__wrap">
      <div class="oc__heading">
        <p class="oc__eyebrow">GO FURTHER</p>
        <h2 class="oc__h2-sm">Explore More Experiences by ADC</h2>
      </div>
      <div class="oc__further-grid">
        {
          related.map((r, i) => (
            <a href={r.href}>
              <span class="oc__further-icon" style={`color:${accents[i % 2]}`} set:html={icon(r.icon, 30)} />
              <span class="oc__further-text">
                <span class="oc__further-title">{r.title}</span>
                <span>{r.text}</span>
                <span class="oc__more">Learn More →</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="oc__cta" data-custom-prompt-hide>
      <div class="oc__cta-blue">
        <h2>Got questions?</h2>
        <p>Get in touch to learn more about this widget and to see a demo</p>
        <div><a class="oc__btn oc__btn--yellow oc__btn--lg" href={contactHref}>Contact us</a></div>
      </div>
      <div class="oc__cta-yellow">
        <p>Check out our Docs site for a listing of all our widgets:</p>
        <a href={docs}>docs.adc.dev/docs</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .oc {
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #000;
    line-height: 1.5;
    background: #fff;
  }
  .oc * {
    box-sizing: border-box;
  }
  .oc h1,
  .oc h2,
  .oc h3 {
    font-family: 'Archivo', sans-serif;
    margin: 0;
  }
  .oc p,
  .oc ol,
  .oc ul,
  .oc figure {
    margin: 0;
  }
  .oc a:focus-visible {
    outline: 3px solid #32e0c4;
    outline-offset: 2px;
  }
  .oc__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .oc__eyebrow {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: 13px;
    text-transform: uppercase;
    color: #362dff;
  }
  .oc__eyebrow--alt {
    color: #ffd458;
  }
  .oc__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .oc__heading h2,
  .oc__why-head h2 {
    font-weight: 900;
    font-size: clamp(44px, 5.5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #05006c;
  }
  .oc__heading .oc__h2-md {
    font-size: clamp(40px, 5vw, 64px);
  }
  .oc__heading .oc__h2-sm {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .oc__btn {
    display: inline-block;
    padding: 18px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 17px;
    transition: transform 0.15s ease;
  }
  .oc__btn:hover {
    transform: translateY(-2px);
  }
  .oc__btn--blue {
    background: #362dff;
    color: #fff;
  }
  .oc__btn--blue:hover {
    background: #05006c;
    color: #fff;
  }
  .oc__btn--yellow {
    background: #ffd458;
    color: #05006c;
  }
  .oc__btn--yellow:hover {
    color: #05006c;
  }
  .oc__btn--lg {
    padding: 18px 34px;
    font-size: 18px;
  }

  /* Hero copy */
  .oc__back {
    align-self: flex-start;
    padding: 8px 16px;
    border: 1.5px solid #05006c;
    border-radius: 999px;
    color: #05006c;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }
  .oc__back:hover {
    background: #05006c;
    color: #fff;
  }
  .oc h1 {
    font-weight: 900;
    font-size: clamp(52px, 7vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #05006c;
  }
  .oc h1 span {
    padding: 6px 16px;
    border-radius: 999px;
    background: #f5f5ff;
    color: #362dff;
    font-size: 0.4em;
    font-weight: 700;
    letter-spacing: 0;
    vertical-align: middle;
    white-space: nowrap;
  }
  .oc__lede {
    max-width: 580px;
    font-size: 19px;
    line-height: 1.65;
    color: #4a4870;
  }
  .oc__hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
  }
  .oc__docs {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #05006c;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
  }
  .oc__docs:hover {
    color: #362dff;
  }
  .oc__docs span {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #05006c;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  /* Split hero on white */
  .oc__hero {
    overflow: hidden;
    padding-top: 40px;
    border-bottom: 1px solid #ecebf7;
  }
  .oc__hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 48px;
    align-items: end;
  }
  .oc__hero-copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 40px 0 96px;
  }
  .oc__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 600px;
  }
  .oc__arch {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(480px, 100%);
    height: 580px;
    border-radius: 240px 240px 0 0;
    overflow: hidden;
    background: #05006c;
    box-shadow: 0 30px 60px rgba(5, 0, 108, 0.25);
  }
  .oc__arch-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 30%;
    background: #362dff;
  }
  .oc__tree {
    position: absolute;
    left: 24px;
    right: 24px;
    top: 120px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .oc__node {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px 10px 10px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    animation: pop 0.6s cubic-bezier(0.2, 0.8, 0.2, 1.2) both;
  }
  .oc__node--lead {
    background: #fff;
    color: #05006c;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.3);
  }
  .oc__node--lead .oc__avatar {
    background: #362dff !important;
    color: #fff !important;
  }
  .oc__node--report {
    flex-direction: column;
    gap: 8px;
    padding: 14px 10px;
    border-radius: 20px;
    min-width: 0;
  }
  .oc__avatar {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 15px;
  }
  .oc__node-text {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    font-family: 'Archivo', sans-serif;
  }
  .oc__node-text strong {
    font-weight: 800;
    font-size: 16px;
  }
  .oc__node-text small {
    font-size: 13px;
    color: #5b5a7a;
  }
  .oc__stem {
    width: 2px;
    height: 32px;
    background: #8f89ff;
  }
  .oc__branch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    width: 100%;
    max-width: 380px;
    padding-top: 28px;
    text-align: center;
  }
  .oc__branch::before {
    content: '';
    position: absolute;
    top: 0;
    left: 16.6%;
    right: 16.6%;
    height: 28px;
    border: 2px solid #8f89ff;
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
  }
  .oc__branch::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 2px;
    height: 28px;
    background: #8f89ff;
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.9);
    }
  }
  .oc__hero-msg {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 0;
    height: 30%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    text-align: center;
    color: #fff;
    font-family: 'Archivo', sans-serif;
  }
  .oc__hero-msg span:first-child {
    font-weight: 900;
    font-size: clamp(30px, 3.4vw, 42px);
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .oc__hero-msg span:last-child {
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.2em;
    color: #ffd458;
  }
  .oc__sticker {
    position: absolute;
    top: 40px;
    right: 0;
    padding: 12px 18px;
    border-radius: 999px;
    background: #ffd458;
    color: #05006c;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    transform: rotate(3deg);
    box-shadow: 0 10px 30px rgba(5, 0, 108, 0.2);
  }
  @media (prefers-reduced-motion: reduce) {
    .oc__node {
      animation: none;
    }
  }

  /* Video */
  .oc__video {
    min-width: 0;
    aspect-ratio: 16 / 9;
    border-radius: 24px;
    overflow: hidden;
    background: #05006c;
    box-shadow: 0 30px 60px rgba(5, 0, 108, 0.3);
  }
  .oc__video iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Why use it */
  .oc__why {
    padding-top: 120px;
    padding-bottom: 120px;
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
  }
  .oc__why-head {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .oc__bar {
    width: 96px;
    height: 12px;
    margin-top: 12px;
    border-radius: 6px;
    background: #32e0c4;
  }
  .oc__why-list {
    flex: 999 1 560px;
    min-width: 0;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .oc__why-list li {
    display: flex;
    gap: 32px;
    align-items: baseline;
    padding: 32px 0;
    border-top: 1px solid #d9d7ff;
  }
  .oc__why-list li:first-child {
    border-top: 2px solid #05006c;
  }
  .oc__why-list li:last-child {
