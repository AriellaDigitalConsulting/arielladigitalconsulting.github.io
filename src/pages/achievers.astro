    box-shadow: 0 30px 60px rgba(5, 0, 108, 0.3);
  }
  .ac__panel {
    animation: pop 0.4s ease-out both;
  }
  @keyframes pop {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }
  }
  .ac__panel img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 20px;
  }
  .ac__board {
    overflow: hidden;
    border-radius: 24px;
    background: #fff;
  }
  .ac__board-title {
    padding: 22px;
    background: #362dff;
    color: #fff;
    text-align: center;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 24px;
    letter-spacing: 0.02em;
  }
  .ac__board-tabs {
    display: flex;
    border-bottom: 2px solid #e4e4e4;
  }
  .ac__board-tabs button {
    flex: 1;
