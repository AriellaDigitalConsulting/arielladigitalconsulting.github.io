    font-weight: 700;
    font-size: 15px;
    transform: rotate(3deg);
    box-shadow: 0 10px 30px rgba(5, 0, 108, 0.2);
  }
  .ac__tabs {
    display: inline-flex;
    gap: 4px;
    padding: 6px;
    border-radius: 999px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(5, 0, 108, 0.12);
  }
  .ac__tabs button {
    min-height: 44px;
    padding: 0 22px;
    border: none;
    border-radius: 999px;
    background: #fff;
    color: #05006c;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 15px;
    cursor: pointer;
  }
  .ac__tabs button[aria-selected='true'] {
    background: #362dff;
    color: #fff;
  }
  .ac__frame {
    width: 100%;
    max-width: 440px;
    padding: 22px;
    border-radius: 32px;
