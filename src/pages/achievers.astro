    color: #362dff;
  }
  .ac__pts {
    font-size: 16px;
    color: #333;
    white-space: nowrap;
  }
  .ac__page {
    display: flex;
    justify-content: center;
    padding: 14px;
  }
  .ac__page span {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: #362dff;
    color: #fff;
    display: flex;
