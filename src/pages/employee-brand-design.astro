---
// Employee Brand Design (Services › Integrations). Built from the "Employee Brand Identity, reworked (from V2)" design.
// The design's inline styles are kept as-is; its scaled mockups read their size from the --ebd-* variables set below.
import Base from '../layouts/Base.astro';
---

<Base
  title="Employee Brand Design | Ariella Digital Consulting"
  description="Employee brand design by ADC: we turn your brand inward inside LumApps, with a name, voice and identity system that give your people a reason to keep coming back."
>
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Playfair+Display:ital,wght@0,700;1,400;1,700&family=Caveat:wght@700&family=Space+Mono:wght@400;700&family=Open+Sans:wght@400;600;700&family=Bricolage+Grotesque:wght@500;800&display=swap"
  />
  <div class="ebd" style="font-family: 'Open Sans', system-ui, sans-serif; color: #05006c; background: #fbfaf5; font-size: 17px; line-height: 1.65">
    <script is:inline>
      (function () {
        var root = document.currentScript.parentElement;
        function fit() {
          var vw = window.innerWidth || 1280;
          var content = Math.min(vw, 1120) - 48;
          var stageS = Math.min(1, content / 960);
          var wide = vw >= 980;
          var typeW = Math.min(720, wide ? content - 56 - 340 : content);
          var typeS = typeW / 720;
          var sideS = wide ? Math.min(1, (content - 32) / 2 / 520) : Math.min(1, content / 520);
          var v = {
            stageS: stageS, stageW: Math.round(960 * stageS) + 'px', stageH: Math.round(620 * stageS) + 'px',
            typeS: typeS, typeW: Math.round(typeW) + 'px', typeH: Math.round(540 * typeS) + 'px',
            typePos: wide ? 'sticky' : 'static',
            sideS: sideS, sideW: Math.round(520 * sideS) + 'px', sideH: Math.round(420 * sideS) + 'px',
            kitS: stageS, kitW: Math.round(960 * stageS) + 'px', kitH: Math.round(560 * stageS) + 'px'
          };
          for (var k in v) root.style.setProperty('--ebd-' + k, v[k]);
        }
        fit();
        window.addEventListener('resize', fit);
      })();
    </script>

<!-- HERO -->
<section style="background: #05006c; color: #fff; overflow: hidden">
<div style="max-width: 1120px; margin: 0 auto; padding: 64px 24px 56px; display: flex; flex-direction: column; gap: 36px">
<div style="display: flex; flex-direction: column; align-items: flex-start; gap: 22px">
<p style="margin: 0; background: #ffd458; color: #05006c; font-family: 'Space Mono', monospace; font-size: 14px; font-weight: 700; letter-spacing: 1.2px; padding: 7px 12px; transform: rotate(-1.5deg)">Employee Brand Design</p>
<h1 style="margin: 0; font-family: Archivo, sans-serif; font-size: clamp(44px, 7.2vw, 88px); line-height: 1; font-weight: 900; letter-spacing: -2.5px; text-wrap: balance">Your brand, <em style="font-family: 'Playfair Display', serif; font-style: italic; font-weight: 700; letter-spacing: -1px; color: #ffd458">turned inward.</em></h1>
<p style="margin: 0; font-size: 19px; max-width: 38em">Your people see your logo, colors and taglines every working day. They don't need them repeated on the intranet. ADC builds an employee-facing spin on your brand inside LumApps, with the same roots and a story, voice and look that give your people a reason to keep coming back.</p>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px">
<a href="#dial" style="background: #32e0c4; color: #05006c; text-decoration: none; font-family: Archivo, sans-serif; font-size: 17px; font-weight: 800; border-radius: 999px; padding: 16px 30px">See how it works</a>
<a href="/contact" style="color: #fff; text-decoration: none; font-family: Archivo, sans-serif; font-size: 17px; font-weight: 800; border-radius: 999px; padding: 14px 28px; border: 2px solid #ffffff80">Book a call</a>
</div>
</div>

<div style="width: var(--ebd-stageW); height: var(--ebd-stageH); margin: 0 auto; max-width: 100%">
<div role="img" aria-label="Sample company ACME's employee brand, The Branch, on a desktop monitor and a phone, with team photos, shout-outs and a poll" style="position: relative; width: 960px; height: 620px; transform: scale(var(--ebd-stageS)); transform-origin: 0 0; font-family: 'Bricolage Grotesque', sans-serif; color: #1a1426; line-height: 1.3">
<div style="position: absolute; left: 44px; top: 44px; width: 720px; height: 470px; box-sizing: border-box; background: #000; border-radius: 16px; padding: 12px; box-shadow: 0 24px 48px #00000066">
<div style="width: 100%; height: 100%; background: #fff4d6; border-radius: 6px; overflow: hidden; display: flex; flex-direction: column">
<div style="height: 42px; flex: none; background: #ff6b4a; display: flex; align-items: center; justify-content: space-between; padding: 0 16px; box-sizing: border-box">
<div style="display: flex; align-items: center; gap: 8px">
<svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 20.5C8 15 12 11 19.5 4.5" fill="none" stroke="#1a1426" stroke-width="2.4" stroke-linecap="round"></path><path d="M11.5 12.5C7 13 4 11 3.5 6.5 8 6 11 8.5 11.5 12.5Z" fill="#1a1426"></path><path d="M15 9C14.5 5 16.5 2.5 21 2.5 21 7 18.5 9.5 15 9Z" fill="#1a1426"></path></svg>
<span style="font-size: 18px; font-weight: 800">The Branch</span><span style="font-size: 10px; font-weight: 500">by ACME</span>
</div>
<div style="display: flex; align-items: center; gap: 16px; font-size: 12px; font-weight: 800"><span>The Feed</span><span>People</span><span>Toolbox</span><span>Events</span><span style="width: 26px; height: 26px; border-radius: 50%; background: #1a1426; color: #fff4d6; display: flex; align-items: center; justify-content: center; font-size: 11px">S</span></div>
</div>
<div style="flex: 1; padding: 12px 14px 14px; display: flex; flex-direction: column; gap: 10px; min-height: 0">
<div style="position: relative; height: 158px; flex: none; border-radius: 12px; overflow: hidden">
<img src="/images/employee-brand/19489c1fb239.webp" alt="Coworkers laughing together over pizza" style="position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%">
<div style="position: absolute; left: 12px; bottom: 12px; background: #1a1426; color: #fff4d6; border-radius: 10px; padding: 10px 14px; display: flex; flex-direction: column; gap: 2px">
