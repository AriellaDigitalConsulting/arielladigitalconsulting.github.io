---
// AI Readiness Audit (Services › Change Management › AI Readiness Audit). Built from the "AI Readiness Audit — Navy Signal" design.
// The design's inline styles are kept as-is; its nav and footer are replaced by the site's own header and footer.
import Base from '../layouts/Base.astro';
---

<Base
  title="AI Readiness Audit for LumApps | Ariella Digital Consulting"
  description="ADC's AI Readiness Audit for LumApps finds the outdated, duplicate and ownerless pages feeding AI Search wrong answers, and gives you a plan to fix them."
  image="/images/ai-readiness-audit-hero.webp"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify([
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'AI Readiness Audit for LumApps',
      serviceType: 'AI search readiness and intranet content audit',
      description:
        'An audit of a LumApps intranet that finds the outdated, duplicate, placeholder and ownerless pages feeding LumApps AI Search wrong answers, tests real employee questions, and delivers a prioritised cleanup and governance plan.',
      url: 'https://www.adc.dev/ai-readiness-audit/',
      image: 'https://www.adc.dev/images/ai-readiness-audit-hero.webp',
      provider: { '@type': 'Organization', name: 'Ariella Digital Consulting', url: 'https://www.adc.dev/' },
      areaServed: ['North America', 'Europe'],
      audience: { '@type': 'BusinessAudience', audienceType: 'Organizations using LumApps' },
    },
    {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.adc.dev/' },
        { '@type': 'ListItem', position: 2, name: 'Change Management', item: 'https://www.adc.dev/change-management/' },
        { '@type': 'ListItem', position: 3, name: 'AI Readiness Audit', item: 'https://www.adc.dev/ai-readiness-audit/' },
      ],
    },
  ])} />
  <link
    slot="head"
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
  />
  <div class="ara" style="font-family: 'Open Sans', system-ui, sans-serif; color: #1B1A3A; background: #FFFFFF; width: 100%; overflow-x: hidden">

  <!-- HERO -->
  <section id="top" style="background: #05006C; color: #FFFFFF; position: relative; overflow: hidden">
    <div aria-hidden="true" style="position: absolute; right: -120px; top: -160px; width: 560px; height: 560px; border-radius: 50%; border: 80px solid rgba(54,45,255,0.35)"></div>
    <div style="max-width: 1200px; margin: 0 auto; padding: 96px 24px 104px; display: flex; flex-wrap: wrap; gap: 56px; align-items: center; position: relative">
      <div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 28px">
        <h1 style="margin: 0; display: inline-flex; align-self: flex-start; align-items: center; gap: 10px; padding: 8px 14px; border-radius: 999px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); font-family: 'Open Sans', system-ui, sans-serif; font-size: 14px; line-height: 1.5; font-weight: 600; color: #E6E5FF">
          <span aria-hidden="true" style="width: 8px; height: 8px; border-radius: 50%; background: #32E0C4"></span>
          AI Readiness Audit for LumApps
        </h1>
        <p style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(40px, 5.4vw, 66px); line-height: 1.03; letter-spacing: -1.5px">Is your LumApps intranet <span style="color: #FFD458">ready for AI?</span></p>
        <p style="margin: 0; font-size: 19px; line-height: 1.6; color: #D4D2F5; max-width: 560px">AI Search answers from what your intranet already holds. ADC's AI Readiness Audit finds what's feeding it wrong answers, and gives you a plan to fix them.</p>
        <div style="display: flex; flex-wrap: wrap; gap: 14px; padding-top: 4px">
          <a class="btn-primary" href="/contact" style="background: #362DFF; color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; box-sizing: border-box">Book an audit call
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn-ghost" href="#how" style="color: #FFFFFF; text-decoration: none; font-weight: 600; font-size: 16px; padding: 15px 26px; border-radius: 999px; border: 1px solid rgba(255,255,255,0.35); display: inline-flex; align-items: center; min-height: 44px; box-sizing: border-box">See how it works</a>
        </div>
      </div>

      <!-- Hero visual: an AI answer citing the wrong page -->
      <div role="img" aria-label="Illustration: LumApps AI answers a benefits question from an outdated 2021 policy page instead of the current one" style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
        <div style="align-self: flex-end; background: #362DFF; color: #FFFFFF; border-radius: 20px 20px 6px 20px; padding: 14px 18px; font-size: 15px; max-width: 320px; box-shadow: 0 20px 40px rgba(0,0,0,0.25)">How many days of parental leave do I get?</div>
        <div style="background: #FFFFFF; color: #05006C; border-radius: 20px; padding: 22px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 30px 60px rgba(0,0,0,0.25)">
          <div style="display: flex; align-items: center; gap: 10px">
            <span style="width: 30px; height: 30px; border-radius: 9px; background: #F1F0FF; display: flex; align-items: center; justify-content: center"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#362DFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l2.5 5.5L20 11l-5.5 2.5L12 19l-2.5-5.5L4 11l5.5-2.5z"></path></svg></span>
            <span style="font-family: Archivo, sans-serif; font-weight: 700; font-size: 15px">AI Search</span>
          </div>
          <p style="margin: 0; font-size: 15px; line-height: 1.55; color: #1B1A3A">According to the <strong>Parental Leave Policy</strong>, employees receive 10 days of paid leave…</p>
          <div style="border: 1.5px solid #FFD458; background: #FFF9E3; border-radius: 14px; padding: 12px 14px; display: flex; flex-direction: column; gap: 6px; font-size: 13px">
            <span style="font-weight: 700; color: #6B4E00">Source found first</span>
            <span style="color: #1B1A3A">Parental Leave Policy (COPY) · HR / Archive-old</span>
            <span style="display: flex; flex-wrap: wrap; gap: 6px">
              <span style="background: #FFFFFF; border: 1px solid #F0DFA6; padding: 3px 9px; border-radius: 999px; color: #6B4E00">Not updated since 2021</span>
              <span style="background: #FFFFFF; border: 1px solid #F0DFA6; padding: 3px 9px; border-radius: 999px; color: #6B4E00">Owner left the company</span>
              <span style="background: #FFFFFF; border: 1px solid #F0DFA6; padding: 3px 9px; border-radius: 999px; color: #6B4E00">No end date</span>
            </span>
          </div>
        </div>
        <div style="background: #32E0C4; color: #05006C; border-radius: 16px; padding: 14px 18px; font-size: 14px; font-weight: 600; display: flex; align-items: center; gap: 10px">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
          Should find: Parental Leave Policy 2026 · HR
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section style="background: #F7F7FC; border-bottom: 1px solid #ECEBF7">
    <div style="max-width: 1200px; margin: 0 auto; padding: 104px 24px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
      <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 18px">
        <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">Why it matters</span>
        <h2 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(32px, 3.8vw, 46px); line-height: 1.08; letter-spacing: -1px; color: #05006C">The answer is only as good as the page search finds first.</h2>
        <p style="margin: 0; font-size: 17px; line-height: 1.7; color: #4A4870">When an employee asks LumApps AI about benefits, onboarding or expenses, outdated policies, placeholder pages, duplicate copies and content with no owner all compete for that spot. Most intranets carry years of it, and nobody sees it until the AI repeats it.</p>
      </div>
      <div style="flex: 1 1 460px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px">
        <div style="background: #FFFFFF; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><span style="width: 44px; height: 44px; border-radius: 12px; background: #FFD458; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 19px; color: #05006C">Outdated policies</h3><p style="margin: 0; font-size: 14px; line-height: 1.55; color: #4A4870">Last year's rules, still ranking above this year's.</p></div>
        <div style="background: #FFFFFF; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><span style="width: 44px; height: 44px; border-radius: 12px; background: #E9E8FF; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#362DFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"></rect><path d="M8 8h8M8 12h5"></path></svg></span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 19px; color: #05006C">Placeholder pages</h3><p style="margin: 0; font-size: 14px; line-height: 1.55; color: #4A4870">Test sites and "coming soon" pages the AI treats as real.</p></div>
        <div style="background: #FFFFFF; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><span style="width: 44px; height: 44px; border-radius: 12px; background: #DDF9F4; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#0A6B5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg></span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 19px; color: #05006C">Duplicate copies</h3><p style="margin: 0; font-size: 14px; line-height: 1.55; color: #4A4870">Three versions of one page, and no way to tell which is true.</p></div>
        <div style="background: #FFFFFF; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 10px"><span style="width: 44px; height: 44px; border-radius: 12px; background: #05006C; display: flex; align-items: center; justify-content: center"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 4-6 8-6s8 2 8 6"></path></svg></span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 19px; color: #05006C">No owner</h3><p style="margin: 0; font-size: 14px; line-height: 1.55; color: #4A4870">Content from departed staff that nobody keeps current.</p></div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how" style="max-width: 1200px; margin: 0 auto; padding: 112px 24px; display: flex; flex-direction: column; gap: 56px">
    <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px">
      <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">How it works</span>
      <h2 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.08; letter-spacing: -1px; color: #05006C">Five steps from a noisy intranet to answers you can trust.</h2>
    </div>
    <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px">
      <li style="display: flex; flex-direction: column; gap: 12px; padding-top: 22px; border-top: 3px solid #362DFF"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #362DFF">01</span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 20px; line-height: 1.25; color: #05006C">Map your platform</h3><p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">We look at every site, page, community and broadcast, and separate your real intranet from test sites and leftover copies.</p></li>
      <li style="display: flex; flex-direction: column; gap: 12px; padding-top: 22px; border-top: 3px solid #32E0C4"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #0A6B5C">02</span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 20px; line-height: 1.25; color: #05006C">Score every page</h3><p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Each page is checked for freshness, ownership, title quality, tags, expiry dates, duplicates and views.</p></li>
      <li style="display: flex; flex-direction: column; gap: 12px; padding-top: 22px; border-top: 3px solid #FFD458"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #8A6500">03</span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 20px; line-height: 1.25; color: #05006C">Ask the questions your employees ask</h3><p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">We put real employee questions to LumApps search and read the results the way the AI does, so you see the wrong answers employees get today.</p></li>
      <li style="display: flex; flex-direction: column; gap: 12px; padding-top: 22px; border-top: 3px solid #362DFF"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #362DFF">04</span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 20px; line-height: 1.25; color: #05006C">Prioritise</h3><p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Every fix is ranked by impact against effort, so your team starts with what matters most.</p></li>
      <li style="display: flex; flex-direction: column; gap: 12px; padding-top: 22px; border-top: 3px solid #05006C"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #05006C">05</span><h3 style="margin: 0; font-family: Archivo, sans-serif; font-size: 20px; line-height: 1.25; color: #05006C">Clean up safely, with your approval</h3><p style="margin: 0; font-size: 15px; line-height: 1.6; color: #4A4870">Nothing changes until you sign off on a specific list. Content is archived, never deleted, so every change can be undone.</p></li>
    </ol>
  </section>

  <!-- DELIVERABLES -->
  <section id="deliverables" style="background: #05006C; color: #FFFFFF">
    <div style="max-width: 1200px; margin: 0 auto; padding: 112px 24px; display: flex; flex-direction: column; gap: 48px">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
        <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px">
          <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #32E0C4">What you get</span>
          <h2 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.08; letter-spacing: -1px">A verdict, a plan, and everything your team needs to act on it.</h2>
        </div>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px">
        <div style="grid-column: 1 / -1; background: #362DFF; border-radius: 24px; padding: 36px; display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between">
          <div style="flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 10px">
            <span style="font-size: 13px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #FFD458">The verdict</span>
            <h3 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: 28px; line-height: 1.15">A clear verdict on how AI-ready your intranet is, with the biggest risk and the first thing to fix.</h3>
          </div>
          <div aria-hidden="true" style="display: flex; gap: 10px">
            <span style="width: 56px; height: 140px; border-radius: 28px; background: #32E0C4"></span>
            <span style="width: 56px; height: 140px; border-radius: 28px; background: #FFD458; margin-top: 24px"></span>
          </div>
        </div>
        <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #32E0C4">Scorecard</span><p style="margin: 0; font-size: 16px; line-height: 1.6; color: #FFFFFF">A scorecard for each site that you can track month over month.</p></div>
        <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #FFD458">Wrong answers today</span><p style="margin: 0; font-size: 16px; line-height: 1.6; color: #FFFFFF">Each failing question, what the AI finds now, and what it should find.</p></div>
        <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #32E0C4">Policy fixes</span><p style="margin: 0; font-size: 16px; line-height: 1.6; color: #FFFFFF">Fixes that remove whole classes of problems at once, such as mandatory end dates and handing pages from departed staff to a new owner.</p></div>
        <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #FFD458">Cleanup batches</span><p style="margin: 0; font-size: 16px; line-height: 1.6; color: #FFFFFF">Cleanup batches, ready for sign-off.</p></div>
        <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #32E0C4">Owner digest</span><p style="margin: 0; font-size: 16px; line-height: 1.6; color: #FFFFFF">Each content owner gets a short list of plain actions.</p></div>
        <div style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.14); border-radius: 24px; padding: 28px; display: flex; flex-direction: column; gap: 12px"><span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 15px; color: #FFD458">Governance routine</span><p style="margin: 0; font-size: 16px; line-height: 1.6; color: #FFFFFF">A routine that keeps your intranet AI-ready after the cleanup.</p></div>
      </div>
    </div>
  </section>

  <!-- SAMPLE REPORT -->
  <section id="sample-report" style="background: #F7F7FC; border-bottom: 1px solid #ECEBF7">
    <div style="max-width: 1200px; margin: 0 auto; padding: 112px 24px; display: flex; flex-direction: column; gap: 48px">
      <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px">
        <div style="display: flex; flex-direction: column; gap: 14px; max-width: 720px">
          <span style="font-size: 13px; font-weight: 600; letter-spacing: 2px; text-transform: uppercase; color: #362DFF">Sample report</span>
          <h2 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.08; letter-spacing: -1px; color: #05006C">What an AI Readiness Report looks like.</h2>
          <p style="margin: 0; font-size: 17px; line-height: 1.7; color: #4A4870">We ran the audit on our own LumApps demo and documentation site. These are the real results, with client and staff names removed.</p>
        </div>
      </div>

      <!-- report frame -->
      <div style="background: #FFFFFF; border-radius: 24px; border: 1px solid #E2E1F0; box-shadow: 0 30px 70px rgba(5,0,108,0.12); overflow: hidden">
        <div style="background: #05006C; padding: 14px 20px; display: flex; flex-wrap: wrap; align-items: center; gap: 16px">
          <span aria-hidden="true" style="display: flex; gap: 7px"><span style="width: 11px; height: 11px; border-radius: 50%; background: #FFD458"></span><span style="width: 11px; height: 11px; border-radius: 50%; background: #32E0C4"></span><span style="width: 11px; height: 11px; border-radius: 50%; background: #362DFF"></span></span>
          <span style="flex: 1 1 260px; background: rgba(255,255,255,0.1); color: #D4D2F5; font-size: 13px; padding: 7px 14px; border-radius: 999px">ADC · AI Search Readiness Audit · Sample report · 24 Nov 2026</span>
        </div>

        <div style="padding: clamp(24px, 4vw, 48px); display: flex; flex-direction: column; gap: 40px">

          <!-- verdict -->
          <div style="display: flex; flex-direction: column; gap: 12px; padding-bottom: 32px; border-bottom: 1px solid #ECEBF7">
            <span style="font-size: 12px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; color: #5A5890">The verdict</span>
            <h3 style="margin: 0; font-family: Archivo, sans-serif; font-weight: 800; font-size: clamp(26px, 3vw, 36px); line-height: 1.12; letter-spacing: -0.5px; color: #05006C">Is this intranet ready for AI? Not yet.</h3>
            <p style="margin: 0; font-size: 18px; line-height: 1.6; color: #1B1A3A; max-width: 820px">Only <strong>2</strong> of <strong>15</strong> everyday employee questions got a good answer, and at least <strong>72</strong> live pages still hold placeholder text that an AI would happily repeat.</p>
          </div>

          <!-- KPIs -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px">
            <div style="background: #F7F7FC; border-radius: 18px; padding: 24px; display: flex; flex-direction: column; gap: 8px">
              <span style="font-size: 13px; font-weight: 600; color: #4A4870">Good AI answers</span>
              <span style="font-family: Archivo, sans-serif; font-weight: 800; font-size: 44px; line-height: 1; color: #05006C">2<span style="font-size: 20px; color: #5A5890"> of 15</span></span>
