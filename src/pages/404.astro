---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Ariella Digital Consulting">
  <div class="dots-hero notfound">
    <div class="wrap">
      <h1 class="display">Page <span class="blue">not found</span></h1>
      <p class="lede">The page you're looking for moved, or never existed.</p>
      <p class="notfound__links">
        <a class="btn btn--lg" href="/">Back home</a>
        <a class="btn btn--lg" href="/news">Read the news</a>
      </p>
    </div>
  </div>
</Base>

<style>
  .notfound {
    padding: 100px 0 140px;
    background-size: 1440px auto;
  }
  .notfound .display {
    font-family: var(--f-head);
  }
  .notfound .lede {
    margin-top: 24px;
  }
  .notfound__links {
    display: flex;
    gap: 16px;
    margin-top: 40px;
  }
</style>
