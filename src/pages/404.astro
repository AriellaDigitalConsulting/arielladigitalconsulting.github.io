---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found — ADC">
  <section class="section section--soft">
    <div class="wrap" style="text-align:center;padding:4rem 0">
      <p class="eyebrow">404</p>
      <h1>This page moved, or never existed.</h1>
      <p class="lede" style="margin-inline:auto">
        Most of what you're looking for lives under Products or Services.
      </p>
      <p style="margin-top:2rem">
        <a class="btn" href="/">Back home</a>
        <a class="btn btn--ghost" href="/news" style="margin-left:.75rem">Read the news</a>
      </p>
    </div>
  </section>
</Base>
