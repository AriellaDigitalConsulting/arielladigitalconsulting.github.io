---
import Base from '../layouts/Base.astro';
import Blocks from '../components/Blocks.astro';
import pages from '../data/pages.json';
import images from '../data/images.json';

export function getStaticPaths() {
  const skip = new Set([
    'index', 'services', 'products', 'about', 'design', 'analytics', 'contact', 'news', 'blog',
    'third-party-integrations', 'search-enhancements',
  ]);
  return Object.keys(pages as Record<string, any>)
    .filter((slug) => !skip.has(slug) && !slug.startsWith('copy-of-'))
    .map((slug) => ({ params: { slug }, props: { page: (pages as any)[slug] } }));
}

const { page } = Astro.props;
const blocks: any[] = page.blocks ?? [];
const head = blocks[0]?.type === 'image' ? blocks[0] : null;
const heroFile = head ? (images as Record<string, { file: string }>)[head.uri]?.file : null;
const titleBlock = blocks.find((b) => b.type === 'h1');
const title = titleBlock?.text ?? 'ADC';
const rest = blocks.filter((b) => b !== head);
---

<Base title={`${title} — ADC`}>
  {heroFile ? (
    <section class="page-hero">
      <img src={heroFile} alt="" />
      <div class="page-hero__inner wrap">
        <h1>{title}</h1>
      </div>
    </section>
  ) : (
    <section class="section section--soft" style="padding-bottom:2rem">
      <div class="wrap"><h1>{title}</h1></div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <p class="back"><a href="/products">← Back to Products</a></p>
      <Blocks blocks={rest.filter((b) => b.type !== 'h1')} />
      <p class="cta-line">
        <a class="btn" href="/contact">Talk to us</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    background: var(--navy);
    color: #fff;
    min-height: 300px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .page-hero img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgba(5, 0, 108, 0.94), rgba(5, 0, 108, 0.6));
  }
  .page-hero__inner {
    padding: 4rem 24px 3rem;
    width: 100%;
  }
  .page-hero h1 {
    color: #fff;
    margin: 0;
    max-width: 20ch;
  }
  .back {
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  .back a {
    text-decoration: none;
  }
  .cta-line {
    margin-top: 3rem;
  }
</style>
