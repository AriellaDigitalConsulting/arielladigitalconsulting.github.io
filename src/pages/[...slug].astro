---
// Pages reproduced from layout snapshots of the original site (scripts/snapshot.mjs).
import Base from '../layouts/Base.astro';
import LayoutPage from '../components/LayoutPage.astro';


export function getStaticPaths() {
  const files = import.meta.glob('../data/layouts/*.json', { eager: true });
  const handBuilt = new Set(['index', 'products', 'about', 'contact', 'page-reader', 'soccer', 'analytics', 'holiday-spirits-widget', 'org-chart', 'guess-word-widget', 'advanced-survey']);
  // These URLs redirect elsewhere (see `redirects` in astro.config.mjs), so no page is generated for them.
  const redirected = new Set(['services', 'search-enhancements']);
  return Object.values(files)
    .map((m: any) => m.default)
    .filter((l) => !handBuilt.has(l.slug) && !redirected.has(l.slug))
    .map((layout) => ({ params: { slug: layout.slug }, props: { layout } }));
}

const { layout } = Astro.props;
---

<Base title={layout.title} description={layout.description}>
  <LayoutPage layout={layout} />
</Base>
