---
// Pages reproduced from layout snapshots of the original site (scripts/snapshot.mjs).
import Base from '../layouts/Base.astro';
import LayoutPage from '../components/LayoutPage.astro';


export function getStaticPaths() {
  const files = import.meta.glob('../data/layouts/*.json', { eager: true });
  const handBuilt = new Set(['index', 'products', 'about', 'contact', 'page-reader', 'soccer', 'analytics', 'holiday-spirits-widget', 'org-chart', 'guess-word-widget', 'advanced-survey', 'follow-actions', 'follow-interests', 'admin-enhancements-widgets-bundle']);
  // These URLs redirect elsewhere (see `redirects` in astro.config.mjs), so no page is generated for them.
  const redirected = new Set(['services', 'search-enhancements', 'third-party-integrations']);
  return Object.values(files)
    .map((m: any) => m.default)
    .filter((l) => !handBuilt.has(l.slug) && !redirected.has(l.slug))
    .map((layout) => ({ params: { slug: layout.slug }, props: { layout } }));
}

const { layout } = Astro.props;

// Several snapshots kept a generic Wix title shared with other pages; give each one its own.
const titles: Record<string, string> = {
  'animations-widgets-bundle': 'Animation & Gamification Widgets for LumApps | ADC',
  'bunchball-gamification-integration': 'Bunchball Gamification for LumApps | ADC',
  'community-posts': 'Community Posts List Widget for LumApps | ADC',
  'coveo-integrations': 'Coveo Integrations for LumApps | ADC',
  'extension-widgets': 'LumApps Extension Widgets & Bundles | ADC',
  kaltura: 'Kaltura Integration for LumApps | ADC',
  'last-modified-date': 'Last Modified Date Widget for LumApps | ADC',
  looker: 'Looker Integration for LumApps | ADC',
  'metadata-mover': 'Metadata Mover for LumApps | ADC',
  'qa-support': 'Q&A Support Community Bundle for LumApps | ADC',
  'search-expertise': 'LumApps Enterprise Search Expertise | ADC',
  'table-of-contents': 'Advanced Table of Contents for LumApps | ADC',
  'timezone-widget': 'Timezone Widget for LumApps | ADC',
  'town-hall': 'Town Hall Bundle for LumApps | ADC',
  'ui-enhancements-widget-bundle': 'UI Enhancements Widget Bundle for LumApps | ADC',
  'user-engagement-widget-bundle': 'User Engagement Widget Bundle for LumApps | ADC',
  wiki: 'Wiki & Knowledge Base Bundle for LumApps | ADC',
};
---

<Base title={titles[layout.slug] ?? layout.title} description={layout.description}>
  <LayoutPage layout={layout} />
</Base>
