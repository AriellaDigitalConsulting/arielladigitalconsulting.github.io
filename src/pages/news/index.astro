---
import Base from '../../layouts/Base.astro';
import articles from '../../data/articles.json';
import images from '../../data/images.json';

const fmt = (iso: string) =>
  new Date(iso + 'T12:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const posts = (articles as any[]).map((a) => ({
  ...a,
  img: a.image ? (images as any)[a.image.uri]?.file : null,
  dateLabel: fmt(a.iso),
}));
---

<Base title="News — ADC" description="Announcements, product updates and industry insights from ADC.">
  <section class="section section--soft">
    <div class="wrap">
      <p class="eyebrow">News</p>
      <h1>ADC News</h1>
      <p class="lede">See all of our past announcements, product updates and industry insights.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="post-list">
        {
          posts.map((p) => (
            <a class="post-card" href={`/news/${p.slug}`}>
              {p.img ? <img src={p.img} alt="" loading="lazy" /> : <div class="post-card__blank" />}
              <div>
                <p class="post-meta">
                  <span>{p.dateLabel}</span>
                  <span>{p.author}</span>
                </p>
                <h2>{p.title}</h2>
                <p style="color:var(--muted);margin:0">{p.excerpt}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .post-card__blank {
    aspect-ratio: 16 / 9;
    background: var(--bg-soft);
    border-radius: 10px;
  }
</style>
