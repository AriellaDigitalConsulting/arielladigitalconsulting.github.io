---
import Base from '../../layouts/Base.astro';
import { posts, imageFile, longDate, localHtml, type Article } from '../../lib/news';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Article };
const hero = imageFile(post.hero ?? post.thumb);
---

<Base title={`${post.title} | ADC`} description={post.excerpt}>
  <article class="article">
    <div class="article__col">
      <a class="article__back" href="/news">&lt; Back</a>
      <h1>{post.title}</h1>
      <p class="article__by">
        {imageFile(post.avatar) && <img src={imageFile(post.avatar)} alt="" width="42" height="42" />}
        <span>
          <strong>{post.author}</strong>
          <time datetime={post.iso}>{longDate(post.iso)}</time>
        </span>
      </p>
    </div>
    {hero && <img class="article__hero" src={hero} alt="" width="980" height="462" />}
    <div class="article__col">
      {post.lead && <div class="article__lead" set:html={localHtml(post.lead)} />}
      <div class="article__body" set:html={localHtml(post.html)} />
    </div>
  </article>
</Base>

<style>
  .article {
    width: min(980px, 100% - 32px);
    margin: 0 auto;
    padding: 56px 0 80px;
  }
  .article__col {
    max-width: 875px;
    margin: 0 auto;
  }
  .article__back {
    font-family: 'wfont_6c5776_4f47414d61e645aeb5d47770d7921b99', var(--f-text);
    font-size: 18px;
    text-decoration: none;
  }
  .article h1 {
    margin-top: 5px;
    font-family: var(--f-head);
    font-weight: 400;
    font-size: 65px;
    line-height: 1.2;
  }
  .article__by {
    display: flex;
    align-items: center;
    gap: 13px;
    margin: 22px 0 35px;
  }
  .article__by img {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    object-fit: cover;
  }
  .article__by strong {
    display: block;
    font-family: 'wfont_6c5776_f141d555279443968fa7d40bfd600384', var(--f-text);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.6;
  }
  .article__by time {
    font-family: var(--f-text);
    font-size: 14px;
  }
  .article__hero {
    width: 100%;
    aspect-ratio: 980 / 462;
    object-fit: cover;
  }
  .article__lead {
    margin-top: 33px;
    font-family: var(--f-text);
    font-size: 26px;
    line-height: 1.6;
  }
  .article__body {
    margin-top: 16px;
    font-family: var(--f-text);
    font-size: 16px;
    line-height: 1.5;
  }
  .article__body :global(h2),
  .article__body :global(h3),
  .article__body :global(h4) {
    font-weight: 400;
    font-size: 20px;
    line-height: 1.5;
    margin-top: 1.4em;
  }
  .article__body :global(ul),
  .article__body :global(ol) {
    padding-left: 24px;
  }
  .article__body :global(li p) {
    margin: 0;
  }
  .article__body :global(a) {
    color: var(--blue);
  }
  .article__body :global(figure) {
    margin: 24px 0;
  }
  .article__body :global(figure img) {
    width: 100%;
    height: auto;
  }
  .article__body :global(figure.video) {
    aspect-ratio: 16 / 9;
  }
  .article__body :global(figure.video iframe),
  .article__body :global(figure.video video) {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .article__body :global(figure:empty) {
    display: none;
  }
  @media (max-width: 760px) {
    .article {
      padding-top: 32px;
    }
    .article h1 {
      font-size: 34px;
    }
    .article__lead {
      font-size: 20px;
    }
  }
</style>
