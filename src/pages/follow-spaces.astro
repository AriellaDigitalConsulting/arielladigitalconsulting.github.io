---
// Follow Spaces & Communities product page, in the Follow Actions Bundle's look (FollowWidgetEditorial).
// Copy comes from the ADC docs page for the widget; screenshots are from the docs.
import FollowWidgetEditorial from '../components/FollowWidgetEditorial.astro';
---

<FollowWidgetEditorial
  name="Follow Spaces & Communities"
  description="The Follow Spaces & Communities widget by ADC: put a Follow button for any LumApps Space or Community on any page, including the homepage."
  docs="https://docs.adc.dev/docs/ls/content/2992245790187279/follow-spaces-communities"
  tagline="Follow any Space or Community, from anywhere."
  h1={['Follow Spaces &', 'Communities']}
  lede="LumApps only lets people follow a Space or Community from inside it. This widget puts a “Follow [Space / Community name]” button on any page, including the homepage, so employees can follow the social content that matters to them wherever they find it."
  follows={['Following Q&A Support', 'Follow All About Spaces', 'Follow Leadership Corner']}
  mock={{ src: '/images/follow-spaces-community-feed.webp', w: 503, h: 612 }}
  why={[
    { title: 'Follow from any page', text: 'Get past the native limit of following a Space or Community only from inside it, and put the follow button anywhere on your site.' },
    { title: 'Always shows the right state', text: 'Each button reflects whether the employee already follows the Space or Community, so nobody clicks twice.' },
    { title: 'Make it easy to opt in', text: 'Let employees join the conversations relevant to them right away, without sending them off to find the follow button.' },
  ]}
  shots={[
    { src: '/images/follow-spaces-community-feed.webp', alt: 'Community posts from Q&A Support with a Follow Q&A Support Community button underneath', w: 503, h: 612, caption: 'A Follow button under a Community’s latest posts, so readers can join in one click.' },
    { src: '/images/follow-spaces-settings.webp', alt: 'The Follow Space or Community widget settings: label, hide details, enable notifications on follow and the target Space or Community', w: 318, h: 488, caption: 'Pick the Space or Community, add a custom label, and turn on notifications on follow.' },
  ]}
  features={[
    { title: 'One Button per Space.', text: 'Each button is tied to a specific LumApps Space or Community.' },
    { title: 'Follow in Real Time.', text: 'Clicking follows or unfollows instantly, and the button updates to match.' },
    { title: 'Multiple Buttons per Page.', text: 'Position as many buttons as you like anywhere within the same page layout.' },
    { title: 'Styled by LumApps Designer.', text: 'A responsive design built with LumApps Designer best practices, styled to match your site theme.' },
  ]}
  steps={[
    { title: 'Add the widget', text: 'Place the Follow Space or Community widget on any page, including the homepage.' },
    { title: 'Pick the target', text: 'Choose the Space or Community to follow and add a custom label, such as “Follow Q&A Support Community”.' },
    { title: 'Employees follow', text: 'One click follows or unfollows in real time, and the button shows the current state.' },
  ]}
  valueIntro="Added value for your page administrators, your employees, and the communities they join"
  value={[
    { icon: 'shield', title: 'Administrators & Experience Managers', text: 'Promote any Space or Community from the homepage or a landing page, with buttons you position and style like any other widget.' },
    { icon: 'users', title: 'Employees', text: 'Opt in to the Spaces and Communities that matter to them in one click, with a button that always shows whether they already follow.' },
    { icon: 'chat', title: 'Community Managers', text: 'Grow your membership by inviting employees to follow right where they read about your Space or Community.' },
  ]}
  related={[
    { href: '/follow-actions', icon: 'grid', title: 'Follow Actions Bundle.', text: 'Get Follow Spaces & Communities together with Follow People and Follow Interests in one bundle.' },
    { href: '/follow-interests', icon: 'star', title: 'Follow Interests widget.', text: 'Let employees subscribe to an interest and its email notifications in one click.' },
    { href: '/follow-people', icon: 'users', title: 'Follow People widget.', text: 'Let employees follow a leader or colleague in one click, from any page.' },
  ]}
/>
