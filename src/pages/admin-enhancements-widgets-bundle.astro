---
// ADC Toolbox (Admin Enhancements) bundle page ("Split Editorial" template, modeled on Estimated Reading Time).
// The widget list comes from the Products data: every extension in the ADC Toolbox category, so the two stay in sync.
// Copy is from the original /admin-enhancements-widgets-bundle page; screenshots are of the ADC Toolbox page in LumApps.
import Base from '../layouts/Base.astro';
import { contactHref } from '../data/site';
import { extensions } from '../data/extensions';

const tools = extensions.filter((e) => e.c.includes('tb') && !e.bundle).sort((a, b) => a.n.localeCompare(b.n));

const why = [
  { title: 'Less manual overhead', text: 'Spend far less time managing and maintaining groups, metadata, media and site architecture by hand.' },
  { title: 'Faster routine admin work', text: 'Purpose-built tools speed up the daily, time-consuming tasks that keep a LumApps platform running smoothly.' },
  { title: 'Rearchitect without the rework', text: 'Reorganize metadata and move media files in a fraction of the time it takes to rebuild them.' },
];

const features = [
  { title: 'Layouts in Seconds.', text: 'Copy page, Space and Community homepage layouts from one place to another through a friendly interface.' },
  { title: 'Content on the Move.', text: 'Copy content across content types, within a single site or across multiple sites.' },
  { title: 'Groups & Metadata at Hand.', text: 'Look up and update groups, members and metadata without leaving the page.' },
  { title: 'Platform-Level Control.', text: 'Manage platform styles, media, and your ADC widget licenses from one tool wall.' },
];

const value = [
  { bg: '#f5f5ff', tileBg: '#362dff', tileFg: '#fff', icon: '<path d="M12 3l8 4v5c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V7z"/><path d="M9 12l2 2 4-4"/>', title: 'Platform & Site Administrators', text: 'Manage media across one or many sites, copy page and homepage layouts in a few clicks, and look up or update groups and metadata the easy way.' },
  { bg: '#FFD458', tileBg: '#05006c', tileFg: '#FFD458', icon: '<path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/>', title: 'Page Owners & Content Teams', text: 'Get faster support from admins, and reuse proven layouts and content instead of rebuilding them from scratch.' },
  { bg: '#f5f5ff', tileBg: '#32E0C4', tileFg: '#05006c', icon: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>', title: 'IT & Developers', text: 'Troubleshoot widgets with the Debug Widget, keep platform styles consistent, and keep ADC widget licenses under control.' },
];

const related = [
  { href: '/platform-style', accent: '#FFD458', icon: '<circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2a10 10 0 0 0 0 20c1 0 1.7-.8 1.7-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.4-.7-.4-1.1 0-.9.8-1.7 1.7-1.7H16a6 6 0 0 0 6-6c0-4.4-4.5-8.3-10-8.3z"/>', title: 'Platform Style Manager.', text: 'Duplicate and manage your platform styles from one place, so every site stays on brand.' },
  { href: '/content-copier', accent: '#32E0C4', icon: '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>', title: 'Content Copier Tool.', text: 'Duplicate LumApps content across content types and sites, with everything carried over.' },
];

const icon = (paths: string, size = 28) =>
  `<svg width="${size}" height="${size}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${paths}</svg>`;
const adcMark = '<svg width="40" height="37" viewBox="0 0 22 20.3706" fill="none" aria-hidden="true"><path d="M3.26367 4.50242H6.73663C6.73663 4.50242 6.34303 2.79392 8.93617 2.81733C8.93617 2.81733 11.3557 2.46626 10.9736 5.91836V20.3704H14.6666V4.17476C14.5796 2.0901 12.9923 0.385859 10.9389 0.172667C10.9389 0.172667 3.04371 -1.32519 3.26367 4.50242Z" fill="#32E0C4"/><path d="M4.46209 20.3658V16.907C4.46209 16.907 2.79204 17.3105 2.81507 14.7163C2.81507 14.7163 2.46954 12.3067 5.85571 12.6987H14.6667V8.96309H4.05897C4.05897 8.96309 0.91467 8.87085 0.131475 12.6641C0.177545 12.6641 -1.27367 20.5849 4.46209 20.3658Z" fill="#362DFF"/><rect x="4.07397" y="20.3706" width="3.25926" height="10.5926" transform="rotate(-90 4.07397 20.3706)" fill="#362DFF"/><rect x="10.5925" y="20.3706" width="3.25926" height="11.4074" transform="rotate(-90 10.5925 20.3706)" fill="#FFD458"/><path d="M21.9999 8.96289H10.5925V12.2221H21.0047C21.3361 12.2028 21.6686 12.2028 21.9999 12.2221V8.96289Z" fill="#FFD458"/><rect x="10.5925" y="8.96289" width="4.07407" height="11.4074" fill="#362DFF"/></svg>';
const toolIcons = [
  '<path d="M3 3h8v8H3zM13 3h8v5h-8zM13 10h8v11h-8zM3 13h8v8H3z"/>',
  '<path d="M14.7 6.3a4 4 0 0 0 5 5l-8.4 8.4a2.1 2.1 0 0 1-3-3z"/><path d="M14.7 6.3 17 4l3 3-2.3 2.3"/>',
  '<rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>',
];
---

<Base title="ADC Toolbox Bundle | Ariella Digital Consulting" description="The ADC Toolbox Bundle: the tool wall for LumApps administrators, to move layouts, copy content, and manage groups, metadata, media and styles.">
  <div class="tb">
    <section class="tb__hero" data-custom-prompt-after>
      <div class="tb__wrap tb__hero-grid">
        <div class="tb__hero-copy">
          <a class="tb__back" href="/products">← Back to Products Page</a>
          <p class="tb__tagline">The tool wall for LumApps admins.</p>
          <h1>ADC Toolbox<br />Bundle <span>by ADC</span></h1>
          <p class="tb__lede">Everything LumApps administrators need to manage and maintain their platform, in one bundle. Move page, Space and Community layouts, copy content across content types and sites, and keep groups, metadata, media and styles in order.</p>
          <div class="tb__hero-ctas">
            <a class="tb__btn tb__btn--blue" href={contactHref}>Request a Demo</a>
            <a class="tb__docs" href="#widgets">
              <span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#05006c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"></rect><rect x="14" y="3" width="7" height="7" rx="1.5"></rect><rect x="3" y="14" width="7" height="7" rx="1.5"></rect><rect x="14" y="14" width="7" height="7" rx="1.5"></rect></svg>
              </span>
              See all {tools.length} tools
            </a>
          </div>
        </div>

        <div class="tb__visual">
          <div class="tb__arch">
            <div class="tb__arch-floor" aria-hidden="true"></div>
            <div class="tb__flare flare" aria-hidden="true"></div>
            <div class="tb__stack">
              <div class="tb__count" aria-hidden="true">
                <span>{tools.length}</span>
                <span>ADMIN TOOLS</span>
              </div>
              <ul class="tb__follows" aria-label="Example tools">
                <li class="tb__follow tb__follow--on" set:html={icon(toolIcons[0], 16) + 'Layout moved'} />
                <li class="tb__follow tb__follow--pulse" set:html={icon(toolIcons[1], 16) + 'Edit metadata'} />
                <li class="tb__follow" set:html={icon(toolIcons[2], 16) + 'Copy content'} />
              </ul>
            </div>
            <div class="tb__sweep-clip" aria-hidden="true"><div class="tb__sweep sweep"></div></div>
          </div>
          <div class="tb__mock" aria-hidden="true">
            <img src="/images/adc-toolbox-media-mover.webp" alt="" width="516" height="932" loading="eager" />
          </div>
          <span class="tb__sticker">Admin Enhancements Bundle</span>
        </div>
      </div>
    </section>

    <section class="tb__why tb__wrap">
      <div class="tb__why-head">
        <p class="tb__eyebrow">OUR BUNDLE</p>
        <h2>Why<br />use it</h2>
        <div class="tb__bar" aria-hidden="true"></div>
      </div>
      <ol class="tb__why-list">
        {
          why.map((w, i) => (
            <li>
              <span>{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{w.title}</h3>
                <p>{w.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="tb__does">
      <div class="tb__wrap">
        <div class="tb__heading">
          <p class="tb__eyebrow tb__eyebrow--yellow">HAVE A LOOK AT</p>
          <h2>What it does</h2>
        </div>
        <div class="tb__figs">
          <figure>
            <div class="tb__fig tb__fig--white">
              <img src="/images/adc-toolbox-page.webp" alt="The ADC Toolbox page in LumApps, with the Media Mover and Content Layout Mover side by side" width="1400" height="1050" loading="lazy" />
            </div>
            <figcaption>One ADC Toolbox page in LumApps, with every admin tool a click away.</figcaption>
          </figure>
          <figure>
            <div class="tb__fig tb__fig--yellow">
              <img src="/images/adc-toolbox-layout-movers.webp" alt="The Space Homepage Layout Mover and Community Homepage Layout Mover widgets" width="1200" height="800" loading="lazy" />
            </div>
            <figcaption>Pick a source and a destination, and copy a Space or Community homepage layout in seconds.</figcaption>
          </figure>
        </div>
        <div class="tb__features">
          {
            features.map((f, i) => (
              <div>
                <span>{String(i + 1).padStart(2, '0')}</span>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="tb__steps-sec" id="widgets">
      <div class="tb__wrap">
        <div class="tb__heading">
          <p class="tb__eyebrow">WHAT YOU GET</p>
          <h2 class="tb__h2-md">{tools.length} tools, one bundle</h2>
        </div>
        <ul class="tb__tools">
          {
            tools.map((t) => {
              const Tag = t.href ? 'a' : 'div';
              return (
                <li>
                  <Tag class="tb__tool" href={t.href}>
                    <span class="tb__tool-mark" set:html={adcMark} />
                    <span class="tb__tool-body">
                      <span class="tb__tool-name">{t.n}</span>
                      <span class="tb__tool-type">WIDGET</span>
                      <span class="tb__tool-desc">{t.d}</span>
                      {t.href ? <span class="tb__more">Learn More →</span> : <span class="tb__tool-soon">Page coming soon</span>}
                    </span>
                  </Tag>
                </li>
              );
            })
          }
        </ul>
        <div class="tb__band" data-custom-prompt-hide>
          <div>
            <p class="tb__band-title">One bundle. Every admin tool.</p>
            <p>Less time on routine maintenance, more time improving your digital workplace.</p>
          </div>
          <a class="tb__btn tb__btn--yellow" href={contactHref}>Request a Demo</a>
        </div>
      </div>
    </section>

    <section class="tb__value tb__wrap">
      <div class="tb__value-head">
        <div class="tb__heading">
          <p class="tb__eyebrow">WHY DO YOU NEED THIS</p>
          <h2>Who it benefits</h2>
        </div>
        <p>Added value for your platform administrators, content owners, and IT teams</p>
      </div>
      <div class="tb__value-list">
        {
          value.map((v) => (
            <div style={`background:${v.bg}`}>
              <div class="tb__value-title">
                <span style={`background:${v.tileBg};color:${v.tileFg}`} set:html={icon(v.icon)} />
                <h3>{v.title}</h3>
              </div>
              <p>{v.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="tb__further tb__wrap">
      <div class="tb__heading">
        <p class="tb__eyebrow">GO FURTHER</p>
        <h2 class="tb__h2-sm">Explore More Admin Tools by ADC</h2>
      </div>
      <div class="tb__further-grid">
        {
          related.map((r) => (
            <a href={r.href}>
              <span class="tb__further-icon" style={`color:${r.accent}`} set:html={icon(r.icon, 30)} />
              <span class="tb__further-text">
                <span class="tb__further-title">{r.title}</span>
                <span>{r.text}</span>
                <span class="tb__more">Learn More →</span>
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="tb__cta" data-custom-prompt-hide>
      <div class="tb__cta-blue">
        <h2>Got questions?</h2>
        <p>Get in touch to learn more about this bundle and to see a demo</p>
        <div><a class="tb__btn tb__btn--yellow tb__btn--lg" href={contactHref}>Contact us</a></div>
      </div>
    </section>
  </div>
</Base>

<style>
  .tb {
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #000;
    line-height: 1.5;
  }
  .tb * {
    box-sizing: border-box;
  }
  .tb h1,
  .tb h2,
  .tb h3 {
    font-family: 'Archivo', sans-serif;
    margin: 0;
  }
  .tb p,
  .tb ol,
  .tb figure {
    margin: 0;
  }
  .tb a:focus-visible {
    outline: 3px solid #32e0c4;
    outline-offset: 2px;
  }
  .tb__wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .tb__eyebrow {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    letter-spacing: 0.18em;
    font-size: 13px;
    color: #362dff;
  }
  .tb__eyebrow--yellow {
    color: #ffd458;
  }
  .tb__heading {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .tb__heading h2,
  .tb__why-head h2 {
    font-weight: 900;
    font-size: clamp(44px, 5.5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #05006c;
  }
  .tb__heading .tb__h2-md {
    font-size: clamp(40px, 5vw, 64px);
  }
  .tb__heading .tb__h2-sm {
    font-size: clamp(30px, 3.6vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .tb__btn {
    display: inline-block;
    padding: 18px 32px;
    border-radius: 999px;
    text-decoration: none;
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 17px;
    transition: transform 0.15s ease;
  }
  .tb__btn:hover {
    transform: translateY(-2px);
  }
  .tb__btn--blue {
    background: #362dff;
    color: #fff;
  }
  .tb__btn--blue:hover {
    background: #05006c;
    color: #fff;
  }
  .tb__btn--yellow {
    background: #ffd458;
    color: #05006c;
  }
  .tb__btn--yellow:hover {
    color: #05006c;
  }
  .tb__btn--lg {
    padding: 18px 34px;
    font-size: 18px;
  }

  /* Animations (off for reduced motion) */
  .sweep {
    animation: sweep 7s ease-in-out infinite;
  }
  @keyframes sweep {
    0% {
      transform: translateX(-120%) skewX(-18deg);
    }
    60%,
    100% {
      transform: translateX(220%) skewX(-18deg);
    }
  }
  .flare {
    animation: flare 3.2s ease-in-out infinite;
  }
  @keyframes flare {
    0%,
    100% {
      opacity: 0.25;
    }
    50% {
      opacity: 0.6;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sweep,
    .flare,
    .tb__follow--pulse {
      animation: none;
    }
  }

  /* Hero */
  .tb__hero {
    overflow: hidden;
    padding-top: 40px;
    background: #f5f5ff;
  }
  .tb__hero-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
    gap: 48px;
    align-items: end;
  }
  .tb__hero-copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    padding-bottom: 96px;
  }
  .tb__back {
    align-self: flex-start;
    padding: 8px 16px;
    border: 1.5px solid #05006c;
    border-radius: 999px;
    color: #05006c;
    text-decoration: none;
    font-weight: 600;
    font-size: 14px;
  }
  .tb__back:hover {
    background: #05006c;
    color: #fff;
  }
  .tb__tagline {
    font-family: 'Archivo', sans-serif;
    font-weight: 800;
    font-size: 22px;
    color: #362dff;
  }
  .tb h1 {
    font-weight: 900;
    font-size: clamp(52px, 7vw, 92px);
    line-height: 0.95;
    letter-spacing: -0.035em;
    color: #05006c;
  }
  .tb h1 span {
    padding: 6px 16px;
    border-radius: 999px;
    background: #fff;
    color: #362dff;
    font-size: 0.4em;
    font-weight: 700;
    letter-spacing: 0;
    vertical-align: middle;
    white-space: nowrap;
  }
  .tb__lede {
    max-width: 540px;
    font-size: 19px;
    line-height: 1.65;
    color: #1d1c3a;
  }
  .tb__hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    align-items: center;
  }
  .tb__docs {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    color: #05006c;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
  }
  .tb__docs:hover {
    color: #362dff;
  }
  .tb__docs span {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 2px solid #05006c;
    background: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .tb__visual {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    min-height: 600px;
  }
  .tb__arch {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(480px, 100%);
    height: 580px;
    border-radius: 240px 240px 0 0;
    overflow: hidden;
    background: #05006c;
    box-shadow: 0 30px 60px rgba(5, 0, 108, 0.3);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .tb__arch-floor {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 34%;
    background: #362dff;
  }
  .tb__flare {
    position: absolute;
    left: 8%;
    top: 8%;
    width: 50%;
    height: 30%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 255, 255, 0.28), rgba(255, 255, 255, 0));
  }
  .tb__sweep-clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .tb__sweep {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 35%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0));
  }
  .tb__mock {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 220px;
    height: 360px;
    overflow: hidden;
    border-radius: 34px 34px 0 0;
    border: 10px solid #05006c;
    border-bottom: none;
    background: #fff;
    box-shadow: 0 20px 50px rgba(5, 0, 108, 0.3);
  }
  .tb__mock img {
    display: block;
    width: 100%;
    height: auto;
  }
  .tb__sticker {
    position: absolute;
    top: 40px;
    right: 0;
    padding: 12px 18px;
    border-radius: 999px;
    background: #ffd458;
    color: #05006c;
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    transform: rotate(3deg);
    box-shadow: 0 10px 30px rgba(5, 0, 108, 0.2);
  }

  /* Why use it */
  .tb__why {
    padding-top: 120px;
    padding-bottom: 120px;
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
  }
  .tb__why-head {
    flex: 1 1 300px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .tb__bar {
    width: 96px;
    height: 12px;
    margin-top: 12px;
    border-radius: 6px;
    background: #32e0c4;
  }
  .tb__why-list {
    flex: 999 1 560px;
    min-width: 0;
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .tb__why-list li {
    display: flex;
    gap: 32px;
    align-items: baseline;
    padding: 32px 0;
    border-top: 1px solid #d9d7ff;
  }
  .tb__why-list li:first-child {
    border-top: 2px solid #05006c;
  }
  .tb__why-list li:last-child {
    border-bottom: 1px solid #d9d7ff;
  }
  .tb__why-list li > span {
    min-width: 72px;
    font-family: 'Archivo', sans-serif;
    font-weight: 900;
    font-size: 44px;
    color: #362dff;
  }
  .tb__why-list li > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .tb__why-list h3 {
    font-weight: 800;
    font-size: 24px;
    color: #05006c;
  }
  .tb__why-list p {
    font-size: 19px;
    line-height: 1.55;
  }

  /* What it does */
  .tb__does {
    padding: 120px 0;
    background: #05006c;
    color: #fff;
  }
  .tb__does .tb__wrap {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }
  .tb__does .tb__heading h2 {
    color: #fff;
  }
  .tb__figs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }
  .tb__figs figure {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .tb__figs figcaption {
    font-size: 15px;
    color: #c9c7ff;
  }
  .tb__fig {
    aspect-ratio: 4 / 3;
    border-radius: 24px;
