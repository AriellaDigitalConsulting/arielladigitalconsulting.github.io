---
// Products: a searchable library of ADC's LumApps extensions, filterable by category.
// Every card is rendered on the server; the script below only filters and regroups them.
import Base from '../layouts/Base.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import { categories, extensions } from '../data/extensions';
import { contactHref } from '../data/site';

const catById = Object.fromEntries(categories.map((c) => [c.id, c]));
const sorted = [...extensions].sort((a, b) => a.n.localeCompare(b.n));
const popular = extensions.filter((e) => e.pop).sort((a, b) => a.pop! - b.pop!);
const groups = categories
  .map((c) => ({ c, items: sorted.filter((e) => e.c[0] === c.id) }))
  .filter((g) => g.items.length);

const plural = (n: number) => `${n} ${n === 1 ? 'item' : 'items'}`;
const filters = [
  { id: 'all', label: 'Everything', chip: 'rgba(255,255,255,0.14)', ink: '#FFFFFF', count: extensions.length },
  { id: 'pop', label: 'Most Popular', chip: '#FFD458', ink: '#05006C', count: popular.length },
  ...categories.map((c) => ({ ...c, count: extensions.filter((e) => e.c.includes(c.id)).length })),
];
const icons: Record<string, string> = {
  all: '<rect x="4" y="4" width="6" height="6" rx="1.5"/><rect x="14" y="4" width="6" height="6" rx="1.5"/><rect x="4" y="14" width="6" height="6" rx="1.5"/><rect x="14" y="14" width="6" height="6" rx="1.5"/>',
  pop: '<path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z"/>',
  eg: '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M16 6h3v1a3 3 0 0 1-3 3M8 6H5v1a3 3 0 0 0 3 3M12 13v4M8 20h8"/>',
  tb: '<path d="M14.7 6.3a4 4 0 0 0 5 5l-8.4 8.4a2.1 2.1 0 0 1-3-3z"/><path d="M14.7 6.3 17 4l3 3-2.3 2.3"/>',
  cn: '<path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5M9 8h6M9 12h6"/>',
  sf: '<path d="M11 3l1.8 4.7 4.7 1.8-4.7 1.8L11 16l-1.8-4.7L4.5 9.5l4.7-1.8z"/><path d="M18.5 14.5l.8 2.2 2.2.8-2.2.8-.8 2.2-.8-2.2-2.2-.8 2.2-.8z"/>',
  se: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  ti: '<path d="M9 2v6M15 2v6M7 8h10v4a5 5 0 0 1-10 0zM12 17v5"/>',
  cs: '<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2a5 5 0 0 1 5 5.3"/>',
  dt: '<path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
  ut: '<path d="M4 6h16M4 12h16M4 18h16"/><circle cx="15" cy="6" r="2"/><circle cx="8" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>',
  pd: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2.5"/><path d="M14 10h4M14 14h4M5.5 17a3.5 3.5 0 0 1 7 0"/>',
  ac: '<circle cx="12" cy="4.5" r="1.5"/><path d="M5 8l7 1.5L19 8M12 9.5V14l-3 6M12 14l3 6"/>',
};
const suggestions = ['search', 'metadata', 'holiday', 'leaderboard'];
---

<Base title="Products | Ariella Digital Consulting" description={`ADC's LumApps extension library: ${extensions.length} widgets and integrations across ${categories.length} categories.`}>
  <div class="px">
    <section class="px__hero">
      <p class="px__eyebrow">ADC Extensions Library</p>
      <h1>What do you want<br />LumApps to <span>do next?</span></h1>
      <p class="px__sub">{extensions.length} widgets &amp; integrations across {categories.length} categories.</p>
      <form class="px__search" role="search" onsubmit="return false">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#362DFF" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
        <label for="px-q" class="px__sr">Search extensions</label>
        <input id="px-q" type="search" placeholder="Search by name or category" autocomplete="off" />
        <button type="button" class="px__clear" aria-label="Clear search" hidden>×</button>
      </form>
      <div class="px__try">
        <span>Try keywords:</span>
        {suggestions.map((s) => <button type="button" data-suggest={s} aria-pressed="false">{s}</button>)}
      </div>
      <a class="px__custom" href={contactHref}>
        <span class="px__custom-icon" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5l-8.4 8.4a2.1 2.1 0 0 1-3-3z"></path><path d="M14.7 6.3 17 4l3 3-2.3 2.3"></path></svg>
        </span>
        <span class="px__custom-text">
          <span class="px__custom-title">Need something custom?</span>
          <span class="px__custom-body">We don’t just build widgets. We build experiences your employees will actually use.</span>
          <span class="px__custom-cta">Start a conversation →</span>
        </span>
      </a>
    </section>

    <section class="px__results">
      <div class="px__results-inner">
        <nav class="px__side" aria-label="Filter by category">
          {
            filters.map((f) => (
              <button type="button" class="px__cat" data-filter={f.id} aria-pressed={f.id === 'all' ? 'true' : 'false'}>
                <span class="px__cat-icon" style={`background:${f.chip}`}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke={f.ink} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <Fragment set:html={icons[f.id]} />
                  </svg>
                </span>
                <span class="px__cat-label">{f.label}</span>
                <span class="px__cat-count">{f.count}</span>
              </button>
            ))
          }
        </nav>

        <div class="px__main">
          <p class="px__count" aria-live="polite"><strong>{extensions.length}</strong> <span>extensions, grouped by primary category</span></p>

          <div class="px__empty" hidden>
            <h2>Nothing yet — but we can build it.</h2>
            <div>
              <button type="button" class="px__reset">Reset search</button>
              <a href={contactHref}>Request a custom widget</a>
            </div>
          </div>

          <section class="px__featured" aria-label="Most popular">
            <div class="px__featured-head">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="#FFD458" stroke="#FFD458" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={icons.pop} /></svg>
              <h2>Most popular</h2>
            </div>
            <div class="px__featured-grid">
              {
                popular.map((e) => <ExtensionCard ext={e} cats={catById} variant="featured" />)
              }
            </div>
          </section>

          <div class="px__grouped">
            {
              groups.map((g) => (
                <div class="px__group">
                  <div class="px__group-head">
                    <div>
                      <span class="px__chip" aria-hidden="true" style={`background:${g.c.chip}`} />
                      <h2>{g.c.label}</h2>
                    </div>
                    <button type="button" data-filter-to={g.c.id}>{plural(g.items.length)} · View only these →</button>
                  </div>
                  <div class="px__grid">
                    {g.items.map((e) => (
                      <ExtensionCard ext={e} cats={catById} />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>

          <div class="px__grid px__flat" hidden>
            {
              sorted.map((e) => <ExtensionCard ext={e} cats={catById} filterable />)
            }
          </div>
        </div>
      </div>
    </section>

    <section class="px__more">
      <div>
        <h2>Don’t see what you need?</h2>
        <p>We design and build custom LumApps widgets and integrations.</p>
      </div>
      <a href={contactHref}>Book a discovery call →</a>
    </section>

    <!-- Compact copy of the hero's custom-build card that follows the visitor once the original scrolls away. -->
    <div class="px__float" data-show="false">
      <a class="px__float-link" href={contactHref}>
        <span class="px__custom-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#05006C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a4 4 0 0 0 5 5l-8.4 8.4a2.1 2.1 0 0 1-3-3z"></path><path d="M14.7 6.3 17 4l3 3-2.3 2.3"></path></svg>
        </span>
        <span class="px__float-text">
          <span class="px__float-title">Need something custom?</span>
          <span class="px__custom-cta">Start a conversation →</span>
        </span>
      </a>
      <button type="button" class="px__float-close" aria-label="Hide this message">×</button>
    </div>
  </div>
</Base>

<script>
  import { headerOffset, scrollToElement } from '../lib/smoothScroll';

  // Sticky custom-build prompt: shown once the hero card has scrolled away, hidden again while the
  // closing "Don't see what you need?" section is on screen, and gone for the visit once dismissed.
  {
    const card = document.querySelector<HTMLElement>('.px__custom')!;
    const closing = document.querySelector<HTMLElement>('.px__more')!;
    const float = document.querySelector<HTMLElement>('.px__float')!;
    const KEY = 'px-custom-dismissed';
    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem(KEY) === '1';
    } catch {}
    let cardGone = false;
    let closingVisible = false;
    const sync = () => (float.dataset.show = String(!dismissed && cardGone && !closingVisible));
    new IntersectionObserver(([e]) => {
      cardGone = !e.isIntersecting && e.boundingClientRect.top < 0;
      sync();
    }).observe(card);
    new IntersectionObserver(([e]) => {
      closingVisible = e.isIntersecting;
      sync();
    }).observe(closing);
    float.querySelector('.px__float-close')!.addEventListener('click', () => {
      dismissed = true;
      try {
        sessionStorage.setItem(KEY, '1');
      } catch {}
      sync();
    });
  }

  const root = document.querySelector<HTMLElement>('.px')!;
  const input = root.querySelector<HTMLInputElement>('#px-q')!;
  const clear = root.querySelector<HTMLButtonElement>('.px__clear')!;
  const keywords = [...root.querySelectorAll<HTMLButtonElement>('[data-suggest]')];
  const tiles = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...root.querySelectorAll<HTMLElement>('.px__flat .xc')];
  const grouped = root.querySelector<HTMLElement>('.px__grouped')!;
  const flat = root.querySelector<HTMLElement>('.px__flat')!;
  const featured = root.querySelector<HTMLElement>('.px__featured')!;
  const empty = root.querySelector<HTMLElement>('.px__empty')!;
  const count = root.querySelector<HTMLElement>('.px__count')!;
  const labels = Object.fromEntries(tiles.map((t) => [t.dataset.filter!, t.querySelector('.px__cat-label')!.textContent!]));

  let cat = 'all';
  const inCat = (el: HTMLElement, c: string) => c === 'all' || (c === 'pop' ? el.hasAttribute('data-pop') : el.dataset.cats!.split(' ').includes(c));
  const inQ = (el: HTMLElement, q: string) => !q || el.dataset.text!.includes(q);

  function render() {
    const raw = input.value.trim();
    const q = raw.toLowerCase();
    const browsing = cat === 'all' && !q;
    let n = 0;
    for (const el of items) {
      const show = inCat(el, cat) && inQ(el, q);
      el.hidden = !show;
      // Most Popular lists in rank order rather than A–Z.
      el.style.order = cat === 'pop' ? el.dataset.pop! : '';
      if (show) n++;
    }
    grouped.hidden = !browsing;
    featured.hidden = !browsing;
    flat.hidden = browsing || n === 0;
    empty.hidden = n > 0;
    clear.hidden = !input.value;
    for (const k of keywords) k.setAttribute('aria-pressed', String(q === k.dataset.suggest));
    for (const t of tiles) {
      const id = t.dataset.filter!;
      t.setAttribute('aria-pressed', String(id === cat));
      t.querySelector('.px__cat-count')!.textContent = String(items.filter((el) => inCat(el, id) && inQ(el, q)).length);
    }
    const note = browsing
      ? 'extensions, grouped by primary category'
      : 'results' + (cat === 'all' ? '' : ' in ' + labels[cat]) + (q ? ` for “${raw}”` : '');
    count.querySelector('strong')!.textContent = String(n);
    count.querySelector('span')!.textContent = note;
  }

  // Filter, then bring the top of the results back into view if the visitor had scrolled past it.
  function pick(id: string) {
    cat = id;
    render();
    const results = root.querySelector<HTMLElement>('.px__results')!;
    if (results.getBoundingClientRect().top < headerOffset()) scrollToElement(results);
  }

  input.addEventListener('input', render);
  clear.addEventListener('click', () => {
    input.value = '';
    input.focus();
    render();
  });
  for (const t of tiles) t.addEventListener('click', () => pick(t.dataset.filter!));
  root.querySelectorAll<HTMLButtonElement>('[data-filter-to]').forEach((b) => b.addEventListener('click', () => pick(b.dataset.filterTo!)));
  // A keyword chip fills the search box; clicking the selected one again clears it.
  keywords.forEach((b) =>
    b.addEventListener('click', () => {
      input.value = b.getAttribute('aria-pressed') === 'true' ? '' : b.dataset.suggest!;
      cat = 'all';
      render();
    })
  );
  root.querySelector('.px__reset')!.addEventListener('click', () => {
    input.value = '';
    cat = 'all';
    render();
  });
</script>

<style>
  .px {
    position: relative;
    font-family: 'open sans', 'Open Sans', system-ui, sans-serif;
    color: #fff;
    background: #05006c;
    line-height: 1.5;
  }
  .px * {
    box-sizing: border-box;
  }
  .px h1,
  .px h2 {
    font-family: 'Archivo', sans-serif;
    margin: 0;
  }
  .px p {
    margin: 0;
  }
  .px button {
    font-family: inherit;
    cursor: pointer;
  }
  .px a:focus-visible,
  .px button:focus-visible,
  .px input:focus-visible {
    outline: 3px solid #32e0c4;
    outline-offset: 2px;
  }
  .px [hidden] {
    display: none !important;
  }
  .px__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  /* Hero + search */
  .px__hero {
    max-width: 1080px;
    margin: 0 auto;
    padding: 80px 24px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
    text-align: center;
  }
  .px__eyebrow {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #32e0c4;
  }
  .px h1 {
    font-weight: 800;
    font-size: clamp(40px, 6vw, 72px);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .px h1 span {
    color: #ffd458;
  }
  .px__sub {
    font-size: 18px;
    color: #d4d2f5;
  }
  .px__search {
    position: relative;
    width: 100%;
    max-width: 760px;
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 8px;
    padding: 0 12px 0 24px;
    min-height: 68px;
    border-radius: 20px;
    background: #fff;
    box-shadow: 0 0 0 6px rgba(54, 45, 255, 0.45), 0 20px 50px rgba(0, 0, 0, 0.35);
  }
  .px__search svg {
    flex: none;
  }
  .px__search input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    font-family: inherit;
    font-size: 19px;
    color: #1b1a3a;
    padding: 16px 0;
  }
  .px__search input::placeholder {
    color: #5a5890;
  }
  .px__search input::-webkit-search-cancel-button {
    display: none;
  }
  .px__clear {
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 12px;
    background: #ffd458;
    color: #05006c;
    font-size: 22px;
    font-weight: 700;
  }
  .px__clear:hover {
    background: #32e0c4;
  }
  .px__try {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 14px;
    color: #d4d2f5;
  }
  .px__try button {
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.25);
    background: transparent;
    color: #fff;
    font-size: 14px;
  }
  .px__try button:hover {
    border-color: #32e0c4;
  }
  .px__try button[aria-pressed='true'] {
    border: 2px solid #32e0c4;
    background: rgba(50, 224, 196, 0.14);
    font-weight: 700;
  }

  /* "Need something custom?" card: floats beside the headline on wide screens, sits under the keywords otherwise. */
  .px__custom {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    width: 100%;
    max-width: 560px;
    margin-top: 6px;
    padding: 18px 20px;
    border-radius: 18px;
    background: #362dff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    text-align: left;
    text-decoration: none;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .px__custom:hover {
    transform: translateY(-3px);
    background: #4038ff;
    color: #fff;
  }
  .px__custom-icon {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: #32e0c4;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .px__custom-text {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .px__custom-title {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 18px;
    line-height: 1.2;
  }
  .px__custom-body {
    font-size: 14px;
    line-height: 1.5;
    color: #e4e3ff;
  }
  .px__custom-cta {
    margin-top: 2px;
    font-weight: 700;
    font-size: 14px;
    color: #32e0c4;
  }
  .px__float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 20;
    display: flex;
    align-items: center;
    border-radius: 18px;
    background: #362dff;
    border: 1px solid rgba(255, 255, 255, 0.2);
    box-shadow: 0 18px 40px rgba(5, 0, 108, 0.35);
    transition: opacity 0.25s ease, transform 0.25s ease, visibility 0.25s;
  }
  .px__float[data-show='false'] {
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px);
  }
  .px__float-link {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 8px 12px 14px;
    color: #fff;
    text-decoration: none;
  }
  .px__float-link:hover {
    color: #fff;
  }
  .px__float .px__custom-icon {
    width: 36px;
    height: 36px;
    border-radius: 10px;
  }
  .px__float-text {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }
  .px__float-title {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
  }
  .px__float .px__custom-cta {
    margin: 0;
    font-size: 13px;
  }
  .px__float-link:hover .px__custom-cta {
    color: #fff;
  }
  .px__float-close {
    align-self: flex-start;
    width: 32px;
    height: 32px;
    margin: 6px 6px 0 0;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: #c9c7f2;
    font-size: 20px;
    line-height: 1;
  }
  .px__float-close:hover {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
  @media (prefers-reduced-motion: reduce) {
    .px__float {
      transition: none;
    }
  }
  @media (max-width: 600px) {
    .px__float {
      left: 16px;
      right: 16px;
      bottom: 16px;
    }
    .px__float-link {
      flex: 1;
    }
  }

  @media (min-width: 1320px) {
    .px__custom {
      position: absolute;
      top: 72px;
      right: 32px;
      width: 250px;
      flex-direction: column;
      gap: 12px;
      margin: 0;
    }
  }

  /* Results: category sidebar + results column */
  .px__results {
    background: #0b0680;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }
  .px__results-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 48px 24px 96px;
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  .px__side {
    position: sticky;
    top: calc(var(--header-h, 0px) + 24px);
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .px__cat {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 8px 12px 8px 8px;
    border-radius: 12px;
    border: 2px solid transparent;
    background: transparent;
    color: #fff;
    text-align: left;
  }
  .px__cat:hover {
    background: rgba(255, 255, 255, 0.06);
  }
  .px__cat[aria-pressed='true'] {
    border-color: #32e0c4;
    background: rgba(50, 224, 196, 0.14);
  }
  .px__cat-icon {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .px__cat-label {
    flex: 1;
    font-family: 'Archivo', sans-serif;
    font-weight: 600;
    font-size: 15px;
    line-height: 1.2;
  }
  .px__cat-count {
    font-size: 13px;
    color: #d4d2f5;
  }
  .px__main {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Most popular */
  .px__featured-head {
