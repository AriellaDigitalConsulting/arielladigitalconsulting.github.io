---
import Base from '../layouts/Base.astro';
import { contactEmail } from '../data/site';
---

<Base title="Connect with us — ADC" description="Get in touch with ADC about LumApps integrations, implementations, analytics and design.">
  <section class="section section--soft">
    <div class="wrap contact-grid">
      <div>
        <p class="eyebrow">Connect</p>
        <h1>Connect with us</h1>
        <p class="lede">
          We solve challenges within your employee experience productivity suites to improve employee
          connectivity, productivity and processes. Please contact us so we can learn more about you and see how
          we can help mature your business' digital workplace journey.
        </p>
        <p>
          Prefer email? Write to <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.
        </p>
        <p style="font-size:0.9rem;color:var(--muted)">
          You can also reach us at info@arielladigitalconsulting.com.
        </p>
      </div>
      <form class="form" method="POST" action="https://formsubmit.co/ajax/hello@adc.dev" data-contact-form>
        <div class="field">
          <label for="name">Name</label>
          <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="250" autocomplete="email" />
        </div>
        <div class="field">
          <label for="subject">Subject</label>
          <input id="subject" name="subject" type="text" />
        </div>
        <div class="field">
          <label for="platform">Platform</label>
          <input id="platform" name="platform" type="text" placeholder="LumApps, Coveo, other…" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" required></textarea>
        </div>
        <div>
          <button class="btn" type="submit">Send</button>
        </div>
        <p class="form-status" data-status hidden></p>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector('[data-contact-form]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('[data-status]');
    const btn = form.querySelector('button[type=submit]');
    status.hidden = false;
    status.textContent = 'Sending…';
    btn.disabled = true;
    try {
      const res = await fetch(form.action.replace('/ajax/', '/'), {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = "Thanks for submitting! We'll be in touch shortly.";
      form.reset();
    } catch {
      status.textContent = 'Something went wrong. Please email hello@adc.dev instead.';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }
  .form-status {
    font-size: 0.95rem;
    color: var(--navy);
    font-weight: 600;
  }
  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
</style>
