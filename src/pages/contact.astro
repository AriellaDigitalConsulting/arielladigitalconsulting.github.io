---
import Base from '../layouts/Base.astro';
import { contactEmail } from '../data/site';
---

<Base title="Contact | Ariella Digital Consulting" description="Get in touch with ADC about LumApps integrations, implementations, analytics and design.">
  <section class="band contact-band">
    <div class="wrap">
      <h1>Connect with us</h1>
      <p>
        We solve challenges within your employee experience productivity suites to improve employee connectivity,
        productivity and processes. Please contact us so we can learn more about you and see how we can help mature your
        business' digital workplace journey!
      </p>
    </div>
  </section>

  <div class="contact">
    <form class="contact__form" method="POST" action={`https://formsubmit.co/ajax/${contactEmail}`} data-contact-form>
      <div class="field">
        <label for="name">Name *</label>
        <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" />
      </div>
      <div class="field">
        <label for="email">Email *</label>
        <input id="email" name="email" type="email" required maxlength="250" autocomplete="email" />
      </div>
      <div class="field">
        <label for="subject">Subject</label>
        <input id="subject" name="subject" type="text" />
      </div>
      <div class="field">
        <label for="platform">Platform</label>
        <input id="platform" name="platform" type="text" />
      </div>
      <div class="field field--wide">
        <label for="message">Message</label>
        <textarea id="message" name="message"></textarea>
      </div>
      <div class="field--wide contact__submit">
        <button type="submit">Send</button>
        <p class="contact__status" data-status hidden></p>
      </div>
    </form>
  </div>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    status.hidden = false;
    status.textContent = 'Sending…';
    btn.disabled = true;
    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });
      if (!res.ok) throw new Error(String(res.status));
      status.textContent = 'Thanks for submitting!';
      form.reset();
    } catch {
      status.textContent = 'Something went wrong. Please email hello@adc.dev instead.';
    } finally {
      btn.disabled = false;
    }
  });
</script>

<style>
  .contact-band {
    min-height: 301px;
    padding: 55px 0 60px;
  }
  .contact-band p {
    max-width: 798px;
    margin: 13px auto 0;
  }
  .contact {
    background: var(--lilac);
    padding: 0 16px 54px;
  }
  .contact__form {
    position: relative;
    max-width: 1060px;
    min-height: 615px;
    margin: -42px auto 0;
    background: #fff;
    padding: 71px 88px 60px 89px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 83px;
    row-gap: 27px;
    align-content: start;
  }
  .field {
    display: flex;
    flex-direction: column;
  }
  .field--wide {
    grid-column: 1 / -1;
  }
  .field label {
    font-family: var(--f-text);
    font-size: 18px;
    line-height: 1;
    padding-left: 2px;
    margin-bottom: 9px;
  }
  .field input,
  .field textarea {
    font: 14px var(--f-body);
    border: 0;
    border-bottom: 1px solid #000;
    border-radius: 0;
    padding: 6px 2px;
    height: 37px;
    background: transparent;
  }
  .field textarea {
    height: 123px;
    resize: vertical;
  }
  .field input:focus,
  .field textarea:focus {
    outline: none;
    border-bottom: 2px solid var(--blue);
  }
  .contact__submit {
    text-align: center;
    margin-top: 25px;
  }
  .contact__submit button {
    width: 280px;
    height: 36px;
    background: var(--blue);
    color: #fff;
    border: 0;
    font: 18px var(--f-text);
    cursor: pointer;
  }
  .contact__submit button:hover {
    background: var(--navy);
  }
  .contact__status {
    margin-top: 16px;
    color: var(--navy);
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .contact-band p {
      font-size: 16px;
    }
    .contact__form {
      grid-template-columns: 1fr;
      padding: 40px 20px;
      min-height: 0;
    }
    .contact__submit button {
      width: 100%;
    }
  }
</style>
